    ">
        ✨ Top IA
    </span>
{% endif %}

{% if activite.isFlashSale and activite.flashPrice and activite.flashExpiresAt %}
    <span style="
        position: absolute;
        top: {% if recommendedIds is defined and activite.id in recommendedIds %}58px{% else %}14px{% endif %};
        right: 14px;
        z-index: 6;
