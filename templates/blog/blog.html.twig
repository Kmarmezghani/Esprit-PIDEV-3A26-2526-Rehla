                background: '#fff7ed',
                color: '#9a3412',
                iconColor: '#f59e0b',
                customClass: {
                    popup: 'orange-toast'
                }
            });
      return;
    }

    // ✅ redirection correcte
    window.location.href = `/blog?sort=${selectedSort}&order=${selectedOrder}`;
  });
});
