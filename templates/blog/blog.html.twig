  Publier
</button>
  </div>


  <!-- boutons -->
  <div class="d-flex mt-3">

    <button type="button"
            class="btn btn-outline-primary rounded-pill mr-2"
            onclick="document.getElementById('post_image').click()">
      📷 Image
    </button>
        <button class="btn btn-outline-primary rounded-pill mr-2">🎥 Vidéo</button>
      <button type="button"
            id="btnLocaliser"
