  transform: scale(1.05);
}

/* ICONES */
.comment-icons i {
  color: #2563eb;
}

.comment-icons .fa-trash {
  color: #ef4444;
}
/*-------------------------------------------pop up edit---------------------------------------------*/

/* LABEL */
.popup-label {
  font-weight: 600;
  color: #334155;
  margin-bottom: 6px;
  display: block;
}

/* TEXTAREA STYLE IMAGE */
.edit-textarea {
  width: 100%;
  border-radius: 25px;
  border: none;
  background: #f1f5f9;
  padding: 14px 18px;
  font-size: 14px;
  outline: none;
  resize: none;
}

/* IMAGE + BUTTON */
.edit-image-box {
  display: flex;
  align-items: center;
  gap: 15px;
}

.edit-image-box img {
  width: 120px;
  height: 80px;
  object-fit: cover;
  border-radius: 10px;
}

/* BOUTON CHOISIR */
.choose-btn {
  background: linear-gradient(135deg, #3b82f6, #2563eb);
  border: none;
  color: white;
  padding: 10px 18px;
  border-radius: 20px;
  font-weight: 500;
  cursor: pointer;
}

/* FOOTER ALIGN RIGHT */
.edit-footer {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
}

/* ANNULER */
.btn-cancel {
  background: #e5e7eb;
  border: none;
  padding: 8px 16px;
  border-radius: 10px;
}

/* ENREGISTRER */
.btn-save {
  background: linear-gradient(135deg, #2563eb, #1d4ed8);
  color: white;
  border: none;
  padding: 8px 18px;
  border-radius: 20px;
  font-weight: 600;
}
#editPostPopup textarea {
  border-radius: 12px;
  border: 1px solid #cbd5f5;
  padding: 10px;
  resize: none;
}

#editPostPopup input[type="file"] {
  border-radius: 12px;
  padding: 8px;
}

/*---------------------------alerte----------------------*/

.red-toast {
    border-left: 5px solid #ef4444 !important;
    font-size: 13px !important;
    padding: 10px 14px !important;
    border-radius: 10px !important;
    box-shadow: 0 8px 25px rgba(239, 68, 68, 0.25) !important;
}
.orange-toast {
    border-left: 5px solid #f59e0b !important;
    font-size: 13px !important;
    padding: 10px 14px !important;
    border-radius: 10px !important;
    box-shadow: 0 8px 25px rgba(245, 158, 11, 0.25) !important;
}
.green-toast {
    border-left: 5px solid #10b981 !important;
    font-size: 13px !important;
    padding: 10px 14px !important;
    border-radius: 10px !important;
    box-shadow: 0 8px 25px rgba(16, 185, 129, 0.25) !important;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
const hearts = document.querySelectorAll('.fa-heart');
hearts.forEach(heart => {
heart.addEventListener('click', function() {
this.classList.toggle('text-danger');
const count = this.nextElementSibling;
const current = parseInt(count.textContent);
count.textContent = this.classList.contains('text-danger') ? current + 1 : current - 1;
});
});
});
document.querySelectorAll('.fa-bookmark').forEach(icon => {
  icon.addEventListener('click', function() {
    this.classList.toggle('text-warning');
  });
});

/*-----------popup comments----------------------------*/
document.addEventListener("DOMContentLoaded", function () {

  const openBtns = document.querySelectorAll(".open-comment");
  const popup = document.getElementById("commentPopup");
  const overlay = document.getElementById("commentOverlay");
  const closeBtn = document.getElementById("closePopup");

  openBtns.forEach(btn => {
    btn.addEventListener("click", () => {
      popup.classList.add("active");
      overlay.classList.add("active");
    });
  });

  function closePopup() {
    popup.classList.remove("active");
    overlay.classList.remove("active");
  }

  closeBtn.addEventListener("click", closePopup);
  overlay.addEventListener("click", closePopup);

});

{# --------------------------pop up edit------------------------------- #}
document.addEventListener("DOMContentLoaded", function () {

  const editBtns = document.querySelectorAll(".open-edit");
  const editPopup = document.getElementById("editPostPopup");
  const overlay = document.getElementById("commentOverlay"); // 🔥 AJOUT
  const closeEdit = document.getElementById("closeEditPopup");

  editBtns.forEach(btn => {
    btn.addEventListener("click", () => {
      editPopup.classList.add("active");
      overlay.classList.add("active");
    });
  });

  function closeEditPopup() {
    editPopup.classList.remove("active");
    overlay.classList.remove("active");
  }

  closeEdit.addEventListener("click", closeEditPopup);
  overlay.addEventListener("click", closeEditPopup);

});


{# ------------pop up alerte---------- #}

document.addEventListener("DOMContentLoaded", function () {

    if (typeof Swal === "undefined") {
        console.error("SweetAlert2 non chargé !");
        return;
    }

    const form = document.querySelector("form");
    const contenu = document.getElementById("post_contenu");

    if (!form || !contenu) return;

    form.addEventListener("submit", function (e) {

        const value = (contenu.value || "").trim();

       if (value === "") {
    e.preventDefault();

    Swal.fire({
        icon: 'error',
        text: 'Le contenu est obligatoire',
        toast: true,
        position: 'top-end',
        showConfirmButton: false,
        timer: 2500,
        background: '#fff1f2',   // rouge très léger
        color: '#991b1b',        // texte rouge foncé
        iconColor: '#ef4444',    // icône rouge vif
        customClass: {
            popup: 'red-toast'
        }
    });

    return;
}

       if (value.length < 3) {
    e.preventDefault();

    Swal.fire({
        icon: 'warning',
        text: 'Minimum 3 caractères',
        toast: true,
        position: 'top-end',
        showConfirmButton: false,
        timer: 2500,
        background: '#fff7ed',
        color: '#9a3412',
        iconColor: '#f59e0b',
        customClass: {
            popup: 'orange-toast'
        }
    });

    return;
}

Swal.fire({
    icon: 'success',
    text: 'Publication ajoutée avec succès',
    toast: true,
    position: 'top-end',
    showConfirmButton: false,
    timer: 2500,
    background: '#ecfdf5',
    color: '#065f46',
    iconColor: '#10b981',
    customClass: {
        popup: 'green-toast'
    }
});
    });

});
</script>

{% endblock %}
