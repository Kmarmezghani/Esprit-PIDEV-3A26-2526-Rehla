                </h3>

                <p class="location">
                    <span class="fa fa-map-marker"></span>
                    {{ activite.destination ? activite.destination.nom : 'Non défini' }}
                </p>
                <div class="flash-row-holder">
    {% if activite.isFlashSale and activite.flashPrice and activite.flashExpiresAt %}
        <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap; margin-bottom:10px;">
            <span style="
                display:inline-flex;
                align-items:center;
