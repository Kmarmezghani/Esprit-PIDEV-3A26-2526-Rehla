<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Réinitialiser le mot de passe – Rehla</title>
    <link rel="icon" type="image/png" href="{{ asset('assetsback/img/logoblue.png') }}">
    <link href="https://fonts.googleapis.com/css?family=Poppins:300,400,500,600,700,800,900" rel="stylesheet">
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" href="{{ asset('assets/css/bootstrap.min.css') }}">
    <style>
        * { font-family: 'Poppins', sans-serif; }
        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #0f1c3f 0%, #223f91 60%, #1a5276 100%);
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .card-box {
            background: #fff;
            border-radius: 18px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.35);
            width: 100%;
            max-width: 430px;
            padding: 45px 40px 35px;
        }
        .login-logo { display: block; margin: 0 auto 8px; height: 60px; }
        .login-brand { text-align:center; font-size:13px; color:#223f91; font-weight:600; letter-spacing:1px; text-transform:uppercase; margin-bottom:28px; }
        .form-label { font-size:13px; font-weight:600; color:#444; }
        .form-control { border-radius:8px; border:1.5px solid #dee2e6; font-size:14px; padding:10px 14px; transition:border-color .2s; }
        .form-control:focus { border-color:#223f91; box-shadow:0 0 0 3px rgba(34,63,145,.12); }
        .btn-main { background-color:#223f91; color:#fff; border:none; border-radius:8px; padding:12px; font-size:15px; font-weight:600; width:100%; transition:background .2s; }
        .btn-main:hover { background-color:#1a2f6e; }
        .link-back { color:#223f91; font-weight:600; text-decoration:none; font-size:13px; }
        .link-back:hover { text-decoration:underline; }
        .alert-error { background:#fff5f5; border:1px solid #f5c2c7; border-radius:8px; color:#842029; font-size:13px; padding:10px 14px; margin-bottom:14px; }
        .alert-invalid { background:#fff3cd; border:1px solid #ffc107; border-radius:10px; color:#856404; padding:18px; text-align:center; }
        .input-icon { position:relative; }
        .input-icon .fa { position:absolute; right:14px; top:50%; transform:translateY(-50%); color:#aaa; font-size:15px; cursor:pointer; }
    </style>
</head>
<body>
    <div class="card-box">
        <img src="{{ asset('assets/images/bluelogo.png') }}" alt="Rehla" class="login-logo">
        <p class="login-brand">Explore the World</p>

        {% if invalid %}
            <div class="text-center mb-3">
                <i class="fa fa-times-circle" style="font-size:40px; color:#dc3545;"></i>
            </div>
            <div class="alert-invalid">
                <strong>Lien invalide ou expiré.</strong><br>
                Ce lien de réinitialisation n'est plus valide. Veuillez faire une nouvelle demande.
            </div>
            <p class="text-center mt-4 mb-0">
                <a href="{{ path('app_forgot_password') }}" class="link-back">
                    <i class="fa fa-refresh me-1"></i> Nouvelle demande
                </a>
            </p>
        {% else %}
            <h4 style="font-size:22px; font-weight:700; color:#1a1a2e; margin-bottom:6px;">Nouveau mot de passe</h4>
            <p style="font-size:13px; color:#6c757d; margin-bottom:24px;">
                Choisissez un nouveau mot de passe sécurisé.
            </p>

            {% for err in errors|default([]) %}
                <div class="alert-error"><i class="fa fa-exclamation-circle me-1"></i> {{ err }}</div>
            {% endfor %}

            <form method="post" action="{{ path('app_reset_password', {token: token}) }}" id="resetForm">
                <div class="mb-3">
                    <label class="form-label">Nouveau mot de passe</label>
                    <div class="input-icon">
                        <input type="password" name="nouveau_mdp" id="pwd1" class="form-control" placeholder="••••••••" required>
                        <i class="fa fa-eye" onclick="togglePwd('pwd1', this)"></i>
                    </div>
                </div>
                <div class="mb-4">
                    <label class="form-label">Confirmer le mot de passe</label>
                    <div class="input-icon">
                        <input type="password" name="confirmer_mdp" id="pwd2" class="form-control" placeholder="••••••••" required>
                        <i class="fa fa-eye" onclick="togglePwd('pwd2', this)"></i>
                    </div>
                    <div id="match-msg" style="font-size:12px; margin-top:4px; display:none;"></div>
                </div>
                <button type="submit" class="btn-main">
                    <i class="fa fa-lock me-2"></i> Réinitialiser le mot de passe
                </button>
            </form>

            <p class="text-center mt-4 mb-0">
                <a href="{{ path('app_login') }}" class="link-back">
                    <i class="fa fa-arrow-left me-1"></i> Retour à la connexion
                </a>
            </p>
        {% endif %}
    </div>

    <script>
        function togglePwd(id, icon) {
            const f = document.getElementById(id);
            f.type = f.type === 'password' ? 'text' : 'password';
            icon.classList.toggle('fa-eye');
            icon.classList.toggle('fa-eye-slash');
        }

        document.getElementById('pwd2')?.addEventListener('input', function() {
            const p1 = document.getElementById('pwd1').value;
            const msg = document.getElementById('match-msg');
            if (!this.value) { msg.style.display='none'; return; }
            if (this.value === p1) {
                msg.style.display='block'; msg.style.color='#28a745';
                msg.innerHTML='<i class="fa fa-check"></i> Les mots de passe correspondent.';
            } else {
                msg.style.display='block'; msg.style.color='#dc3545';
                msg.innerHTML='<i class="fa fa-times"></i> Les mots de passe ne correspondent pas.';
            }
        });
    </script>
</body>
</html>
