<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.shape.SVGPath?>
<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="Controllers.ClientPostsController" fx:id="root"  stylesheets="@/Frontoffice/css/profile-menu.css,@/Frontoffice/css/home.css">

    <BorderPane fx:id="mainContent" styleClass="root">

        <!-- ********************************-->
    <!-- HERO / TOP -->
        <top>
            <HBox alignment="CENTER_LEFT" prefHeight="70.0"
                  style="-fx-background-color: #223f91;" BorderPane.alignment="CENTER">
                <children>

                    <!-- Logo -->
                    <ImageView fitHeight="60.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true">
                        <image>
                            <Image url="@../Backoffice/icons/IMG_20260125_122708_191-removebg-preview.png" />
                        </image>
                    </ImageView>

                    <Region HBox.hgrow="ALWAYS" />

                    <!-- Center nav -->
                    <HBox alignment="CENTER" spacing="22.0">
                        <Button onAction="#goToHome"
                                style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 16; -fx-cursor: hand;"
                                text="Home" />
                        <Button onAction="#goToDestinations"
                                style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 16; -fx-cursor: hand;"
                                text="Destinations" />
                        <Button onAction="#goToPosts"
                                style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 16; -fx-cursor: hand;"
                                text="Posts" />
                        <Button onAction="#goToactivities"
                                style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 16; -fx-cursor: hand;"
                                text="Activities" />
                        <Button
                                style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 16; -fx-cursor: hand;"
                                text="About" />
                    </HBox>

                    <Region HBox.hgrow="ALWAYS" />
                    <StackPane>
                        <HBox.margin>
                            <Insets right="15.0"/>
                        </HBox.margin>
                        <Button fx:id="btnMessage" text="💬" styleClass="iconBtn"/>

                        <Label fx:id="lblMessageBadge"
                               visible="false"
                               style="-fx-background-color: red;
                  -fx-text-fill: white;
                  -fx-font-size: 10;
                  -fx-padding: 1 5 1 5;
                  -fx-background-radius: 10;"
                               StackPane.alignment="TOP_RIGHT"/>
                    </StackPane>

                    <!-- PROFILE -->
                    <Button fx:id="btnProfile" onAction="#openProfileMenu"
                            styleClass="iconBtn" text="👤">
                        <HBox.margin><Insets right="20.0"/></HBox.margin>

                        <contextMenu>
                            <ContextMenu fx:id="profileMenu" styleClass="profileMenu">
                                <items>

                                    <MenuItem onAction="#goToMyProfile" text="My Profile">
                                        <graphic>
                                            <SVGPath content="M12 12c2.7 0 5-2.3 5-5s-2.3-5-5-5-5 2.3-5 5 2.3 5 5 5zm0 2c-4 0-8 2-8 5v1h16v-1c0-3-4-5-8-5z"
                                                     style="-fx-fill: #374151; -fx-scale-x: 0.8; -fx-scale-y: 0.8;"/>
                                        </graphic>
                                    </MenuItem>

                                    <MenuItem onAction="#goToMyPosts" text="My Posts">
                                        <graphic>
                                            <SVGPath styleClass="menuIcon"
                                                     content="M9 6l1.5-2h3L15 6h3a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h3zm3 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zm0-2.2a1.8 1.8 0 1 1 0-3.6 1.8 1.8 0 0 1 0 3.6z"/>
                                        </graphic>
                                    </MenuItem>

                                    <MenuItem onAction="#goToMyReservations" text="My Reservations">
                                        <graphic>
                                            <SVGPath styleClass="menuIcon"
                                                     content="M7 2v2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-2V2h-2v2H9V2H7zm12 6H5V6h14v2zM7 12h3v3H7v-3zm4 0h3v3h-3v-3zm4 0h3v3h-3v-3z"/>
                                        </graphic>
                                    </MenuItem>

                                    <MenuItem onAction="#goToMyActivities" text="My Activities">
                                        <graphic>
                                            <SVGPath styleClass="menuIcon"
                                                     content="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm0 2a8 8 0 1 1 0 16 8 8 0 0 1 0-16zm3.2 4.8l-1.9 5-5 1.9 1.9-5 5-1.9z"/>
                                        </graphic>
                                    </MenuItem>

                                    <SeparatorMenuItem/>

                                    <MenuItem onAction="#handleLogout" text="Logout">
                                        <graphic>
                                            <SVGPath content="M10 3v2h6v14h-6v2h8V3z M4 12l4-4v3h8v2H8v3z"
                                                     style="-fx-fill: #dc2626; -fx-scale-x: 0.8; -fx-scale-y: 0.8;"/>
                                        </graphic>
                                    </MenuItem>

                                </items>
                            </ContextMenu>
                        </contextMenu>
                    </Button>

                    <!-- window buttons -->
                    <Button onAction="#minwindow"
                            style="-fx-text-fill: white; -fx-font-size: 20;"
                            styleClass="button4"
                            stylesheets="@../Backoffice/css/styling.css"
                            text="−" />
                    <Button onAction="#maxwindow"
                            style="-fx-text-fill: white; -fx-font-size: 20;"
                            styleClass="button4"
                            stylesheets="@../Backoffice/css/styling.css"
                            text="□" />
                    <Button onAction="#closewindow"
                            style="-fx-text-fill: white; -fx-font-size: 16;"
                            styleClass="button3"
                            stylesheets="@../Backoffice/css/styling.css"
                            text="✕">
                        <HBox.margin><Insets top="4.0"/></HBox.margin>
                    </Button>

                </children>

                <padding>
                    <Insets left="30.0" right="30.0" />
                </padding>
            </HBox>
        </top>


    <right>

            <VBox spacing="14"
                  styleClass="right"
                  prefWidth="320"
                  minWidth="320"
                  maxWidth="320">

                <VBox styleClass="glass" spacing="12" prefWidth="280">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="📌" styleClass="card-emoji"/>
                        <Label text="Insights" styleClass="card-title"/>
                    </HBox>
                    <HBox spacing="12" alignment="CENTER">
                        <VBox styleClass="mini-stat" spacing="4" alignment="CENTER">
                            <Label text="1.2k" styleClass="mini-stat-val"/>
                            <Label text="Vues" styleClass="mini-stat-lbl"/>
                        </VBox>
                        <VBox styleClass="mini-stat" spacing="4" alignment="CENTER">
                            <Label text="86" styleClass="mini-stat-val"/>
                            <Label text="Likes" styleClass="mini-stat-lbl"/>
                        </VBox>
                        <VBox styleClass="mini-stat" spacing="4" alignment="CENTER">
                            <Label text="14" styleClass="mini-stat-val"/>
                            <Label text="Posts" styleClass="mini-stat-lbl"/>
                        </VBox>
                    </HBox>
                </VBox>

                <VBox styleClass="glass" spacing="10" prefWidth="280">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="🔥" styleClass="card-emoji"/>
                        <Label text="Tendances" styleClass="card-title"/>
                    </HBox>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="#Voyage" styleClass="tag"/>
                        <Label text="#Cuisine" styleClass="tag"/>
                        <Label text="#Tech" styleClass="tag"/>
                    </HBox>
                </VBox>
            <VBox styleClass="glass" spacing="10">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="🚀" styleClass="card-emoji"/>
                    <Label text="À suivre" styleClass="card-title"/>
                </HBox>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <ImageView fitWidth="32" fitHeight="32" preserveRatio="true" styleClass="avatar"/>
                    <VBox spacing="0">
                        <Label text="Tech Daily" styleClass="who"/>
                        <Label text="Recommandé" styleClass="muted"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="+ Suivre" styleClass="btn-soft"/>
                </HBox>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <ImageView fitWidth="32" fitHeight="32" preserveRatio="true" styleClass="avatar"/>
                    <VBox spacing="0">
                        <Label text="Cuisine Pro" styleClass="who"/>
                        <Label text="Populaire" styleClass="muted"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="+ Suivre" styleClass="btn-soft"/>
                </HBox>
            </VBox>

            <VBox styleClass="glass" spacing="8">
                <Label text="🎧 Playlist du moment" styleClass="card-title"/>
                <Label text="Lo-fi Focus • 2h 14m" styleClass="muted"/>
                <ProgressBar progress="0.35" styleClass="bar"/>
            </VBox>
        </VBox>
    </right>

    <!-- CENTER FEED -->
    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    styleClass="scroll">


        <content>
            <StackPane alignment="TOP_CENTER">
            <VBox spacing="14"
                  styleClass="feed"
                  maxWidth="720"
                  alignment="TOP_CENTER">

                    <!-- COMPOSER (creative) -->
                    <VBox styleClass="glass composer" spacing="10">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <ImageView fx:id="imgMe2" fitWidth="40" fitHeight="40" preserveRatio="true" styleClass="avatar"/>
                            <TextField fx:id="txtNewPost"
                                       promptText="Écrivez quelque chose de fort..."
                                       styleClass="composer-input"
                                       HBox.hgrow="ALWAYS"/>
                            <Button text="Publier"
                                    styleClass="btn-primary"
                                    onAction="#handleAddPost"/>
                        </HBox>

                        <HBox spacing="10">
                            <Button text="🖼 Image" styleClass="btn-soft" onAction="#handleChooseImage" />
                            <Button text="🎥 Vidéo" styleClass="btn-soft"/>
                            <Button text="📍 Lieu"
                                    styleClass="btn-soft"
                                    onAction="#handleLocalisation"/>

                            <Button text="🧠 Sondage" styleClass="btn-soft" style=" "/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="Astuce: utilisez #tags" styleClass="hint"/>
                        </HBox>
                    </VBox>

                    <!-- container dynamique -->
                    <VBox fx:id="postsContainer" spacing="14"/>




                </VBox>
            </StackPane>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
</StackPane>