{% extends 'adminbase.html.twig' %}

{% block title %}Ajouter une Ville{% endblock %}

{% block sidebar %}
  {% include 'admin/partials/sidebar.html.twig' %}
{% endblock %}

{% block navbar %}
  {% include 'admin/partials/navbar.html.twig' %}
{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="card">
        <div class="card-header text-center">
            <h4>Ajouter une nouvelle ville</h4>
        </div>
        <div class="card-body">
            {{ form_start(form) }}

            <div class="mb-3">
                {{ form_label(form.pays_id) }}
                {{ form_widget(form.pays_id, {'attr': {'class': 'form-control ville-pays-select'}}) }}
                <small class="form-text text-muted">Sélectionnez un pays pour voir les villes disponibles</small>
                {% for error in form.pays_id.vars.errors %}
                    <div class="alert alert-warning mt-1">{{ error.message }}</div>
                {% endfor %}
            </div>

            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-end mb-1">
                    {{ form_label(form.nom) }}
                    <button type="button" id="btn-generate-image" class="btn btn-sm" style="background-color: #f0fdf4; color: #166534; border: 1px solid #166534; border-radius: 20px;">
                        🖼️ Générer Image
                    </button>
                </div>
                <div class="input-group">
                    <input type="text" id="{{ form.nom.vars.id }}" name="{{ form.nom.vars.full_name }}" class="form-control ville-nom-input" list="ville-list" placeholder="Sélectionnez d'abord un pays" required="required" value="{{ form.nom.vars.value|default('') }}">
                    <datalist id="ville-list"></datalist>
                </div>
                {% do form.nom.setRendered() %}
                <small class="form-text text-muted">Tapez le nom ou choisissez dans la liste après avoir sélectionné un pays</small>
                {% for error in form.nom.vars.errors %}
                    <div class="alert alert-warning mt-1">{{ error.message }}</div>
                {% endfor %}
            </div>

            <div id="image-preview-container" class="mb-3 text-center" style="display: none;">
                <label class="d-block mb-1">Aperçu de l'image</label>
                <img id="image-preview" src="" class="img-thumbnail" style="max-height: 200px;">
            </div>

            {{ form_widget(form.image, {'attr': {'id': 'hidden-image-input'}}) }}

            <div class="mb-2 d-flex justify-content-between align-items-center">
                <h6 class="mb-0">Profil Touristique</h6>
                <button type="button" id="btn-suggest-profile" class="btn btn-sm" style="background-color: #fdf4f0; color: #b45309; border: 1px solid #b45309; border-radius: 20px;">
                    🪄 Suggérer Profil via IA
                </button>
            </div>
            <div id="ai-profile-hint" class="alert alert-info py-2" style="display: none; font-size: 0.9rem;">
                <!-- Hint will be injected here -->
            </div>
            <div class="row mb-3">
                <div class="col-md-6">
                    {{ form_label(form.typeTourisme) }}
                    {{ form_widget(form.typeTourisme, {'attr': {'class': 'form-control'}}) }}
                    {% for error in form.typeTourisme.vars.errors %}
                        <div class="alert alert-warning mt-1">{{ error.message }}</div>
                    {% endfor %}
                </div>
                <div class="col-md-6">
                    {{ form_label(form.saison) }}
                    {{ form_widget(form.saison, {'attr': {'class': 'form-control'}}) }}
                    {% for error in form.saison.vars.errors %}
                        <div class="alert alert-warning mt-1">{{ error.message }}</div>
                    {% endfor %}
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    {{ form_label(form.latitude) }}
                    {{ form_widget(form.latitude, {'attr': {'class': 'form-control'}}) }}
                    {% for error in form.latitude.vars.errors %}
                        <div class="alert alert-warning mt-1">{{ error.message }}</div>
                    {% endfor %}
                </div>
                <div class="col-md-6">
                    {{ form_label(form.longitude) }}
                    {{ form_widget(form.longitude, {'attr': {'class': 'form-control'}}) }}
                    {% for error in form.longitude.vars.errors %}
                        <div class="alert alert-warning mt-1">{{ error.message }}</div>
                    {% endfor %}
                </div>
            </div>

            <div class="mb-3">
                {{ form_label(form.visit_count) }}
                {{ form_widget(form.visit_count, {'attr': {'class': 'form-control'}}) }}
                {% for error in form.visit_count.vars.errors %}
                    <div class="alert alert-warning mt-1">{{ error.message }}</div>
                {% endfor %}
            </div>

            <div class="text-center">
                <a href="{{ path('admin_destination_index', {tab: 'ville'}) }}" class="btn btn-outline-secondary me-2"
                   style="border-radius: 25px; padding: 10px 30px;">
                    Retour
                </a>
                <button type="submit" class="btn"
                        style="background-color: #223f91; color: #fff; border-radius: 25px; padding: 10px 30px;">
                    Créer
                </button>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}

{% block page_scripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const cityInput = document.querySelector('.ville-nom-input');
    const cityDatalist = document.querySelector('#ville-list');
    const paysSelect = document.querySelector('.ville-pays-select') || document.querySelector('#ville_pays_id');
    const latInput = document.querySelector('#ville_latitude') || document.querySelector('[id$="_latitude"]');
    const lonInput = document.querySelector('#ville_longitude') || document.querySelector('[id$="_longitude"]');
    const btnGenerateImage = document.getElementById('btn-generate-image');
    const imagePreview = document.getElementById('image-preview');
    const imageContainer = document.getElementById('image-preview-container');
    const hiddenImageInput = document.getElementById('hidden-image-input');

    // --- 3. GÉNÉRATION D'IMAGE ---
    if (btnGenerateImage) {
        btnGenerateImage.addEventListener('click', function() {
            let cityName = '';
            if (cityInput) {
                cityName = (cityInput.value || '').trim();
            }
            if (!cityName) {
                alert('Veuillez d\'abord taper un nom de ville dans le champ "Nom".');
                return;
            }

            const originalText = btnGenerateImage.innerHTML;
            btnGenerateImage.innerHTML = '⏳ Génération...';
            btnGenerateImage.disabled = true;

            fetch('/admin/destination/api/generate-image', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                body: JSON.stringify({ type: 'ville', name: cityName })
            })
            .then(response => response.json())
            .then(data => {
                if (data.error) {
                    alert('Erreur: ' + data.error);
                } else if (data.url) {
                    // Show preview
                    const preview = document.getElementById('image-preview');
                    const container = document.getElementById('image-preview-container');
                    if (preview) preview.src = data.url;
                    if (container) container.style.display = 'block';

                    // Store filename in hidden field - try multiple selectors
                    const hiddenField = document.getElementById('hidden-image-input')
                        || document.getElementById('ville_image')
                        || document.querySelector('input[type="hidden"][name*="image"]');
                    if (hiddenField) hiddenField.value = data.filename;
                }
            })
            .catch(error => {
                console.error('Erreur génération image:', error);
                alert('Une erreur est survenue. Vérifiez la console.');
            })
            .finally(() => {
                btnGenerateImage.innerHTML = originalText;
                btnGenerateImage.disabled = false;
            });
        });
    }

    if (!cityInput || !paysSelect) return;

    // --- 1. CHARGEMENT DES VILLES ---
    function loadCitiesForCountry() {
        if (!cityDatalist) return;
        const selectedOption = paysSelect.options[paysSelect.selectedIndex];
        const country = selectedOption && selectedOption.value ? selectedOption.text.trim() : '';
        
        cityDatalist.innerHTML = '';
        
        if (!country || country.toLowerCase().includes('sélectionnez')) {
            cityInput.placeholder = "Sélectionnez d'abord un pays";
            return;
        }
        
        cityInput.placeholder = "Chargement des villes pour " + country + "...";

        fetch('https://countriesnow.space/api/v0.1/countries/cities', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ country: country })
        })
            .then(response => response.json())
            .then(data => {
                cityDatalist.innerHTML = '';
                if (!data.error && data.data && data.data.length > 0) {
                    data.data.forEach(cityName => {
                        const option = document.createElement('option');
                        option.value = cityName;
                        cityDatalist.appendChild(option);
                    });
                    cityInput.placeholder = "Tapez ou sélectionnez une ville";
                } else {
                    cityInput.placeholder = "Ville non trouvée, tapez-la manuellement";
                }
            })
            .catch(error => {
                console.error('Error:', error);
                cityInput.placeholder = "Erreur API, tapez manuellement";
            });
    }

    paysSelect.addEventListener('change', loadCitiesForCountry);
    if (paysSelect.value) { loadCitiesForCountry(); }

    // --- 2. COORDONNÉES AUTOMATIQUES ---
    if (latInput && lonInput) {
      const btnCoords = document.createElement('button');
      btnCoords.type = 'button';
      btnCoords.className = 'btn btn-sm btn-outline-primary mb-3 mt-2';
      btnCoords.innerHTML = '📍 Obtenir les coordonnées automatiquement';
      
      const row = latInput.closest('.row');
      if (row) { row.parentNode.insertBefore(btnCoords, row); }
      
      btnCoords.addEventListener('click', function() {
        let cityName = cityInput.value;
        if (!cityName || cityName.includes('Sélectionnez') || cityName.includes('Chargement')) {
          alert('Veuillez d\'abord entrer un nom de ville.');
          return;
        }
        
        btnCoords.innerHTML = '⏳ Recherche...';
        btnCoords.disabled = true;
        
        fetch('https://nominatim.openstreetmap.org/search?format=json&limit=1&q=' + encodeURIComponent(cityName))
          .then(res => res.json())
          .then(data => {
            if (data && data.length > 0) {
              latInput.value = parseFloat(data[0].lat).toFixed(6);
              lonInput.value = parseFloat(data[0].lon).toFixed(6);
              btnCoords.innerHTML = '✅ Coordonnées trouvées !';
              btnCoords.className = 'btn btn-sm btn-success text-white mb-3 mt-2';
            } else {
              alert('Coordonnées introuvables pour : ' + cityName);
              btnCoords.innerHTML = '📍 Obtenir les coordonnées automatiquement';
            }
          })
          .catch(err => {
            alert('Erreur lors de la récupération des coordonnées.');
            btnCoords.innerHTML = '📍 Obtenir les coordonnées automatiquement';
          })
          .finally(() => {
            btnCoords.disabled = false;
            setTimeout(() => {
              btnCoords.innerHTML = '📍 Obtenir les coordonnées automatiquement';
              btnCoords.className = 'btn btn-sm btn-outline-primary mb-3 mt-2';
            }, 3000);
          });
      });
    }
    // --- 3. IA PROFIL TOURISTIQUE ---
    const btnSuggestProfile = document.getElementById('btn-suggest-profile');
    const hintDiv = document.getElementById('ai-profile-hint');
    if (btnSuggestProfile && hintDiv) {
        btnSuggestProfile.addEventListener('click', function() {
            let cityName = cityInput.value;
            if (!cityName || cityName.includes('Sélectionnez') || cityName.includes('Chargement')) {
                alert('Veuillez d\'abord entrer un nom de ville.');
                return;
            }

            btnSuggestProfile.innerHTML = '⏳ Recherche...';
            btnSuggestProfile.disabled = true;
            hintDiv.style.display = 'none';

            fetch('{{ path("admin_api_ai_suggest_ville") }}', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ ville: cityName })
            })
            .then(res => res.json())
            .then(data => {
                if (data.error) {
                    alert(data.error);
                } else {
                    hintDiv.innerHTML = '<strong>L\'IA conseille :</strong> Type : <em>' + data.typeTourisme + '</em> | Saison : <em>' + data.saison + '</em>';
                    hintDiv.style.display = 'block';
                }
            })
            .catch(err => {
                alert('Erreur lors de la suggestion.');
            })
            .finally(() => {
                btnSuggestProfile.innerHTML = '🪄 Suggérer Profil via IA';
                btnSuggestProfile.disabled = false;
            });
        });
    }
});
</script>
{% endblock %}
