<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700" prefWidth="1000"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controllers.BookingTypeController"
            style="-fx-background-color: linear-gradient(to bottom, #3A5BC7, #223f91);">

    <children>

        <VBox alignment="CENTER" spacing="40"
              AnchorPane.topAnchor="0"
              AnchorPane.bottomAnchor="0"
              AnchorPane.leftAnchor="0"
              AnchorPane.rightAnchor="0">

            <!-- TITLE -->
            <Label text="Choose What You Want To Book" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="34"/>
                </font>
            </Label>

            <!-- SUBTITLE -->
            <Label text="Select a category to continue" textFill="#E0E0E0">
                <font>
                    <Font size="16"/>
                </font>
            </Label>

            <!-- BUTTON CONTAINER -->
            <HBox alignment="CENTER" spacing="30">

                <!-- FLIGHTS -->
                <Button text="✈ Flights"
                        onAction="#goToFlights"
                        prefWidth="160" prefHeight="120"
                        style="-fx-background-color: white;
                               -fx-font-size: 16;
                               -fx-font-weight: bold;
                               -fx-background-radius: 15;
                               -fx-cursor: hand;" />

                <!-- HOTELS -->
                <Button text="🏨 Hotels"
                        onAction="#goToHotels"
                        prefWidth="160" prefHeight="120"
                        style="-fx-background-color: white;
                               -fx-font-size: 16;
                               -fx-font-weight: bold;
                               -fx-background-radius: 15;
                               -fx-cursor: hand;" />

                <!-- TRANSPORT -->
                <Button text="🚗 Transport"
                        onAction="#goToTransport"
                        prefWidth="160" prefHeight="120"
                        style="-fx-background-color: white;
                               -fx-font-size: 16;
                               -fx-font-weight: bold;
                               -fx-background-radius: 15;
                               -fx-cursor: hand;" />

                <!-- ACTIVITIES -->
                <Button text="🎒 Activities"
                        onAction="#goToActivities"
                        prefWidth="160" prefHeight="120"
                        style="-fx-background-color: white;
                               -fx-font-size: 16;
                               -fx-font-weight: bold;
                               -fx-background-radius: 15;
                               -fx-cursor: hand;" />

            </HBox>

        </VBox>

    </children>

</AnchorPane>