{% extends 'adminbase.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block sidebar %}
  {% include 'admin/partials/sidebar.html.twig' %}
{% endblock %}

{% block navbar %}
  {% include 'admin/partials/navbar.html.twig' %}
{% endblock %}

{% block body %}
<div class="row g-6">
  <div class="col-12">
    <div class="nav-align-top">
      <ul class="nav nav-pills mb-4 nav-fill" role="tablist">
        <li class="nav-item mb-1 mb-sm-0">
          <button type="button"
                  class="nav-link {{ selectedTab != 'avis' ? 'active' : '' }}"
                  role="tab"
                  data-bs-toggle="tab"
                  data-bs-target="#navs-pills-activite"
                  aria-controls="navs-pills-activite"
                  aria-selected="{{ selectedTab != 'avis' ? 'true' : 'false' }}">
            <span class="d-none d-sm-inline-flex align-items-center">
              <i class="icon-base bx bx-compass icon-sm me-1_5"></i>Activite
            </span>
            <i class="icon-base bx bx-compass icon-sm d-sm-none"></i>
          </button>
        </li>

        <li class="nav-item mb-1 mb-sm-0">
          <button type="button"
                  class="nav-link {{ selectedTab == 'avis' ? 'active' : '' }}"
                  role="tab"
                  data-bs-toggle="tab"
                  data-bs-target="#navs-pills-avis"
                  aria-controls="navs-pills-avis"
                  aria-selected="{{ selectedTab == 'avis' ? 'true' : 'false' }}">
            <span class="d-none d-sm-inline-flex align-items-center">
              <i class="icon-base bx bx-message-square-dots icon-sm me-1_5"></i>Avis
            </span>
            <i class="icon-base bx bx-message-square-dots icon-sm d-sm-none"></i>
          </button>
        </li>
      </ul>

      <div class="tab-content">
        <!-- ACTIVITE TAB CONTENT -->
        <div class="tab-pane fade {{ selectedTab != 'avis' ? 'show active' : '' }}" id="navs-pills-activite" role="tabpanel">
          <div class="card">
            <div class="d-flex align-items-center mb-3">
              <h5 class="card-header mb-0">Liste des Activités</h5>
              <a href="{{ path('activite_new') }}"
                 class="btn rounded-pill"
                 style="background-color: #223f91; color: #fff; margin-left: auto; margin-right: 10px;">
                &#43; Ajouter
              </a>
            </div>
            <div class="px-4 pb-3 d-flex justify-content-end">
  <form method="get" action="{{ path('activite_admin') }}" class="d-flex gap-2 align-items-end">
    <input type="hidden" name="tab" value="activite">
    <input type="hidden" name="search" value="{{ search|default('') }}">

    <div>
      <label class="form-label mb-1">Trier par</label>
      <select name="sort" class="form-select">
        <option value="date_debut" {{ sort == 'date_debut' ? 'selected' : '' }}>Date début</option>
        <option value="nom" {{ sort == 'nom' ? 'selected' : '' }}>Nom</option>
        <option value="prix" {{ sort == 'prix' ? 'selected' : '' }}>Prix</option>
        <option value="noteMoyenne" {{ sort == 'noteMoyenne' ? 'selected' : '' }}>Note moyenne</option>
        <option value="status" {{ sort == 'status' ? 'selected' : '' }}>Statut</option>
      </select>
    </div>

    <div>
      <label class="form-label mb-1">Ordre</label>
      <select name="direction" class="form-select">
        <option value="asc" {{ direction == 'asc' ? 'selected' : '' }}>Croissant</option>
        <option value="desc" {{ direction == 'desc' ? 'selected' : '' }}>Décroissant</option>
      </select>
    </div>

    <div>
      <button type="submit" class="btn btn-primary">
        Appliquer
      </button>
    </div>
  </form>
</div>
            <div class="table-responsive text-nowrap">
              <table class="table table-striped table-hover">
                <thead>
                  <tr>
                    <th>Image</th>
                    <th>Nom</th>
                    <th>Description</th>
                    <th>Prix</th>
                    <th>Type</th>
                    <th>Note Moyenne</th>
                    <th>Guide</th>
                    <th>Date Début</th>
                    <th>Date Fin</th>
                    <th>Status</th>
                    <th>Destination</th>
                    <th>Max Places</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody id="activites-table-body">
  {% include 'admin/_activite_rows.html.twig' with {'activites': activites} %}
</tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- AVIS TAB CONTENT -->
        <div class="tab-pane fade {{ selectedTab == 'avis' ? 'show active' : '' }}" id="navs-pills-avis" role="tabpanel">
          <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
              <h5 class="mb-0">
                Avis
                {% if selectedActivite %}
                  - {{ selectedActivite.nom }}
                {% endif %}
              </h5>

              {% if selectedActivite %}
                <a href="{{ path('activite_admin') }}" class="btn btn-sm btn-outline-secondary">
                  Retour aux activités
                </a>
              {% endif %}
            </div>

            <div class="table-responsive text-nowrap">
              <table class="table table-striped table-hover">
                <thead>
                  <tr>
                    <th>Auteur</th>
                    <th>Activité</th>
                    <th>Note</th>
                    <th>Commentaire</th>
                    <th>Date</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  {% if selectedActivite %}
                    {% for avis in aviss %}
                      <tr>
                        <td>
                          {{ avis.personne ? avis.personne.nom : 'N/A' }}
                        </td>
                        <td>
                          {{ avis.activite ? avis.activite.nom : 'N/A' }}
                        </td>
                        <td>
                          <span class="badge bg-label-primary">{{ avis.note }}/5</span>
                        </td>
                        <td style="max-width: 280px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                          {{ avis.commentaire }}
                        </td>
                        <td>
                          {{ avis.dateAvis ? avis.dateAvis|date('d-m-Y H:i') : '' }}
                        </td>
                        <td>
                          <button class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#deleteAvisModal{{ avis.id }}">
                            Supprimer
                          </button>
                        </td>
                      </tr>
                    {% else %}
                      <tr>
                        <td colspan="6" class="text-center">Aucun avis pour cette activité</td>
                      </tr>
                    {% endfor %}
                  {% else %}
                    <tr>
                      <td colspan="6" class="text-center">Cliquez sur l'icône avis d'une activité pour voir ses avis.</td>
                    </tr>
                  {% endif %}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% for activite in activites %}
<div class="modal fade" id="deleteModal{{ activite.id }}" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title text-danger">
          <i class="bx bx-error-circle me-1"></i> Suppression de l'activité
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body text-center">
        <i class="bx bx-trash display-6 text-danger mb-3"></i>
        <h5>Voulez-vous vraiment supprimer cette activité ?</h5>
        <p class="text-muted mb-0">
          Cette action est <strong>irréversible</strong>.
        </p>
      </div>
      <div class="modal-footer justify-content-center">
        <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
        <form method="post" action="{{ path('activite_delete', {'id': activite.id}) }}">
          <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ activite.id) }}">
          <button class="btn btn-danger">
            <i class="bx bx-trash me-1"></i> Oui, supprimer
          </button>
        </form>
      </div>
    </div>
  </div>
</div>
{% endfor %}

{% for avis in aviss %}
<div class="modal fade" id="deleteAvisModal{{ avis.id }}" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title text-danger">
          <i class="bx bx-error-circle me-1"></i> Suppression de l'avis
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body text-center">
        <i class="bx bx-trash display-6 text-danger mb-3"></i>
        <h5>Voulez-vous vraiment supprimer cet avis ?</h5>
        <p class="text-muted mb-0">
          Cette action est <strong>irréversible</strong>.
        </p>
      </div>
      <div class="modal-footer justify-content-center">
        <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
        <form method="post" action="{{ path('avis_delete', {'id': avis.id}) }}">
          <input type="hidden" name="_token" value="{{ csrf_token('delete_avis' ~ avis.id) }}">
          <button class="btn btn-danger">
            <i class="bx bx-trash me-1"></i> Oui, supprimer
          </button>
        </form>
      </div>
    </div>
  </div>
</div>
{% endfor %}

<style>
  .btn-icon {
    width: 34px;
    height: 34px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
  }
</style>
{% endblock %}

{% block page_scripts %}
  <script src="{{ asset('assetsback/js/dashboards-analytics.js') }}"></script>
  <script src="{{ asset('assetsback/js/dashboards-analytics.js') }}"></script>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const searchInput = document.getElementById('admin-activity-search');
      const tableBody = document.getElementById('activites-table-body');

      if (!searchInput || !tableBody) return;

      let timeout = null;

      searchInput.addEventListener('input', function () {
        clearTimeout(timeout);

        timeout = setTimeout(() => {
          const search = searchInput.value;

          fetch(`{{ path('activite_admin_search') }}?search=${encodeURIComponent(search)}`)
            .then(response => response.text())
            .then(html => {
              tableBody.innerHTML = html;
            })
            .catch(error => {
              console.error('Erreur recherche dynamique:', error);
            });
        }, 300);
      });
    });
  </script>
{% endblock %}