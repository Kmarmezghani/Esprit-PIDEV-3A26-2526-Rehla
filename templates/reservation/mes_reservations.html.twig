<link href="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
document.addEventListener('DOMContentLoaded', function () {

    let calendarEl = document.getElementById('calendar');

    let fc = new FullCalendar.Calendar(calendarEl, {
        initialView: 'dayGridMonth',
        events: function(info, successCallback, failureCallback) {
    // No reservation selected yet — show empty calendar
    if (!window.selectedReservationId) {
        successCallback([]);
        return;
    }
    fetch('/reservation/' + window.selectedReservationId + '/tickets')
        .then(res => res.json())
        .then(data => successCallback(data))
        .catch(() => failureCallback());
},

        eventContent: function (arg) {
    let container = document.createElement('div');
    container.style.cssText = 'display:flex; align-items:center; justify-content:space-between; width:100%; padding:1px 4px;';

    let title = document.createElement('span');
    title.textContent = arg.event.title;
    title.style.cssText = 'font-size:12px; overflow:hidden; text-overflow:ellipsis;';

    let trash = document.createElement('i');
    trash.className = 'fa fa-trash';
    trash.style.cssText = 'cursor:pointer; color:#e55; margin-left:6px; font-size:11px; flex-shrink:0;';
    trash.title = 'Supprimer ce ticket';

    let ticketId = arg.event.extendedProps.ticketId;
            trash.onclick = function (e) {
        e.stopPropagation();
        Swal.fire({
            title: 'Supprimer ce ticket ?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonText: 'Annuler',
            confirmButtonText: 'Supprimer'
                }).then(function (result) {
            if (result.isConfirmed) {
                fetch('/reservation/ticket/delete-ajax/' + ticketId)
                            .then(res => res.json())
                            .then(() => location.reload());
            }
        });
    };

    container.appendChild(title);
    container.appendChild(trash);
    return { domNodes: [container] };
},

        eventDidMount: function (arg) {
            let ville = arg.event.extendedProps.ville;
            let date  = arg.event.startStr;

            let dayCell = arg.el.closest('.fc-daygrid-day');
            if (!dayCell) return;
            if (dayCell.querySelector('.weather-btn')) return;

            let btn = document.createElement('button');
            btn.className = 'weather-btn';
            btn.innerHTML = '&#9729; Météo';
            btn.dataset.ville = ville;
            btn.dataset.date  = date;

            btn.addEventListener('click', function (e) {
                e.stopPropagation();
                openWeatherModal(this.dataset.ville, this.dataset.date);
            });

            let topBar = dayCell.querySelector('.fc-daygrid-day-top');
            if (topBar) topBar.appendChild(btn);
        }
    });

    fc.render();

    // ── Reservation row click ──
    document.querySelectorAll('.reservation-row').forEach(function (row) {
    row.addEventListener('click', function () {
            let id = this.dataset.id;
        window.selectedReservationId = id;

        document.querySelectorAll('.weather-btn').forEach(b => b.remove());
        document.getElementById('calendar')
            .scrollIntoView({ behavior: 'smooth', block: 'start' });
        fc.refetchEvents();
        });
    });

}); // ← END of DOMContentLoaded

// ═══════════════════════════════════════════════════════
// WEATHER MODAL — outside DOMContentLoaded
// ═══════════════════════════════════════════════════════
function openWeatherModal(ville, date) {
    let modal = document.getElementById('weather-modal');
    let title = document.getElementById('weather-modal-title');
    let body  = document.getElementById('weather-modal-body');

    let parts = date.split('-');
    let dateFormatted = parts[2] + '/' + parts[1] + '/' + parts[0];

    title.textContent = '\u2601 Météo à ' + ville + ' — ' + dateFormatted;
    body.innerHTML = '<span style="color:#aaa;">Chargement...</span>';
    modal.style.display = 'flex';

    fetch('/meteo/' + encodeURIComponent(ville) + '/' + date)
        .then(function (res) {
            if (!res.ok) throw new Error('HTTP ' + res.status);
            return res.json();
        })
        .then(function (w) {
            body.innerHTML =
                '<div style="text-align:center; width:100%;">' +
                    '<img src="https://openweathermap.org/img/wn/' + w.icon + '@2x.png" style="width:72px; height:72px;">' +
                    '<div style="font-size:42px; font-weight:700; color:#223f91; margin:4px 0; line-height:1;">' + w.temp + '°C</div>' +
                    '<div style="font-size:15px; color:#555; text-transform:capitalize; margin-bottom:16px;">' + w.description + '</div>' +
                    '<div style="display:flex; gap:12px; justify-content:center;">' +
                        '<div style="background:#f0f4ff; border-radius:12px; padding:10px 18px; text-align:center;">' +
                            '<div style="font-size:18px; font-weight:600; color:#223f91;">' + (w.humidity !== undefined ? w.humidity + '%' : '--') + '</div>' +
                            '<div style="font-size:12px; color:#888; margin-top:2px;">Humidité</div>' +
                        '</div>' +
                        '<div style="background:#f0f4ff; border-radius:12px; padding:10px 18px; text-align:center;">' +
                            '<div style="font-size:18px; font-weight:600; color:#223f91;">' + (w.wind !== undefined ? w.wind + ' km/h' : '--') + '</div>' +
                            '<div style="font-size:12px; color:#888; margin-top:2px;">Vent</div>' +
                        '</div>' +
                    '</div>' +
                '</div>';
        })
        .catch(function (err) {
            console.error('Météo erreur:', err);
            body.innerHTML =
                '<div style="text-align:center; color:#c00;">' +
                    '<div style="font-size:28px; margin-bottom:8px;">&#9888;</div>' +
                    '<div>Impossible de charger la météo.</div>' +
                    '<div style="font-size:12px; color:#aaa; margin-top:6px;">Vérifiez que la ville "' + ville + '" est reconnue par OpenWeather.</div>' +
                '</div>';
        });
}

function closeWeatherModal() {
    document.getElementById('weather-modal').style.display = 'none';
}

document.getElementById('weather-modal').addEventListener('click', function (e) {
    if (e.target === this) closeWeatherModal();
});

// ═══════════════════════════════════════════════════════
// DELETE RESERVATION — outside DOMContentLoaded
// ═══════════════════════════════════════════════════════
function deleteReservation(e, id) {
    e.preventDefault();
    Swal.fire({
        title: 'Supprimer la réservation ?',
        text: 'Tous les tickets liés seront libérés',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#d33',
        cancelButtonText: 'Annuler',
        confirmButtonText: 'Oui, supprimer'
    }).then(function (result) {
        if (result.isConfirmed) {
            document.getElementById('delete-form-' + id).submit();
        }
    });
}

// ═══════════════════════════════════════════════════════
// CURRENCY CONVERTER — outside DOMContentLoaded
// ═══════════════════════════════════════════════════════
(function () {
    let rates           = { TND: 1, EUR: null, USD: null };
    let currentCurrency = 'TND';
    const symbols       = { TND: 'TND', EUR: '€', USD: '$' };

    async function fetchRates() {
        try {
            const res  = await fetch('/api/exchange-rates');
            const data = await res.json();
            if (data.result === 'success') {
                rates.EUR = data.conversion_rates.EUR;
                rates.USD = data.conversion_rates.USD;
            }
        } catch (e) {
            console.error('ExchangeRate API error:', e);
        }
    }

    function updatePrices(currency) {
        const rate  = rates[currency];
        const badge = document.getElementById('rate-badge');
        const cells = document.querySelectorAll('.price-cell');

        if (!rate) {
            cells.forEach(c => c.classList.add('price-loading'));
            return;
        }

        cells.forEach(c => {
            c.classList.remove('price-loading');
            const tnd       = parseFloat(c.dataset.tnd);
            const converted = (tnd * rate).toFixed(2);
            c.textContent   = currency === 'TND'
                ? converted + ' TND'
                : symbols[currency] + ' ' + converted;
        });

        if (currency !== 'TND') {
            badge.style.display = 'inline-block';
            badge.textContent   = '1 TND = ' + rate.toFixed(4) + ' ' + currency;
        } else {
            badge.style.display = 'none';
        }
    }

    fetchRates();

    document.querySelectorAll('.btn-currency').forEach(btn => {
        btn.addEventListener('click', async function () {
            const currency = this.dataset.currency;
            if (currency === currentCurrency) return;

            document.querySelectorAll('.btn-currency').forEach(b => b.classList.remove('active'));
            this.classList.add('active');
            currentCurrency = currency;

            if (currency !== 'TND' && rates[currency] === null) {
                document.querySelectorAll('.price-cell').forEach(c => c.classList.add('price-loading'));
                await fetchRates();
            }

            updatePrices(currency);
        });
    });
})();
</script>
