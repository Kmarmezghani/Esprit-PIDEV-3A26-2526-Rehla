<style>
/* ── Calendar ── */
.fc-daygrid-day-top { flex-direction: row !important; align-items: center; }
.weather-btn {
    font-size: 10px; background: #e8f0fe; color: #185FA5;
    border: none; border-radius: 10px; padding: 2px 7px;
    cursor: pointer; margin-left: auto; margin-right: 4px;
    margin-top: 3px; white-space: nowrap; transition: background 0.15s;
}
.weather-btn:hover { background: #c5d8fb; }
.fc-daygrid-event { white-space: normal !important; }
#weather-modal { cursor: pointer; }
#weather-modal > div { cursor: default; }

/* ── Currency switcher ── */
.btn-currency {
    font-size: 12px; padding: 5px 14px;
    border: 1.5px solid #d0d9f0; background: #fff;
    color: #555; border-radius: 0;
    transition: all 0.18s; font-weight: 500;
}
.btn-currency:first-child { border-radius: 20px 0 0 20px; }
.btn-currency:last-child  { border-radius: 0 20px 20px 0; }
.btn-currency.active { background: #223f91; color: #fff; border-color: #223f91; }
.btn-currency:hover:not(.active) { background: #f0f4ff; border-color: #223f91; color: #223f91; }
.price-cell { transition: opacity 0.2s; }
.price-loading { opacity: 0.4; }

/* ══ AI PANEL ══════════════════════════════════════════════════════════ */

/* Floating trigger button */
.ai-fab {
    position: fixed; bottom: 32px; right: 32px; z-index: 8999;
    background: #223f91; color: #fff; border: none;
    border-radius: 50px; padding: 14px 24px;
    font-size: 14px; font-weight: 500; cursor: pointer;
    display: flex; align-items: center; gap: 8px;
    box-shadow: 0 4px 24px rgba(34,63,145,0.4);
    transition: background 0.18s, transform 0.15s;
}
.ai-fab:hover { background: #1a2f6e; transform: translateY(-2px); }
.ai-fab:active { transform: translateY(0); }

/* Overlay + panel */
.ai-panel-overlay {
    position: fixed; inset: 0;
    background: rgba(0,0,0,0.45);
    z-index: 9000; display: none; align-items: flex-end;
}
.ai-panel-overlay.open { display: flex; }
.ai-panel {
    background: #fff; border-radius: 20px 20px 0 0;
    width: 100%; max-width: 700px; margin: 0 auto;
    max-height: 90vh; overflow-y: auto;
    display: flex; flex-direction: column;
}

/* Sticky header */
.ai-panel-header {
    position: sticky; top: 0; background: #fff;
    border-bottom: 1px solid #eef0f8;
    padding: 18px 24px 16px;
    display: flex; justify-content: space-between; align-items: center;
    z-index: 1; border-radius: 20px 20px 0 0;
}
.ai-panel-title {
    font-size: 16px; font-weight: 500; color: #223f91;
    display: flex; align-items: center; gap: 8px;
}
.ai-badge {
    font-size: 11px; background: #e8f0fe; color: #223f91;
    padding: 3px 10px; border-radius: 20px; font-weight: 400;
}
.ai-close-btn {
    border: none; background: #f0f4ff; color: #223f91;
    width: 32px; height: 32px; border-radius: 50%;
    font-size: 18px; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    line-height: 1; transition: background 0.15s;
}
.ai-close-btn:hover { background: #dce5fb; }

/* Panel body */
.ai-panel-body { padding: 20px 24px 28px; display: flex; flex-direction: column; gap: 18px; }

/* Section label */
.ai-section-label {
    font-size: 10px; letter-spacing: .7px;
    text-transform: uppercase; color: #aaa;
    font-weight: 500; margin-bottom: 8px;
}

/* Context cards */
.ai-ctx-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 8px; }
.ai-ctx-card {
    background: #f7f9ff; border: 1px solid #e4eaf8;
    border-radius: 10px; padding: 10px 12px;
}
.ai-ctx-label { font-size: 11px; color: #aaa; margin-bottom: 3px; }
.ai-ctx-value { font-size: 13px; font-weight: 500; color: #223f91; }

/* Inputs */
.ai-row { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
.ai-input {
    padding: 8px 12px; border: 1px solid #d0d9f0;
    border-radius: 8px; font-size: 13px; color: #333; background: #fff;
    transition: border-color 0.15s, box-shadow 0.15s;
}
.ai-input:focus { outline: none; border-color: #223f91; box-shadow: 0 0 0 3px rgba(34,63,145,.1); }

/* Generate button */
.ai-gen-btn {
    width: 100%; padding: 13px; background: #223f91; color: #fff;
    border: none; border-radius: 12px; font-size: 15px; font-weight: 500;
    cursor: pointer; display: flex; align-items: center;
    justify-content: center; gap: 8px; transition: background 0.18s;
}
.ai-gen-btn:hover:not(:disabled) { background: #1a2f6e; }
.ai-gen-btn:disabled { opacity: .5; cursor: not-allowed; }

/* Result box */
.ai-result { border: 1px solid #d4e0fb; border-radius: 14px; overflow: hidden; display: none; }
.ai-result.visible { display: block; }

/* Result hero */
.ai-result-hero {
    background: #223f91;
    padding: 20px 22px 16px;
}
.ai-result-dest {
    font-size: 20px; font-weight: 500; color: #fff;
    margin-bottom: 10px; display: flex; align-items: center; gap: 8px;
}
.ai-result-tags { display: flex; gap: 6px; flex-wrap: wrap; }
.ai-result-tag {
    font-size: 11px; background: rgba(255,255,255,0.18);
    color: #fff; border: 1px solid rgba(255,255,255,0.28);
    border-radius: 20px; padding: 3px 11px;
}

/* Result body */
.ai-result-body { padding: 18px 20px; display: flex; flex-direction: column; gap: 14px; background: #fff; }

/* Raison */
.ai-raison {
    font-size: 13px; color: #555; line-height: 1.65;
    padding: 12px 14px; background: #f7f9ff;
    border-left: 3px solid #223f91; border-radius: 0 8px 8px 0;
}

/* Activity cards */
.ai-activity-card {
    background: #f0fff4; border: 1px solid #b7ebc8;
    border-radius: 10px; padding: 12px 14px;
    display: flex; justify-content: space-between;
    align-items: flex-start; gap: 8px; margin-bottom: 6px;
}
.ai-activity-name { font-size: 13px; font-weight: 500; color: #1a7a3c; margin-bottom: 3px; }
.ai-activity-meta { font-size: 11px; color: #888; }
.ai-activity-price { font-size: 14px; font-weight: 500; color: #1a7a3c; white-space: nowrap; }

/* Ticket rows */
.ai-ticket {
    display: flex; justify-content: space-between; align-items: center;
    padding: 8px 0; border-bottom: 1px solid #f0f4ff; font-size: 13px;
}
.ai-ticket:last-child { border-bottom: none; }
.ai-ticket-name { color: #223f91; font-weight: 500; }

/* Total */
.ai-total {
    display: flex; justify-content: space-between;
    font-size: 15px; font-weight: 500;
    padding: 12px 0 0; border-top: 2px solid #223f91; color: #223f91;
}

/* CTA button */
.ai-cta-btn {
    width: 100%; padding: 13px; background: #27ae60; color: #fff;
    border: none; border-radius: 12px; font-size: 15px; font-weight: 500;
    cursor: pointer; display: flex; align-items: center;
    justify-content: center; gap: 8px; transition: background 0.18s;
}
.ai-cta-btn:hover { background: #1e8449; }

/* Loading dots */
.ai-typing { display: inline-flex; gap: 5px; align-items: center; }
.ai-typing span {
    width: 7px; height: 7px; background: #223f91;
    border-radius: 50%; animation: aiBounce .8s infinite;
}
.ai-typing span:nth-child(2) { animation-delay: .15s; }
.ai-typing span:nth-child(3) { animation-delay: .3s; }
@keyframes aiBounce {
    0%,60%,100% { transform: translateY(0); }
    30% { transform: translateY(-6px); }
}
</style>

<link href="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
document.addEventListener('DOMContentLoaded', function () {

    const calendarEl = document.getElementById('calendar');

    const fc = new FullCalendar.Calendar(calendarEl, {
        initialView: 'dayGridMonth',
        events: function (info, successCallback, failureCallback) {
            if (!window.selectedReservationId) { successCallback([]); return; }
            fetch('/reservation/' + window.selectedReservationId + '/tickets')
                .then(res => res.json())
                .then(data => successCallback(data))
                .catch(() => failureCallback());
        },
        eventContent: function (arg) {
            const container = document.createElement('div');
            container.style.cssText = 'display:flex;align-items:center;justify-content:space-between;width:100%;padding:1px 4px;';
            const title = document.createElement('span');
            title.textContent = arg.event.title;
            title.style.cssText = 'font-size:12px;overflow:hidden;text-overflow:ellipsis;';
            const trash = document.createElement('i');
            trash.className = 'fa fa-trash';
            trash.style.cssText = 'cursor:pointer;color:#e55;margin-left:6px;font-size:11px;flex-shrink:0;';
            trash.title = 'Supprimer ce ticket';
            const ticketId = arg.event.extendedProps.ticketId;
            trash.onclick = function (e) {
                e.stopPropagation();
                Swal.fire({
                    title: 'Supprimer ce ticket ?', icon: 'warning',
                    showCancelButton: true, confirmButtonColor: '#d33',
                    cancelButtonText: 'Annuler', confirmButtonText: 'Supprimer'
                }).then(function (result) {
                    if (result.isConfirmed) {
                        fetch('/reservation/ticket/delete-ajax/' + ticketId)
                            .then(res => res.json())
                            .then(() => location.reload());
                    }
                });
            };
            container.appendChild(title);
            container.appendChild(trash);
            return { domNodes: [container] };
        },
        eventDidMount: function (arg) {
            const ville = arg.event.extendedProps.ville;
            const date  = arg.event.startStr;
            const dayCell = arg.el.closest('.fc-daygrid-day');
            if (!dayCell || dayCell.querySelector('.weather-btn')) return;
            const btn = document.createElement('button');
            btn.className = 'weather-btn';
            btn.innerHTML = '&#9729; Météo';
            btn.dataset.ville = ville;
            btn.dataset.date  = date;
            btn.addEventListener('click', function (e) {
                e.stopPropagation();
                openWeatherModal(this.dataset.ville, this.dataset.date);
            });
            const topBar = dayCell.querySelector('.fc-daygrid-day-top');
            if (topBar) topBar.appendChild(btn);
        }
    });

    fc.render();

    document.querySelectorAll('.reservation-row').forEach(function (row) {
        row.addEventListener('click', function () {
            window.selectedReservationId = this.dataset.id;
            document.querySelectorAll('.weather-btn').forEach(b => b.remove());
            document.getElementById('calendar').scrollIntoView({ behavior: 'smooth', block: 'start' });
            fc.refetchEvents();
        });
    });

}); // END DOMContentLoaded

// ── Weather Modal ──────────────────────────────────────────────────────
function openWeatherModal(ville, date) {
    const modal = document.getElementById('weather-modal');
    const title = document.getElementById('weather-modal-title');
    const body  = document.getElementById('weather-modal-body');
    const parts = date.split('-');
    title.textContent = '\u2601 Météo à ' + ville + ' — ' + parts[2] + '/' + parts[1] + '/' + parts[0];
    body.innerHTML = '<span style="color:#aaa;">Chargement...</span>';
    modal.style.display = 'flex';
    fetch('/meteo/' + encodeURIComponent(ville) + '/' + date)
        .then(res => { if (!res.ok) throw new Error('HTTP ' + res.status); return res.json(); })
        .then(w => {
            body.innerHTML =
                '<div style="text-align:center;width:100%;">' +
                '<img src="https://openweathermap.org/img/wn/' + w.icon + '@2x.png" style="width:72px;height:72px;">' +
                '<div style="font-size:42px;font-weight:700;color:#223f91;margin:4px 0;line-height:1;">' + w.temp + '°C</div>' +
                '<div style="font-size:15px;color:#555;text-transform:capitalize;margin-bottom:16px;">' + w.description + '</div>' +
                '<div style="display:flex;gap:12px;justify-content:center;">' +
                '<div style="background:#f0f4ff;border-radius:12px;padding:10px 18px;text-align:center;">' +
                '<div style="font-size:18px;font-weight:600;color:#223f91;">' + (w.humidity !== undefined ? w.humidity + '%' : '--') + '</div>' +
                '<div style="font-size:12px;color:#888;margin-top:2px;">Humidité</div></div>' +
                '<div style="background:#f0f4ff;border-radius:12px;padding:10px 18px;text-align:center;">' +
                '<div style="font-size:18px;font-weight:600;color:#223f91;">' + (w.wind !== undefined ? w.wind + ' km/h' : '--') + '</div>' +
                '<div style="font-size:12px;color:#888;margin-top:2px;">Vent</div></div></div></div>';
        })
        .catch(() => {
            body.innerHTML = '<div style="text-align:center;color:#c00;">' +
                '<div style="font-size:28px;margin-bottom:8px;">&#9888;</div>' +
                '<div>Impossible de charger la météo.</div>' +
                '<div style="font-size:12px;color:#aaa;margin-top:6px;">Vérifiez que la ville "' + ville + '" est reconnue par OpenWeather.</div></div>';
        });
}
function closeWeatherModal() { document.getElementById('weather-modal').style.display = 'none'; }
document.getElementById('weather-modal').addEventListener('click', function (e) { if (e.target === this) closeWeatherModal(); });

// ── Delete reservation ─────────────────────────────────────────────────
function deleteReservation(e, id) {
    e.preventDefault();
    Swal.fire({
        title: 'Supprimer la réservation ?', text: 'Tous les tickets liés seront libérés',
        icon: 'warning', showCancelButton: true, confirmButtonColor: '#d33',
        cancelButtonText: 'Annuler', confirmButtonText: 'Oui, supprimer'
    }).then(function (result) {
        if (result.isConfirmed) document.getElementById('delete-form-' + id).submit();
    });
}

// ── Currency converter ─────────────────────────────────────────────────
(function () {
    let rates = { TND: 1, EUR: null, USD: null };
    let currentCurrency = 'TND';
    const symbols = { TND: 'TND', EUR: '€', USD: '$' };
    async function fetchRates() {
        try {
            const res  = await fetch('/api/exchange-rates');
            const data = await res.json();
            if (data.result === 'success') { rates.EUR = data.conversion_rates.EUR; rates.USD = data.conversion_rates.USD; }
        } catch (e) { console.error('ExchangeRate API error:', e); }
    }
    function updatePrices(currency) {
        const rate  = rates[currency];
        const badge = document.getElementById('rate-badge');
        const cells = document.querySelectorAll('.price-cell');
        if (!rate) { cells.forEach(c => c.classList.add('price-loading')); return; }
        cells.forEach(c => {
            c.classList.remove('price-loading');
            const converted = (parseFloat(c.dataset.tnd) * rate).toFixed(2);
            c.textContent = currency === 'TND' ? converted + ' TND' : symbols[currency] + ' ' + converted;
        });
        if (currency !== 'TND') { badge.style.display = 'inline-block'; badge.textContent = '1 TND = ' + rate.toFixed(4) + ' ' + currency; }
        else { badge.style.display = 'none'; }
    }
    fetchRates();
    document.querySelectorAll('.btn-currency').forEach(btn => {
        btn.addEventListener('click', async function () {
            const currency = this.dataset.currency;
            if (currency === currentCurrency) return;
            document.querySelectorAll('.btn-currency').forEach(b => b.classList.remove('active'));
            this.classList.add('active');
            currentCurrency = currency;
            if (currency !== 'TND' && rates[currency] === null) {
                document.querySelectorAll('.price-cell').forEach(c => c.classList.add('price-loading'));
                await fetchRates();
            }
            updatePrices(currency);
        });
    });
})();
</script>

{# ══ AI RECOMMENDATION PANEL ══════════════════════════════════════════ #}

{# Floating trigger button #}
<button class="ai-fab" onclick="openAIPanel()">
    <i class="fa fa-magic"></i> Recommandation IA
</button>

{# Slide-up panel #}
<div class="ai-panel-overlay" id="aiPanelOverlay" onclick="handleAIOverlay(event)">
    <div class="ai-panel" id="aiPanel">

        <div class="ai-panel-header">
            <div class="ai-panel-title">
                <i class="fa fa-magic"></i>
                Recommandation personnalisée
                <span class="ai-badge">IA</span>
            </div>
            <button class="ai-close-btn" onclick="closeAIPanel()">&times;</button>
        </div>

        <div class="ai-panel-body">

            {# Context cards #}
            <div>
                <div class="ai-section-label">Votre profil analysé</div>
                <div class="ai-ctx-grid">
                    <div class="ai-ctx-card">
                        <div class="ai-ctx-label">Réservations</div>
                        <div class="ai-ctx-value">{{ reservations|length }} voyages</div>
                    </div>
                    <div class="ai-ctx-card">
                        <div class="ai-ctx-label">Destinations</div>
                        <div class="ai-ctx-value">
                            {% set dests = [] %}
                            {% for r in reservations %}
                                {% if r.destination and r.destination.nom not in dests %}
                                    {% set dests = dests|merge([r.destination.nom]) %}
                                {% endif %}
                            {% endfor %}
                            {{ dests|join(', ')|default('Aucune') }}
                        </div>
                    </div>
                    
                </div>
            </div>

            {# Budget #}
            <div>
                <div class="ai-section-label">Budget pour ce voyage (TND)</div>
                <div class="ai-row">
                    <input type="number" class="ai-input" id="aiBudgetMin" placeholder="Min" value="500" style="width:100px">
                    <span style="color:#ccc; font-size:20px;">—</span>
                    <input type="number" class="ai-input" id="aiBudgetMax" placeholder="Max" value="2000" style="width:100px">
                    <span style="font-size:13px; color:#aaa;">TND</span>
                </div>
            </div>

            {# Dates #}
            <div>
                <div class="ai-section-label">Période souhaitée</div>
                <div class="ai-row">
                    <input type="date" class="ai-input" id="aiDateDebut">
                    <span style="color:#aaa;">→</span>
                    <input type="date" class="ai-input" id="aiDateFin">
                </div>
            </div>

            <button class="ai-gen-btn" id="aiGenBtn" onclick="launchAIRecommendation()">
                <i class="fa fa-magic"></i> Générer ma recommandation
            </button>

            <div class="ai-result" id="aiResult">
                <div id="aiResultInner"></div>
            </div>

        </div>
    </div>
</div>

<script>
function openAIPanel() {
    document.getElementById('aiPanelOverlay').classList.add('open');
    const today = new Date();
    const next  = new Date(); next.setDate(today.getDate() + 7);
    document.getElementById('aiDateDebut').value = today.toISOString().split('T')[0];
    document.getElementById('aiDateFin').value   = next.toISOString().split('T')[0];
}
function closeAIPanel() {
    document.getElementById('aiPanelOverlay').classList.remove('open');
}
function handleAIOverlay(e) {
    if (e.target === document.getElementById('aiPanelOverlay')) closeAIPanel();
}

function showAIResult(html) {
    document.getElementById('aiResultInner').innerHTML = html;
    document.getElementById('aiResult').classList.add('visible');
}

let aiLastCall = 0;

async function launchAIRecommendation() {
    const now = Date.now();
    if (now - aiLastCall < 15000) {
        const remaining = Math.ceil((15000 - (now - aiLastCall)) / 1000);
        showAIResult(`<div style="padding:24px;text-align:center;color:#e67e22;">
            <i class="fa fa-clock-o" style="font-size:28px;display:block;margin-bottom:8px;"></i>
            Attendez encore <strong>${remaining}s</strong> avant de relancer.
        </div>`);
        return;
    }
    aiLastCall = now;

    const btn = document.getElementById('aiGenBtn');
    btn.disabled = true;
    btn.innerHTML = '<div class="ai-typing"><span></span><span></span><span></span></div>&nbsp;Analyse en cours...';
    showAIResult(`<div style="padding:36px;text-align:center;"><div class="ai-typing"><span></span><span></span><span></span></div></div>`);

    const dateDebutVal = document.getElementById('aiDateDebut').value;
    const dateFinVal   = document.getElementById('aiDateFin').value;

    try {
        const resp = await fetch('/api/recommandation-ia', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                budgetMin: document.getElementById('aiBudgetMin').value,
                budgetMax: document.getElementById('aiBudgetMax').value,
                dateDebut: dateDebutVal,
                dateFin:   dateFinVal,
            })
        });

        const d = await resp.json();
        console.log('AI Response:', JSON.stringify(d));

        if (resp.status === 429 || d.error) {
            showAIResult(`<div style="padding:24px;text-align:center;color:#c00;">
                <i class="fa fa-warning" style="font-size:24px;display:block;margin-bottom:8px;"></i>
                ${d.message || d.error || 'Erreur. Réessayez.'}
            </div>`);
            return;
        }

        const ticketIdsChoisis   = (d.tickets   || []).map(t => t.id).filter(Boolean);
        const activiteIdsChoisis = (d.activites || []).map(a => a.id).filter(Boolean);

        const activitesHTML = (d.activites || []).map(a => `
            <div class="ai-activity-card">
                <div>
                    <div class="ai-activity-name">
                        <i class="fa fa-calendar-check-o" style="margin-right:5px;font-size:12px;"></i>${a.nom}
                    </div>
                    <div class="ai-activity-meta">
                        <i class="fa fa-tag" style="margin-right:3px;"></i>${a.type || ''}
                        &nbsp;·&nbsp;
                        <i class="fa fa-calendar" style="margin-right:3px;"></i>${a.date_debut || ''} → ${a.date_fin || ''}
                    </div>
                </div>
                <div class="ai-activity-price">${a.prix} TND</div>
            </div>`).join('');

        const ticketsHTML = (d.tickets || []).map(t => `
            <div class="ai-ticket">
                <span class="ai-ticket-name">
                    <i class="fa fa-ticket" style="margin-right:6px;font-size:12px;"></i>${t.nom}
                </span>
                <span>${t.prix} TND</span>
            </div>`).join('');

        showAIResult(`
            <div class="ai-result-hero">
                <div class="ai-result-dest">
                    <i class="fa fa-map-marker" style="font-size:16px;"></i>${d.destination}
                </div>
                <div class="ai-result-tags">
                    <span class="ai-result-tag">📅 ${d.dateDebut} → ${d.dateFin}</span>
                    <span class="ai-result-tag">☀️ ${d.meteo || 'Météo favorable'}</span>
                    <span class="ai-result-tag">✅ Dans votre budget</span>
                </div>
            </div>
            <div class="ai-result-body">
                <div class="ai-raison">${d.raison}</div>

                ${activitesHTML ? `
                <div>
                    <div class="ai-section-label">🎯 Activités recommandées</div>
                    ${activitesHTML}
                </div>` : ''}

                ${ticketsHTML ? `
                <div>
                    <div class="ai-section-label">🎫 Tickets inclus</div>
                    ${ticketsHTML}
                </div>` : ''}

                <div class="ai-total">
                    <span>Total estimé</span>
                    <span>${d.total} TND</span>
                </div>

                <button class="ai-cta-btn"
                    onclick="creerReservationIA(${d.destination_id}, ${JSON.stringify(ticketIdsChoisis)}, ${JSON.stringify(activiteIdsChoisis)}, '${dateDebutVal}', '${dateFinVal}')">
                    <i class="fa fa-check-circle"></i> Créer cette réservation
                </button>
            </div>`);

    } catch (err) {
        showAIResult(`<div style="padding:24px;text-align:center;color:#c00;">
            <i class="fa fa-warning" style="font-size:24px;display:block;margin-bottom:8px;"></i>
            Erreur réseau. Réessayez.
        </div>`);
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="fa fa-magic"></i> Régénérer';
    }
}

async function creerReservationIA(destinationId, ticketIds, activiteIds, dateDebut, dateFin) {
    if (!destinationId || (!ticketIds.length && !activiteIds.length)) {
        Swal.fire('Erreur', "Données de réservation incomplètes.", 'error');
        return;
    }
    const confirmation = await Swal.fire({
        title: 'Confirmer la réservation ?',
        text: "Une réservation sera créée avec les activités et tickets sélectionnés par l'IA.",
        icon: 'question', showCancelButton: true,
        confirmButtonColor: '#27ae60',
        cancelButtonText: 'Annuler', confirmButtonText: 'Oui, créer !'
    });
    if (!confirmation.isConfirmed) return;
    try {
        const resp = await fetch('/api/recommandation-ia/creer', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                destination_id: destinationId,
                ticket_ids:     ticketIds,
                activite_ids:   activiteIds,
                dateDebut,
                dateFin
            })
        });
        const d = await resp.json();
        if (d.success) {
            Swal.fire({ title: 'Réservation créée !', text: d.message, icon: 'success', confirmButtonText: 'Voir mes réservations' })
                .then(() => window.location.reload());
        } else {
            Swal.fire('Erreur', d.error || 'Une erreur est survenue.', 'error');
        }
    } catch (e) {
        Swal.fire('Erreur', 'Erreur réseau.', 'error');
    }
}
</script>

