<script>
document.addEventListener('DOMContentLoaded', function () {
    const generateBtn = document.getElementById('generate-description-btn');
    const loader = document.getElementById('ai-description-loader');
    const errorBox = document.getElementById('ai-description-error');

    if (!generateBtn) return;

    generateBtn.addEventListener('click', async function () {
        const nomField = document.querySelector('[name$="[nom]"]');
        const typeField = document.querySelector('[name$="[typeActivite]"]');
        const destinationField = document.querySelector('[name$="[destination]"]');
        const dateDebutField = document.querySelector('[name$="[date_debut]"]');
        const dateFinField = document.querySelector('[name$="[date_fin]"]');
        const descriptionField = document.querySelector('[name$="[description]"]');

        errorBox.style.display = 'none';
        errorBox.textContent = '';
        loader.style.display = 'block';
        generateBtn.disabled = true;

        if (!nomField?.value.trim() || !typeField?.value.trim() || !destinationField?.value.trim()) {
            loader.style.display = 'none';
            generateBtn.disabled = false;
            errorBox.textContent = "Remplis le nom, le type et la destination avant de générer.";
            errorBox.style.display = 'block';
            return;
        }

        let duration = '';
        if (dateDebutField && dateFinField && dateDebutField.value && dateFinField.value) {
            duration = dateDebutField.value + ' -> ' + dateFinField.value;
        }

        try {
            const response = await fetch('{{ path('guide_generate_description') }}', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify({
                    nom: nomField.value,
                    typeActivite: typeField.value,
                    destination: destinationField.value,
                    duration: duration
                })
            });

            const rawText = await response.text();
            console.log('RAW RESPONSE:', rawText);

            let data;
            try {
                data = JSON.parse(rawText);
            } catch (e) {
                throw new Error('Le serveur renvoie du HTML au lieu de JSON. Ouvre F12 > Console > RAW RESPONSE.');
            }

            if (!response.ok || !data.success) {
                throw new Error(data.message || 'Erreur lors de la génération.');
            }

            if (descriptionField) {
                descriptionField.value = data.description;
            }
        } catch (error) {
            console.error(error);
            errorBox.textContent = error.message;
            errorBox.style.display = 'block';
        } finally {
            loader.style.display = 'none';
            generateBtn.disabled = false;
        }
    });
});
</script>
<script>
		function confirmLogoutHome(e) {
			e.preventDefault();
			Swal.fire({
				title: 'Déconnexion',
				text: 'Êtes-vous sûr de vouloir vous déconnecter ?',
				icon: 'question',
				showCancelButton: true,
				confirmButtonColor: '#223f91',
				cancelButtonColor: '#6c757d',
				confirmButtonText: 'Oui, me déconnecter',
				cancelButtonText: 'Annuler'
			}).then((result) => {
				if (result.isConfirmed) {
					document.getElementById('logoutFormHome').submit();
				}
			});
		}
		</script>


