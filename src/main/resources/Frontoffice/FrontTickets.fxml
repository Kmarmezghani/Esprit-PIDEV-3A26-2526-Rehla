<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700" prefWidth="1000"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controllers.FrontTicketsController"
            style="-fx-background-color: linear-gradient(to bottom, #3A5BC7, #223f91);">

    <children>

        <VBox alignment="CENTER" spacing="30"
              AnchorPane.topAnchor="0"
              AnchorPane.bottomAnchor="0"
              AnchorPane.leftAnchor="0"
              AnchorPane.rightAnchor="0">

            <Label fx:id="titleLabel" text="Tickets" textFill="WHITE">
                <font><Font size="34"/></font>
            </Label>

            <VBox spacing="20"
                  style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 30;">

                <Label fx:id="recommendationLabel"
                       text=""
                       style="-fx-font-weight: bold; -fx-text-fill: green;" />

                <TableView fx:id="ticketTable" prefWidth="850" prefHeight="400">

                    <columns>
                        <TableColumn fx:id="colType" text="Type" prefWidth="150"/>
                        <TableColumn fx:id="colDestination" text="Destination" prefWidth="200"/>
                        <TableColumn fx:id="colPrice" text="Price" prefWidth="120"/>
                        <TableColumn fx:id="colSelect" text="Select" prefWidth="100"/>
                        <TableColumn fx:id="colRecommended" text="Recommendation" />
                    </columns>

                </TableView>

                <HBox alignment="CENTER_RIGHT" spacing="10">
                    <Button text="Back"
                            onAction="#handleBack"
                            style="-fx-background-color: gray; -fx-text-fill:white;"/>
                    <Button text="Book Now"
                            onAction="#handleBookTicket"
                            style="-fx-background-color:#3A5BC7; -fx-text-fill:white;"/>
                </HBox>

            </VBox>

        </VBox>
    </children>
</AnchorPane>