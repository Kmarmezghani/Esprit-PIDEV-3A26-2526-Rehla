<script>
document.addEventListener('DOMContentLoaded', function () {

    // ── Stepper ──────────────────────────────────────────────
    let currentStep = 0;
    const steps          = document.querySelectorAll('.form-step');
    const stepIndicators = document.querySelectorAll('.stepper-item');

    function showStep(index) {
        steps.forEach((step, i) => step.classList.toggle('d-none', i !== index));
        stepIndicators.forEach((ind, i) => ind.classList.toggle('active', i <= index));
    }

    document.querySelectorAll('.next-step').forEach(btn =>
        btn.addEventListener('click', () => {
            if (currentStep < steps.length - 1) {
                currentStep++;
                showStep(currentStep);
                if (currentStep === 2) {
                    loadTickets();
                }
            }
        })
    );

    document.querySelectorAll('.prev-step').forEach(btn =>
        btn.addEventListener('click', () => {
            if (currentStep > 0) { currentStep--; showStep(currentStep); }
        })
    );

    // ── Select destination — chercher par name ET par id ─────
    // Symfony génère l'id "reservation_user_destination", pas "destination_select"
    const destinationSelect = document.querySelector('[name="reservation_user[destination]"]')
                           || document.getElementById('destination_select');
    const ticketsContainer  = document.getElementById('tickets-container');

    const reservaId = '{{ isEdit is defined and isEdit and app.request.attributes.get("id") is not null ? app.request.attributes.get("id") : "" }}';
    const isEdit    = {{ isEdit is defined and isEdit ? 'true' : 'false' }};

    function loadTickets() {
        if (!destinationSelect || !ticketsContainer) return;

        const villeId = destinationSelect.value;

        if (!villeId) {
            ticketsContainer.innerHTML = '<p class="text-muted">Veuillez d\'abord sélectionner une destination.</p>';
            return;
        }

        ticketsContainer.innerHTML = '<div class="text-center py-3"><div class="spinner-border text-primary" role="status"></div><p class="mt-2 text-muted">Chargement des tickets…</p></div>';

        fetch(`/api/tickets-by-destination?ville=${villeId}&reservation=${reservaId}`)
            .then(r => r.json())
            .then(tickets => {
                if (tickets.length === 0) {
                    ticketsContainer.innerHTML = '<p class="text-warning">Aucun ticket disponible pour cette destination.</p>';
                    return;
                }

                ticketsContainer.innerHTML = tickets.map(t => `
                    <div class="col-md-6 mb-3">
                        <div class="card p-3 shadow-sm">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox"
                                       name="reservation_user[tickets][]"
                                       id="ticket_${t.id}"
                                       value="${t.id}"
                                       ${t.selected ? 'checked' : ''}>
                                <label class="form-check-label" for="ticket_${t.id}">
                                    ${t.type} — ${t.prix} TND
                                </label>
                            </div>
                        </div>
                    </div>
                `).join('');
            })
            .catch(err => {
                console.error('Erreur tickets:', err);
                ticketsContainer.innerHTML = '<p class="text-danger">Erreur lors du chargement des tickets.</p>';
            });
    }

    // Si l'utilisateur change la destination, réinitialiser les tickets
    if (destinationSelect) {
        destinationSelect.addEventListener('change', function () {
            if (currentStep === 2) {
                // Si déjà au step tickets, recharger directement
                loadTickets();
            } else {
                // Sinon, vider pour forcer rechargement propre à l'arrivée au step 3
                ticketsContainer.innerHTML = '<p class="text-muted">Veuillez cliquer sur Suivant pour voir les tickets.</p>';
            }
        });
    }

    // En mode edit : charger immédiatement (destination déjà sélectionnée)
    if (isEdit && destinationSelect && destinationSelect.value) {
        loadTickets();
    }
});
</script>

<form id="logoutForm" method="get" action="{{ path('app_logout') }}" style="display:none;"></form>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
function confirmLogout(e) {
    e.preventDefault();
    Swal.fire({
        title: 'Déconnexion',
        text: 'Êtes-vous sûr de vouloir vous déconnecter ?',
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#223f91',
        cancelButtonColor: '#6c757d',
        confirmButtonText: 'Oui, me déconnecter',
        cancelButtonText: 'Annuler'
    }).then((result) => {
        if (result.isConfirmed) document.getElementById('logoutForm').submit();
    });
}
</script>

