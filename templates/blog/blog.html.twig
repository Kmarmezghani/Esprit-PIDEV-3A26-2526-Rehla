{# *-------------------------------------------pop up comments------------------------------------------------------------- #}
<!-- OVERLAY FLOU -->
<div id="commentOverlay" class="overlay-blur"></div>

<div id="commentPopup" class="comment-popup">
  
  <!-- HEADER -->
  <div class="popup-header">
    <h5>💬 Commentaires</h5>
    <span id="closePopup">&times;</span>
  </div>

  <!-- BODY -->
 <div class="popup-body">

{% for post in posts %}
  <div class="comments-container" data-post="{{ post.id }}" style="display:none;">

    {% for comment in post.commentaires %}
      <div class="comment-box">

        <img src="{{ comment.personne_id.profile_photo ? asset(comment.personne_id.profile_photo) : asset('assets/images/bg_2.jpg') }}"
             class="comment-avatar">

        <div class="comment-bubble">
          <div class="comment-header">
            <strong>{{ comment.personne_id.nom }} {{ comment.personne_id.prenom }}</strong>
            <small>{{ comment.dateCommentaire|date('d M Y H:i:s') }}</small>
          </div>

           <!-- TEXTE -->
          <p class="comment-text">{{ comment.contenu }}</p>

            <!-- INPUT EDIT (caché) -->
          <div class="edit-zone" style="display:none;">
            <input type="text" class="edit-input" value="{{ comment.contenu }}">
            <button class="save-edit"
                    data-id="{{ comment.id }}"
                    data-url="/comment/edit/{{ comment.id }}">
              ✔
            </button>
            <button class="cancel-edit">✖</button>
          </div>

          <div class="comment-icons">
            <i class="fa fa-edit edit-comment"></i>
            <i class="fa fa-trash delete-comment"
              data-id="{{ comment.id }}"
              data-url="/comment/delete/{{ comment.id }}"></i>
          </div>
        </div>

      </div>
    {% else %}
      <p class="text-center text-muted">Aucun commentaire</p>
    {% endfor %}

  </div>
{% endfor %}

</div>

  <!-- FOOTER -->
<form method="POST" id="commentForm">
  <div class="popup-footer">

    <img src="{{ asset('assets/images/bg_2.jpg') }}" class="comment-avatar-small">
    <input type="text" name="contenu" id="comment_input"
           placeholder="Écrire un commentaire...">
    <input type="hidden" id="comment_post_id">

    <button type="submit">Envoyer</button>

  </div>
</form>
  

</div>

