    <script>
function increaseTickets(id, max) {
    let input = document.getElementById('nbTickets' + id);
    let value = parseInt(input.value);

    if (value < max) {
        input.value = value + 1;
    }
}

function decreaseTickets(id) {
    let input = document.getElementById('nbTickets' + id);
    let value = parseInt(input.value);

    if (value > 1) {
        input.value = value - 1;
    }
}
</script>
<script>
function startFlashSaleTimers() {
    const timers = document.querySelectorAll('.flash-timer');

    timers.forEach((timer) => {
        const expiresAt = new Date(timer.dataset.expiresAt).getTime();

        function updateTimer() {
            const now = new Date().getTime();
            const distance = expiresAt - now;

            if (distance <= 0) {
                timer.innerHTML = 'Expired';
                timer.style.color = '#d62828';
                return;
            }

            const days = Math.floor(distance / (1000 * 60 * 60 * 24));
            const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
            const seconds = Math.floor((distance % (1000 * 60)) / 1000);

            if (days > 0) {
                timer.innerHTML = `Expires in ${days}d ${hours}h ${minutes}m ${seconds}s`;
            } else {
                timer.innerHTML = `Expires in ${hours}h ${minutes}m ${seconds}s`;
            }
        }

        updateTimer();
        setInterval(updateTimer, 1000);
    });
}

document.addEventListener('DOMContentLoaded', function () {
    startFlashSaleTimers();
});
</script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.waitlist-notif-link').forEach(function (link) {
        link.addEventListener('click', function (e) {
            e.preventDefault();

            const activiteId = this.dataset.activiteId;
            const message = this.dataset.message;
            const maxTickets = parseInt(this.dataset.maxTickets || '1', 10);

            Swal.fire({
                title: 'Place disponible',
                html: `
                    <div style="font-size:14px; color:#444; line-height:1.5; margin-bottom:14px;">
                        ${message}<br><br>
                        Vous pouvez réserver de <strong>1</strong> à <strong>${maxTickets}</strong> ticket(s).
                    </div>

                    <div style="text-align:left;">
                        <label style="font-size:14px; font-weight:600; color:#223f91; display:block; margin-bottom:8px;">
                            Nombre de tickets
                        </label>
                        <input id="hold-ticket-qty" type="number" min="1" max="${maxTickets}" value="1"
                               style="width:100%; height:42px; border:1px solid #d9e2f2; border-radius:10px; padding:0 12px;">
                    </div>
                `,
                icon: 'info',
                showCancelButton: true,
                showDenyButton: true,
                confirmButtonText: 'Confirmer',
                denyButtonText: 'Refuser',
                cancelButtonText: 'Fermer',
                confirmButtonColor: '#223f91',
                denyButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                preConfirm: () => {
                    const qty = parseInt(document.getElementById('hold-ticket-qty').value, 10);

                    if (!qty || qty < 1 || qty > maxTickets) {
                        Swal.showValidationMessage('Choisissez une quantité valide.');
                        return false;
                    }

                    return qty;
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    const qty = result.value;
                    window.location.href = '/waitlist/confirm/' + activiteId + '?qty=' + qty;
                } else if (result.isDenied) {
                    window.location.href = '/waitlist/refuse/' + activiteId;
                }
            });
        });
    });
});
</script>
