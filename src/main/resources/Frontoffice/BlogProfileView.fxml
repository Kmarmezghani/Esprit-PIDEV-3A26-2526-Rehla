<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.image.Image?>
<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="Controllers.BlogProfileController" fx:id="stackRoot" stylesheets="@css/reviews.css,@/Frontoffice/css/profile-menu.css,@/Frontoffice/css/home.css,@/Frontoffice/css/blog_styles.css">

    <BorderPane fx:id="root" styleClass="root">

    <!-- ====== BARRE HAUTE (HEADER) ====== -->
        <top>
            <HBox alignment="CENTER_LEFT"
                  prefHeight="70.0"
                  minHeight="70.0"
                  maxHeight="70.0"
                  styleClass="topBlueBar"
                  BorderPane.alignment="CENTER">

                <children>
                    <ImageView fitHeight="44.0" preserveRatio="true" pickOnBounds="true" styleClass="brandLogo">
                        <image>
                            <Image url="@../Backoffice/icons/IMG_20260125_122708_191-removebg-preview.png"/>
                        </image>
                    </ImageView>

                    <Region HBox.hgrow="ALWAYS"/>

                    <HBox alignment="CENTER" spacing="22.0">
                        <Button onAction="#goToHome" text="Home" styleClass="navBtnBlue"/>
                        <Button onAction="#goToDestinations" text="Destinations" styleClass="navBtnBlue"/>
                        <Button onAction="#goToPosts" text="Posts" styleClass="navBtnBlue"/>
                        <Button onAction="#goToactivities" text="Activities" styleClass="navBtnBlue"/>
                        <Button text="About" styleClass="navBtnBlue"/>
                    </HBox>

                    <Region HBox.hgrow="ALWAYS"/>

                        <Button fx:id="btnMessage" text="💬" styleClass="iconBtn"/>

                    <StackPane alignment="TOP_RIGHT" maxHeight="-Infinity">
                        <HBox.margin>
                            <Insets right="10.0" />
                        </HBox.margin>

                        <Button fx:id="btnNotif" onAction="#openNotifications" styleClass="iconBtn" text="🔔" />

                        <Label fx:id="lblNotifCount" managed="false" style="-fx-background-color: #ef4444;                   -fx-text-fill: white;                   -fx-font-weight: 900;                   -fx-font-size: 11px;                   -fx-padding: 2 6;                   -fx-background-radius: 999;                   -fx-min-width: 18px;                   -fx-alignment: center;" text="0" translateX="8" translateY="-6" visible="false" StackPane.alignment="TOP_RIGHT" />
                    </StackPane>

                    <Button fx:id="btnProfile" onAction="#openProfileMenu" styleClass="iconBtn" text="👤">
                        <HBox.margin><Insets right="14.0"/></HBox.margin>
                        <contextMenu>
                            <ContextMenu fx:id="profileMenu" styleClass="profileMenu">
                                <items>

                                    <MenuItem onAction="#goToMyProfile" text="My Profile">
                                        <graphic>
                                            <SVGPath styleClass="menuIcon"
                                                     content="M12 12c2.21 0 4-1.79 4-4S14.21 4 12 4 8 5.79 8 8s1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                                        </graphic>
                                    </MenuItem>

                                    <MenuItem onAction="#goToMyPosts" text="My Posts">
                                        <graphic>
                                            <SVGPath styleClass="menuIcon"
                                                     content="M9 6l1.5-2h3L15 6h3a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h3zm3 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zm0-2.2a1.8 1.8 0 1 1 0-3.6 1.8 1.8 0 0 1 0 3.6z"/>
                                        </graphic>
                                    </MenuItem>

                                    <MenuItem onAction="#goToMyReservations" text="My Reservations">
                                        <graphic>
                                            <SVGPath styleClass="menuIcon"
                                                     content="M7 2v2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-2V2h-2v2H9V2H7zm12 6H5V6h14v2zM7 12h3v3H7v-3zm4 0h3v3h-3v-3zm4 0h3v3h-3v-3z"/>
                                        </graphic>
                                    </MenuItem>

                                    <MenuItem fx:id="menuMyActivities"
                                              onAction="#goToMyActivities"
                                              text="My Activities">
                                        <graphic>
                                            <SVGPath styleClass="menuIcon"
                                                     content="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm0 2a8 8 0 1 1 0 16 8 8 0 0 1 0-16zm3.2 4.8l-1.9 5-5 1.9 1.9-5 5-1.9z"/>
                                        </graphic>
                                    </MenuItem>

                                    <SeparatorMenuItem/>

                                    <MenuItem onAction="#handleLogout" text="Logout">
                                        <graphic>
                                            <SVGPath styleClass="menuIconLogout"
                                                     content="M10 17l1.41-1.41L9.83 14H20v-2H9.83l1.58-1.59L10 9l-5 5 5 5zM4 21h2V3H4v18z"/>
                                        </graphic>
                                    </MenuItem>

                                </items>
                            </ContextMenu>
                        </contextMenu>
                    </Button>

                    <HBox styleClass="winBox" alignment="CENTER_RIGHT" spacing="0">
                        <Button onAction="#minwindow" styleClass="winCtrlBtn" focusTraversable="false">
                            <graphic>
                                <SVGPath content="M2 8 H12"
                                         stroke="white"
                                         strokeWidth="1.8"
                                         strokeLineCap="round"/>
                            </graphic>
                        </Button>

                        <Button onAction="#maxwindow" styleClass="winCtrlBtn" focusTraversable="false">
                            <graphic>
                                <SVGPath content="M3 3 H11 V11 H3 Z"
                                         fill="transparent"
                                         stroke="white"
                                         strokeWidth="1.6"
                                         strokeLineJoin="round"/>
                            </graphic>
                        </Button>

                        <Button focusTraversable="false" onAction="#closewindow" styleClass="winCtrlClose" text="">
                            <graphic>
                                <SVGPath content="M4 4 L12 12 M12 4 L4 12"
                                         fill="transparent"
                                         stroke="white"
                                         strokeLineCap="round"
                                         strokeWidth="1.8"/>
                            </graphic>
                        </Button>
                    </HBox>

                </children>

                <padding>
                    <Insets left="30.0" right="30.0"/>
                </padding>
            </HBox>
        </top>

        <!-- ====== CONTENU PRINCIPAL ====== -->
    <center>
        <BorderPane>

            <!-- ====== COUVERTURE + INFOS PROFIL ====== -->
            <top>
                <VBox spacing="10">


                    <!-- Bloc profil -->
                    <HBox spacing="20" style="-fx-padding: 0 28 15 28;">
                        <!-- Avatar + boutons principaux -->
                        <VBox spacing="10">
                            <StackPane>
                                <ImageView fx:id="profileAvatar"
                                           fitWidth="120" fitHeight="120"
                                           style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.6), 12,0,0,3);
                                                   -fx-border-color: white; -fx-border-width: 3;
                                                   -fx-border-radius: 60; -fx-background-radius: 60;"/>
                                <Circle radius="60"
                                        style="-fx-fill: transparent; -fx-stroke: rgba(255,255,255,0.8);
                                               -fx-stroke-width: 3;"/>
                            </StackPane>

                            <HBox spacing="8">
                                <Button fx:id="followButton" text="S'abonner"
                                        style="-fx-background-color: #0e8bdc; -fx-text-fill: white;
                                               -fx-font-weight: bold; -fx-background-radius: 20;
                                               -fx-padding: 6 18; -fx-cursor: hand;"/>
                                <Button text="Message"
                                        style="-fx-background-color: #EEEEEE; -fx-text-fill: #424242;
                                               -fx-background-radius: 20; -fx-padding: 6 18;
                                               -fx-cursor: hand;"/>
                            </HBox>
                        </VBox>

                        <!-- Infos principales -->
                        <VBox spacing="8" VBox.vgrow="NEVER">
                            <Label fx:id="profileName"
                                   style="-fx-font-size:80px;
                  -fx-font-weight: bold;
                  -fx-text-fill: #ffffff;
                  -fx-letter-spacing: 1.5px;"/>

                            <Label fx:id="profileHeadline"
                                   style="-fx-text-fill: #eeeeee;
                  -fx-font-size: 20px;"/>

                            <!-- Stats -->
                            <HBox spacing="30" style="-fx-padding: 8 0 0 0;">
                                <VBox alignment="CENTER">
                                    <Label text="Articles"
                                           style="-fx-text-fill: #757575; -fx-font-size: 11px;"/>
                                    <Label fx:id="postsCountLabel"
                                           text="18"
                                           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                                </VBox>
                                <VBox alignment="CENTER">
                                    <Label text="Abonnés"
                                           style="-fx-text-fill: #757575; -fx-font-size: 11px;"/>
                                    <Label fx:id="followersCountLabel"
                                           text="1.2K"
                                           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                                </VBox>
                                <VBox alignment="CENTER">
                                    <Label text="Favoris"
                                           style="-fx-text-fill: #757575; -fx-font-size: 11px;"/>
                                    <Label fx:id="favoritesCountLabel"
                                           text="87"
                                           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <!-- Boutons actions rapides -->
                        <VBox spacing="8" alignment="CENTER_RIGHT">
                            <Button text="✏ Modifier le profil"
                                    style="-fx-background-radius: 20; -fx-background-color: #E3F2FD;
                                           -fx-text-fill: #1E88E5; -fx-font-weight: bold;
                                           -fx-padding: 6 18; -fx-cursor: hand;" onAction="#goToMyProfileUpdate"/>
                            <Button text="⚙ Paramètres"
                                    style="-fx-background-radius: 20; -fx-background-color: #F5F5F5;
                                           -fx-text-fill: #424242; -fx-padding: 4 10; -fx-cursor: hand;"/>
                        </VBox>
                    </HBox>

                    <!-- Barre d’onglets -->
                    <HBox spacing="0" style="-fx-padding: 0 28 0 28;
                                              -fx-border-color: #E0E0E0 transparent #E0E0E0 transparent;
                                              -fx-border-width: 1 0 1 0;">
                        <ToggleButton fx:id="tabPosts" text="Articles"
                                      selected="true"
                                      style="-fx-background-color: transparent;
                                             -fx-text-fill: #1E88E5; -fx-font-size: 13px;
                                             -fx-font-weight: bold; -fx-padding: 10 25;
                                             -fx-border-color: transparent transparent #1E88E5 transparent;
                                             -fx-border-width: 0 0 3 0;"/>
                        <ToggleButton fx:id="tabFavorites" text="Favoris"

                                      style="-fx-background-color: transparent;
                                             -fx-text-fill: #616161; -fx-font-size: 13px;
                                             -fx-padding: 10 25; -fx-border-width: 0;"/>
                        <ToggleButton fx:id="tabAbout" text="À propos"
                                      style="-fx-background-color: transparent;
                                             -fx-text-fill: #616161; -fx-font-size: 13px;
                                             -fx-padding: 10 25; -fx-border-width: 0;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="➕ Nouveau blog"
                                style="-fx-background-radius: 20; -fx-background-color: #1E88E5;
                                       -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 6 18;
                                       -fx-cursor: hand;"/>
                    </HBox>
                </VBox>
            </top>

            <!-- ====== CENTRE : COLONNE GAUCHE (INFO) + COLONNE DROITE (POSTS) ====== -->
            <center>
                <HBox spacing="16" style="-fx-padding: 16 28 20 28;
                                          -fx-background-color: linear-gradient(to bottom,#FAFAFA,#E3F2FD);">

                    <!-- ====== COLONNE GAUCHE : INFOS + TAGS ====== -->
                    <VBox spacing="12" prefWidth="260">

                        <!-- Carte tags / catégories -->
                        <VBox spacing="8"
                              style="-fx-background-color: white; -fx-background-radius: 10;
                                     -fx-padding: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.10), 10,0,0,2);">
                            <Label text="Centres d'intérêt"
                                   style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                            <FlowPane hgap="6" vgap="6">
                                <Label text="#voyages"
                                       style="-fx-background-color: #E3F2FD; -fx-background-radius: 12;
                                              -fx-padding: 3 10; -fx-text-fill: #1E88E5; -fx-font-size: 11px;"/>
                                <Label text="#Reservation"
                                       style="-fx-background-color: #FFF3E0; -fx-background-radius: 12;
                                              -fx-padding: 3 10; -fx-text-fill: #FB8C00; -fx-font-size: 11px;"/>
                                <Label text="#Activities"
                                       style="-fx-background-color: #F3E5F5; -fx-background-radius: 12;
                                              -fx-padding: 3 10; -fx-text-fill: #8E24AA; -fx-font-size: 11px;"/>
                                <Label text="#YourDreamDestination"
                                       style="-fx-background-color: #E8F5E9; -fx-background-radius: 12;
                                              -fx-padding: 3 10; -fx-text-fill: #43A047; -fx-font-size: 11px;"/>
                                <Label text="#HoneyMoon"
                                       style="-fx-background-color: #FFEBEE; -fx-background-radius: 12;
                                              -fx-padding: 3 10; -fx-text-fill: #E53935; -fx-font-size: 11px;"/>
                            </FlowPane>
                        </VBox>

                        <!-- Carte blogs suivis -->
                        <VBox spacing="8"
                              style="-fx-background-color: white; -fx-background-radius: 10;
                                     -fx-padding: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.10), 10,0,0,2);">
                            <Label text="Blogs que vous suivez"
                                   style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                            <VBox spacing="6">
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <Circle radius="12" style="-fx-fill: #1E88E5;"/>
                                    <Label text="Tech Horizon" style="-fx-font-size: 12px;"/>
                                </HBox>
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <Circle radius="12" style="-fx-fill: #8E24AA;"/>
                                    <Label text="Deep Learning Café" style="-fx-font-size: 12px;"/>
                                </HBox>
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <Circle radius="12" style="-fx-fill: #FB8C00;"/>
                                    <Label text="Cloud Stories" style="-fx-font-size: 12px;"/>
                                </HBox>
                            </VBox>
                        </VBox>
                    </VBox>

                    <!-- ====== COLONNE DROITE : CRÉER + FEED ====== -->
                    <VBox spacing="12" HBox.hgrow="ALWAYS" fx:id="contentArea">

                        <!-- Carte créer un nouvel article -->
                        <VBox spacing="8" fx:id="newPostBox"
                              style="-fx-background-color: white; -fx-background-radius: 10;
                                     -fx-padding: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.14), 12,0,0,2);">
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <ImageView fx:id="composerAvatar" fitWidth="36" fitHeight="36"
                                           style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 8,0,0,1);
                                                   -fx-border-radius: 18; -fx-background-radius: 18;"/>
                                <TextField fx:id="newPostTitleField"
                                           promptText="Titre de votre nouvel article..."
                                           style="-fx-background-radius: 18;
                                                  -fx-background-color: #F5F5F5;
                                                  -fx-padding: 6 10;"/>
                            </HBox>
                            <TextArea fx:id="newPostContentArea"
                                      promptText="Partagez vos idées, tutoriels, expériences..."
                                      prefRowCount="3"
                                      wrapText="true"
                                      style="-fx-background-radius: 10;
                                             -fx-background-color: #FAFAFA;
                                             -fx-padding: 6 8;"/>
                            <HBox spacing="8" alignment="CENTER_RIGHT">
                                <Button fx:id="imageButton"
                                        text="📷 Image"
                                        onAction="#handleChooseImage"
                                        style="-fx-background-color: transparent;
               -fx-text-fill: #757575;"/>

                                <Button text="🏷 Tags" style="-fx-background-color: transparent;
                                                              -fx-text-fill: #757575;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button  fx:id="publishButton" text="Publier"
                                        style="-fx-background-radius: 20; -fx-background-color: #43A047;
                                               -fx-text-fill: white; -fx-font-weight: bold;
                                               -fx-padding: 6 18; -fx-cursor: hand;" />
                            </HBox>
                        </VBox>

                        <!-- ====== LISTE DES POSTS ====== -->
                        <ScrollPane fitToWidth="true" prefViewportHeight="400"
                                    style="-fx-background-color: transparent; -fx-padding: 0;">
                            <VBox fx:id="postsContainer" spacing="12"
                                  style="-fx-padding: 10 0 10 0;"/>
                        </ScrollPane>
                    </VBox>
                </HBox>
            </center>
        </BorderPane>
    </center>
</BorderPane>
</StackPane>