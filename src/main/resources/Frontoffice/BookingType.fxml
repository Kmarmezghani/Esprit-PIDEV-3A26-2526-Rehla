<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700" prefWidth="1000" style="-fx-background-color: linear-gradient(to bottom, #3A5BC7, #223f91);" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.BookingTypeController">

    <children>

        <VBox alignment="CENTER" spacing="40" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

            <!-- TITLE -->
            <Label text="Choose What You Want To Book" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="34" />
                </font>
            </Label>

            <!-- SUBTITLE -->
            <Label text="Select a category to continue" textFill="#E0E0E0">
                <font>
                    <Font size="16" />
                </font>
            </Label>

            <!-- BUTTON CONTAINER -->
            <HBox alignment="CENTER" spacing="30">

                <!-- FLIGHTS -->
                <Button onAction="#goToFlights" prefHeight="120" prefWidth="160" style="-fx-background-color: white;                                -fx-font-size: 16;                                -fx-font-weight: bold;                                -fx-background-radius: 15;                                -fx-cursor: hand;" text="✈ Flights" />

                <!-- HOTELS -->
                <Button onAction="#goToHotels" prefHeight="120" prefWidth="160" style="-fx-background-color: white;                                -fx-font-size: 16;                                -fx-font-weight: bold;                                -fx-background-radius: 15;                                -fx-cursor: hand;" text="🏨 Hotels" />

                <!-- TRANSPORT -->
                <Button onAction="#goToTransport" prefHeight="120" prefWidth="160" style="-fx-background-color: white;                                -fx-font-size: 16;                                -fx-font-weight: bold;                                -fx-background-radius: 15;                                -fx-cursor: hand;" text="🚗 Transport" />

            </HBox>

        </VBox>
        <Button text="← Back"
                onAction="#handleBack"
                style="-fx-background-color: #3A5BC7;
               -fx-text-fill: white;
               -fx-background-radius: 8;
               -fx-font-weight: bold;" />

    </children>

</AnchorPane>
