{% extends 'adminbase.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block sidebar %}
  {% include 'admin/partials/sidebar.html.twig' %}
{% endblock %}

{% block navbar %}
  {% include 'admin/partials/navbar.html.twig' %}
{% endblock %}

{% block body %}
<div class="row g-6">
  <div class="col-12">
    <div class="nav-align-top">
      <ul class="nav nav-pills mb-4 nav-fill" role="tablist">
        <!-- ACTIVITE TAB -->
        <li class="nav-item mb-1 mb-sm-0">
          <button type="button"
                  class="nav-link active"
                  role="tab"
                  data-bs-toggle="tab"
                  data-bs-target="#navs-pills-activite"
                  aria-controls="navs-pills-activite"
                  aria-selected="true">
            <span class="d-none d-sm-inline-flex align-items-center">
              <i class="icon-base bx bx-compass icon-sm me-1_5"></i>Activite
            </span>
            <i class="icon-base bx bx-compass icon-sm d-sm-none"></i>
          </button>
        </li>

        <!-- Avis TAB -->
        <li class="nav-item mb-1 mb-sm-0">
          <button type="button"
                  class="nav-link"
                  role="tab"
                  data-bs-toggle="tab"
                  data-bs-target="#navs-pills-avis"
                  aria-controls="navs-pills-avis"
                  aria-selected="false">
            <span class="d-none d-sm-inline-flex align-items-center">
              <i class="icon-base bx bx-user icon-sm me-1_5"></i>Avis
            </span>
            <i class="icon-base bx bx-user icon-sm d-sm-none"></i>
          </button>
        </li>
      </ul>

      <div class="tab-content">
        <!-- ACTIVITE TAB CONTENT -->
        <div class="tab-pane fade show active" id="navs-pills-activite" role="tabpanel">
          <div class="card">
            <div class="d-flex align-items-center mb-3">
              <h5 class="card-header mb-0">Liste des Activités</h5>
              <a href="{{ path('activite_new') }}" class="btn rounded-pill" style="background-color: #223f91; color: #fff; margin-left: auto; margin-right: 10px;">
                  &#43; Ajouter
              </a>
          </div>

            <div class="table-responsive text-nowrap">
              <table class="table table-striped table-hover">
                <thead>
                  <tr>
                     <th>Image</th>
                    <th>Nom</th>
                    <th>Description</th>
                    <th>Prix</th>
                    <th>Type</th>
                    <th>Note Moyenne</th>
                    <th>Guide</th>
                    <th>Date Début</th>
                    <th>Date Fin</th>
                    <th>Status</th>
                    <th>Destination</th>
                    <th>Max Places</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  {% for activite in activites %}
                    <tr>
                      <td>
                        {% if activite.image %}
                          <img src="{{ asset('uploads/activities/' ~ activite.image|split('\\')|last) }}"
                               alt="Image" width="50">
                        {% endif %}
                      </td>
                      <td>{{ activite.nom }}</td>
                      <td style="max-width: 200px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                        {{ activite.description }}
                      </td>
                      <td>{{ activite.prix|number_format(2, '.', ',') }}</td>
                      <td>{{ activite.typeActivite }}</td>
                      <td>{{ activite.noteMoyenne|default(0)|number_format(1, '.', ',') }}</td>
                      <td>{{ activite.guide ? activite.guide.nom : 'N/A' }}</td>
                      <td>{{ activite.dateDebut ? activite.dateDebut|date('d-m-Y H:i') : '' }}</td>
                      <td>{{ activite.dateFin ? activite.dateFin|date('d-m-Y H:i') : '' }}</td>
                      <td>
                        {% set status = activite.status|default('DISPONIBLE') %}

                        {% if status == 'DISPONIBLE' %}
                          <span class="badge bg-label-success me-1">Disponible</span>

                        {% elseif status == 'INDISPONIBLE' %}
                          <span class="badge bg-label-danger me-1">Indisponible</span>

                        {% else %}
                          <span class="badge bg-label-info me-1">{{ status }}</span>
                        {% endif %}
                      </td>
                      <td>{{ activite.destination ? activite.destination.nom : 'N/A' }}</td>
                      <td>{{ activite.maxPlaces|default(0) }}</td>
                      
                      <td>
                      <div class="dropdown">
                          <button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown">
                              <i class="icon-base bx bx-dots-vertical-rounded"></i>
                          </button>
                          <div class="dropdown-menu">
                              <a class="dropdown-item" href="{{ path('activite_edit', {'id': activite.id}) }}">
                                  <i class="icon-base bx bx-edit-alt me-2"></i> Modifier
                              </a>

                              <button class="dropdown-item text-danger" data-bs-toggle="modal" data-bs-target="#deleteModal{{ activite.id }}">
                                  <i class="icon-base bx bx-trash me-2"></i> Supprimer
                              </button>
                          </div>
                      </div>
                    </td>
                    </tr>
                  {% else %}
                    <tr>
                      <td colspan="13" class="text-center">Aucune activité trouvée</td>
                    </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- Avis TAB CONTENT -->
        <div class="tab-pane fade" id="navs-pills-avis" role="tabpanel">
          <p>Avis content here...</p>
        </div>
      </div>
    </div>
  </div>
</div>
{% for activite in activites %}
<div class="modal fade" id="deleteModal{{ activite.id }}" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-danger">
                    <i class="bx bx-error-circle me-1"></i> Suppression de l'activité
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <i class="bx bx-trash display-6 text-danger mb-3"></i>
                <h5>Voulez-vous vraiment supprimer cette activité ?</h5>
                <p class="text-muted mb-0">
                    Cette action est <strong>irréversible</strong>.
                </p>
            </div>
            <div class="modal-footer justify-content-center">
                <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
                <form method="post" action="{{ path('activite_delete', {'id': activite.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ activite.id) }}">
                    <button class="btn btn-danger">
                        <i class="bx bx-trash me-1"></i> Oui, supprimer
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endfor %}
{% endblock %}

{% block page_scripts %}
  <script src="{{ asset('assetsback/js/dashboards-analytics.js') }}"></script>
{% endblock %}