<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="Controllers.FaceEnrollmentController"
           prefWidth="900" prefHeight="700"
           style="-fx-background-color: linear-gradient(to bottom right, #1a1a2e, #16213e, #0f3460);">

    <!-- Main Content Card -->
    <VBox alignment="CENTER" spacing="18" maxWidth="520"
          style="-fx-background-color: rgba(255,255,255,0.95); -fx-background-radius: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 25, 0, 0, 10);">
        <padding>
            <Insets top="35" right="45" bottom="35" left="45"/>
        </padding>

        <!-- Header -->
        <Label text="🔐" style="-fx-font-size: 45;"/>
        <Label text="Face Enrollment" style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
        <Label fx:id="userEmailLabel" text="user@email.com"
               style="-fx-font-size: 13; -fx-text-fill: #666666;"/>
        
        <!-- Instructions -->
        <VBox alignment="CENTER" spacing="5" style="-fx-background-color: #e8f4fd; -fx-background-radius: 10; -fx-padding: 12;">
            <Label text="📋 Instructions:" style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
            <Label text="• Position your face within the oval guide" style="-fx-font-size: 11; -fx-text-fill: #555;"/>
            <Label text="• Ensure good lighting on your face" style="-fx-font-size: 11; -fx-text-fill: #555;"/>
            <Label text="• Remove glasses if possible" style="-fx-font-size: 11; -fx-text-fill: #555;"/>
            <Label text="• Look directly at the camera" style="-fx-font-size: 11; -fx-text-fill: #555;"/>
        </VBox>

        <!-- Webcam View Container -->
        <StackPane fx:id="webcamContainer" prefWidth="320" prefHeight="240"
                   style="-fx-background-color: #1a1a2e; -fx-background-radius: 15;">
            
            <!-- Webcam Feed -->
            <ImageView fx:id="webcamView" fitWidth="320" fitHeight="240" preserveRatio="true">
                <clip>
                    <Rectangle width="320" height="240" arcWidth="30" arcHeight="30"/>
                </clip>
            </ImageView>

            <!-- Face Overlay Guide -->
            <Rectangle fx:id="faceGuide" width="180" height="220" 
                       fill="transparent" stroke="#4facfe" strokeWidth="3"
                       arcWidth="90" arcHeight="90" strokeDashArray="15, 10"/>
            
            <!-- Loading Indicator -->
            <ProgressIndicator fx:id="loadingIndicator" visible="false" 
                               maxWidth="60" maxHeight="60"/>
            
            <!-- No Camera Message -->
            <VBox fx:id="noCameraBox" alignment="CENTER" spacing="10" visible="false">
                <Label text="📷" style="-fx-font-size: 40;"/>
                <Label text="No camera detected" style="-fx-text-fill: white; -fx-font-size: 14;"/>
            </VBox>
        </StackPane>

        <!-- Status Label -->
        <Label fx:id="statusLabel" text="Ready to capture" 
               style="-fx-font-size: 14; -fx-text-fill: #666666; -fx-font-weight: bold;"/>

        <!-- Error/Success Label -->
        <Label fx:id="messageLabel" text="" wrapText="true" maxWidth="380"
               style="-fx-font-size: 13; -fx-font-weight: bold;"/>

        <!-- Enrollment Status -->
        <HBox fx:id="enrollmentStatus" alignment="CENTER" spacing="8" visible="false"
              style="-fx-background-color: #d4edda; -fx-background-radius: 8; -fx-padding: 8;">
            <Label text="✓" style="-fx-font-size: 16; -fx-text-fill: #155724;"/>
            <Label fx:id="enrollmentStatusLabel" text="Face already enrolled" 
                   style="-fx-font-size: 12; -fx-text-fill: #155724;"/>
        </HBox>

        <!-- Action Buttons -->
        <HBox alignment="CENTER" spacing="15">
            <Button fx:id="captureButton" text="📸 Capture Face" onAction="#handleCapture"
                    prefWidth="150" prefHeight="42"
                    style="-fx-background-color: linear-gradient(to right, #4facfe, #00f2fe); -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold; -fx-background-radius: 22; -fx-cursor: hand;"/>
            
            <Button fx:id="enrollButton" text="✓ Enroll Face" onAction="#handleEnroll" visible="false"
                    prefWidth="140" prefHeight="42"
                    style="-fx-background-color: linear-gradient(to right, #11998e, #38ef7d); -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold; -fx-background-radius: 22; -fx-cursor: hand;"/>
            
            <Button fx:id="retakeButton" text="🔄 Retake" onAction="#handleRetake" visible="false"
                    prefWidth="100" prefHeight="42"
                    style="-fx-background-color: linear-gradient(to right, #f093fb, #f5576c); -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold; -fx-background-radius: 22; -fx-cursor: hand;"/>
        </HBox>

        <!-- Remove Enrollment Button -->
        <Button fx:id="removeButton" text="🗑️ Remove Face Enrollment" onAction="#handleRemove" visible="false"
                style="-fx-background-color: transparent; -fx-text-fill: #e74c3c; -fx-font-size: 12; -fx-cursor: hand;"/>

        <!-- Separator -->
        <HBox alignment="CENTER" spacing="15">
            <Rectangle width="120" height="1" fill="#dddddd"/>
        </HBox>

        <!-- Back Button -->
        <Button text="← Back to Profile" onAction="#goBack"
                style="-fx-background-color: transparent; -fx-text-fill: #4facfe; -fx-font-size: 13; -fx-cursor: hand; -fx-underline: true;"/>

    </VBox>


</StackPane>
