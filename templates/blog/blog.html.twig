const openBtns = document.querySelectorAll(".open-comment");
const popup = document.getElementById("commentPopup");
const overlay = document.getElementById("commentOverlay");
const closeBtn = document.getElementById("closePopup");
const form = document.getElementById("commentForm");
const postIdInput = document.getElementById("comment_post_id");

openBtns.forEach(btn => {
  btn.addEventListener("click", () => {

    const postId = btn.getAttribute("data-id");

    // 🔥 afficher bon bloc commentaires
    document.querySelectorAll(".comments-container").forEach(div => {
      div.style.display = "none";
    });

    const target = document.querySelector(`.comments-container[data-post="${postId}"]`);
    if (target) target.style.display = "block";

    // 🔥 préparer form
    postIdInput.value = postId;
    form.action = "/comment/add/" + postId;

    // 🔥 ouvrir popup
    popup.classList.add("active");
    overlay.classList.add("active");
  });
});

function closePopup() {
  popup.classList.remove("active");
  overlay.classList.remove("active");
}

if (closeBtn) {
  closeBtn.addEventListener("click", closePopup);
}

overlay.addEventListener("click", closePopup);


{# ----------------------------------------- pop up alerte add comment ------------------------------------------ #}
document.addEventListener("DOMContentLoaded", function () {

    const commentForm = document.getElementById("commentForm");
    const commentInput = document.getElementById("comment_input");
    if (!commentForm || !commentInput) return;
      if (commentForm.dataset.listener === "true") return;
    commentForm.dataset.listener = "true";

    commentForm.addEventListener("submit", async function (e) {
      
        e.preventDefault(); 
        const value = (commentInput.value || "").trim();

        // ❌ champ vide
        if (value === "") {
            e.preventDefault();

            Swal.fire({
                icon: 'error',
                text: 'Le commentaire est obligatoire',
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 2500,
                background: '#fff1f2',
                color: '#991b1b',
                iconColor: '#ef4444',
                customClass: {
                    popup: 'red-toast'
                }
            });

            return;
        }

        // ⚠️ trop court
        if (value.length < 3) {
            e.preventDefault();

            Swal.fire({
                icon: 'warning',
                text: 'Minimum 3 caractères',
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 2500,
                background: '#fff7ed',
                color: '#9a3412',
                iconColor: '#f59e0b',
                customClass: {
                    popup: 'orange-toast'
                }
            });

            return;
        }
        if (!/^[a-zA-Z0-9]/.test(value)) {
        e.preventDefault();
        Swal.fire({
            icon: 'error',
            text: 'Le contenu doit commencer par une lettre ou un chiffre',
            toast: true,
            position: 'top-end',
            showConfirmButton: false,
            timer: 2500,
            background: '#fff1f2',
            color: '#991b1b',
            iconColor: '#ef4444',
            customClass: {
                    popup: 'red-toast'
                }
          });
          return;
          }

     
       try {
            const response = await fetch("/check-toxicity", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({ text: value })
            });

            const data = await response.json();
            const score = data.score;

            // ❌ REFUS
            if (score > 0.7) {
                Swal.fire({
                    icon: 'error',
                    text: 'Contenu refusé, ne respecte pas nos règles',
                    toast: true,
                    position: 'top-end',
                    showConfirmButton: false,
                    timer: 2500,
                    background: '#fff1f2',
                    color: '#991b1b',
                    iconColor: '#ef4444',
                    customClass: { popup: 'red-toast' }
                });
                return;
            }

            // ⚠️ WARNING
            if (score > 0.1) {
                Swal.fire({
                     icon: 'warning',
                    text: 'Contenu sensible publié, admin notifié',
                    toast: true,
                    position: 'top-end',
                    showConfirmButton: false,
                    timer: 2500,
                    background: '#fff7ed',
                    color: '#9a3412',
                    iconColor: '#f59e0b',
                    customClass: { popup: 'orange-toast' }
                });

                setTimeout(() => commentForm.submit(), 500);
                return;
            }

            // ✅ OK
            Swal.fire({
                icon: 'success',
                text: 'Commentaire ajoutée avec succès',
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 2500,
                background: '#ecfdf5',
                color: '#065f46',
                iconColor: '#10b981',
                customClass: { popup: 'green-toast' }
            });

            setTimeout(() => commentForm.submit(), 500);

        } catch (error) {
            console.error(error);

            Swal.fire({
                 icon: 'error',
                text: 'Erreur serveur IA, réessayez',
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 2500,
                background: '#fff1f2',
                color: '#991b1b',
                iconColor: '#ef4444',
                customClass: { popup: 'red-toast' }
            });
        }
    });

});





