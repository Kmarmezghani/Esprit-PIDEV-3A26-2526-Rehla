{% extends 'adminbase.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block sidebar %}
  {% include 'admin/partials/sidebar.html.twig' %}
{% endblock %}

{% block navbar %}
  {% include 'admin/partials/navbar.html.twig' %}
{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="card">
        <div class="card-header text-center">
            <h4>Modifier une activité</h4>
        </div>
        <div class="card-body">
            {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}

            
            <div class="text-center mb-4">
                <div id="imagePreview">
                    {% if activite is defined and activite.image %}
                        <img src="{{ asset('uploads/activities/' ~ activite.image|replace({'\\':'/'})|split('/')|last) }}"
                             alt="Aperçu image"
                             style="max-width: 400px; max-height: 300px; border-radius: 8px;">
                    {% endif %}
                </div>
            </div>

            <div class="mb-3">
                {{ form_label(form.image) }}
                {{ form_widget(form.image, {'attr': {'class': 'form-control', 'onchange':'previewImage(event)'}}) }}
                {% for error in form.image.vars.errors %}
                    <div class="alert alert-warning mt-1">{{ error.message }}</div>
                {% endfor %}
            </div>

            
            <div class="mb-3">
                {{ form_label(form.nom) }}
                {{ form_widget(form.nom, {'attr': {'class': 'form-control'}}) }}
                {% for error in form.nom.vars.errors %}
                    <div class="alert alert-warning mt-1">{{ error.message }}</div>
                {% endfor %}
            </div>

            <div class="mb-3">
                {{ form_label(form.description) }}
                {{ form_widget(form.description, {'attr': {'class': 'form-control'}}) }}
                {% for error in form.description.vars.errors %}
                    <div class="alert alert-warning mt-1">{{ error.message }}</div>
                {% endfor %}
            </div>

            
            <div class="row mb-3">
                <div class="col-md-6">
                    {{ form_label(form.prix) }}
                    {{ form_widget(form.prix, {'attr': {'class': 'form-control'}}) }}
                    {% for error in form.prix.vars.errors %}
                        <div class="alert alert-warning mt-1">{{ error.message }}</div>
                    {% endfor %}
                </div>
                <div class="col-md-6">
                    {{ form_label(form.typeActivite) }}
                    {{ form_widget(form.typeActivite, {'attr': {'class': 'form-control'}}) }}
                    {% for error in form.typeActivite.vars.errors %}
                        <div class="alert alert-warning mt-1">{{ error.message }}</div>
                    {% endfor %}
                </div>
            </div>

            
            <div class="row mb-3">
                <div class="col-md-6">
                    {{ form_label(form.date_debut) }}
                    {{ form_widget(form.date_debut, {'attr': {'class': 'form-control'}}) }}
                    {% for error in form.date_debut.vars.errors %}
                        <div class="alert alert-warning mt-1">{{ error.message }}</div>
                    {% endfor %}
                </div>
                <div class="col-md-6">
                    {{ form_label(form.date_fin) }}
                    {{ form_widget(form.date_fin, {'attr': {'class': 'form-control'}}) }}
                    {% for error in form.date_fin.vars.errors %}
                        <div class="alert alert-warning mt-1">{{ error.message }}</div>
                    {% endfor %}
                </div>
            </div>

          
            <div class="mb-3">
                {{ form_label(form.destination) }}
                {{ form_widget(form.destination, {'attr': {'class': 'form-control'}}) }}
                {% for error in form.destination.vars.errors %}
                    <div class="alert alert-warning mt-1">{{ error.message }}</div>
                {% endfor %}
            </div>

            
            {% if form.status is defined %}
            <div class="mb-3">
                {{ form_label(form.status) }}
                {{ form_widget(form.status, {'attr': {'class': 'form-control'}}) }}
                {% for error in form.status.vars.errors %}
                    <div class="alert alert-warning mt-1">{{ error.message }}</div>
                {% endfor %}
            </div>
            {% endif %}

            
            <div class="text-center">
                <button type="submit" class="btn"
                        style="background-color: #223f91; color: #fff; border-radius: 25px; padding: 10px 30px;">
                    {{ activite is defined ? 'Modifier' : 'Ajouter' }}
                </button>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}

{% block page_scripts %}
<script src="{{ asset('assetsback/js/dashboards-analytics.js') }}"></script>

<script>
function previewImage(event) {
    const preview = document.getElementById('imagePreview');
    preview.innerHTML = ''; // clear old image
    const file = event.target.files[0];
    if (file) {
        const img = document.createElement('img');
        img.src = URL.createObjectURL(file);
        img.style.maxWidth = '400px';
        img.style.maxHeight = '300px';
        img.style.borderRadius = '8px';
        preview.appendChild(img);
    }
}
</script>
{% endblock %}