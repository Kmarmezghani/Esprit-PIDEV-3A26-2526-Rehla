                        <div style="display: flex; align-items: center; gap: 5px;">
                            <img src="{{ asset('assets/icons/star.svg') }}" style="width: 20px; height: 20px;">
                            {{ activite.noteMoyenne|round(1) }}
                        </div>
                    </li>

                    <li style="margin-top: 10px;">
                        <span class="flaticon-sun-umbrella"></span>
                        {{ activite.typeActivite ?: 'Non défini' }}
