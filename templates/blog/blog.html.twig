document.addEventListener("DOMContentLoaded", function () {

    const openGallery = document.getElementById("openGallery");
    const fileInput = document.getElementById("imageInput1");
    const sendBtn = document.querySelector(".fa-paper-plane");
    const input = document.getElementById("chatInput");

    if (!input || !sendBtn) {
        console.error("Chat UI missing elements");
        return;
    }

    // 📁 open gallery
    if (openGallery && fileInput) {
        openGallery.addEventListener("click", function () {
            fileInput.click();
        });
    }

    // 📤 send message
    sendBtn.addEventListener("click", function () {

        const message = input.value?.trim();
        const file = fileInput?.files[0];

        if (!message && !file) return;

        const time = getCurrentTime();
        addMessageToUI(message, "sent", time, file ? URL.createObjectURL(file) : null);

        const formData = new FormData();
        formData.append("message", message || "");
        formData.append("conversationId", currentConversationId);

        if (file) {
            formData.append("image", file);
        }

        fetch("/chat/send", {
          method: "POST",
          body: formData
      })
      .then(res => res.json())
      .then(data => {
          loadMessages(currentConversationId);
      });

        input.value = "";
        if (fileInput) fileInput.value = "";
    });

});

