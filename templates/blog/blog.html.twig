    {{ form_widget(form.image) }}

  </div>

  {{ form_end(form) }}

</div>


<!-- POST IMAGE -->
{% for post in posts %}

<div class="card border-0 shadow-sm mb-4 rounded-4">
  <div class="card-body">

    <div class="d-flex align-items-center mb-2">

      <!-- IMAGE PROFIL -->
    <img src="{{ post.personne_id and post.personne_id.profile_photo 
    ? asset(post.personne_id.profile_photo) 
    : asset('assets/img/bg_1.jpg') }}"
     class="profile-img mr-2">



      <div>
        <!-- NOM -->
            <strong>
        {% if post.personne_id %}
          {{ post.personne_id.nom }} {{ post.personne_id.prenom }}
        {% else %}
          Utilisateur inconnu
        {% endif %}
      </strong>

        
        <br>

        <!-- DATE -->
       <small class="text-muted">
        {{ post.datePublication ? post.datePublication|date('Y-m-d H:i:s') : '---' }} • Public
      </small>
      </div>

      <!-- DROPDOWN (inchangé) -->
      {% if app.session.get('user_id') == post.personne_id.id %}
      <div class="dropdown ms-3">
        <button class="btn p-0 border-0 bg-transparent post-icon-dropdown dropdown-toggle"
                type="button" data-toggle="dropdown">
          <i class="fa fa-cog"></i>
        </button>

        <div class="dropdown-menu dropdown-menu-end modern-dropdown shadow-lg">
          <a class="dropdown-item open-edit"
            data-id="{{ post.id }}"
            data-contenu="{{ post.contenu }}"
            data-image="{{ post.image }}">
            <i class="fa fa-edit"></i> Modifier
          </a>
          <a class="dropdown-item text-danger"
            href="#"
            data-url="{{ path('post_delete', {'id': post.id}) }}"
            onclick="confirmDelete(event, this)">
          <i class="fa fa-trash"></i> Supprimer
          </a>
        </div>
      </div>
      {% endif %}

      <!-- TAGS -->
      <div class="ml-auto d-flex align-items-center">
        <span class="badge badge-light me-1">#Design</span>
        <span class="badge badge-primary me-1">#JavaFX</span>
        <span class="badge badge-pink">Tendance</span>
      </div>

    </div>

    <!-- CONTENU -->
    <div class="post" data-id="{{ post.id }}">
    <p class="post-content">{{ post.contenu }}</p>
     <button class="btn btn-sm btn-light mt-2 translate-btn"
            data-id="{{ post.id }}">
        <i class="fa fa-globe text-primary"></i> Traduire
    </button>

    <!-- SELECT (caché au début) -->
    <div class="translate-box mt-2" id="translate-box-{{ post.id }}" style="display:none;">

    <div class="d-flex align-items-center gap-2">

        <!-- ICON -->
       

        <!-- SELECT -->
        <select class="language-select modern-select" id="select-{{ post.id }}">
            <option value="fr">🇫🇷 Français</option>
            <option value="en">🇬🇧 English</option>
            <option value="ar">🇸🇦 العربية</option>
            <option value="es">🇪🇸 Español</option>
            <option value="de">🇩🇪 Deutsch</option>
            <option value="it">🇮🇹 Italiano</option>
            <option value="pt">🇵🇹 Português</option>
            <option value="ru">🇷🇺 Русский</option>
            <option value="tr">🇹🇷 Türkçe</option>
            <option value="zh">🇨🇳 中文</option>
            <option value="ja">🇯🇵 日本語</option>
