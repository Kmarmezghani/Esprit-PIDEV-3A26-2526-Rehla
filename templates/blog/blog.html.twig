{# ---------------------------------search---------------------------------------- #}
/* SEARCH BAR MODERNE */
.search-wrapper {
  position: relative;
  display: flex;
  align-items: center;
}

/* cacher checkbox */
#searchToggle {
  display: none;
}

.search-box {
  position: relative;
  height: 45px;
  width: 45px;
  border-radius: 50px;

  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(10px);

  display: flex;
  align-items: center;

  transition: 0.4s ease;
  overflow: hidden;
  cursor: text;

  border: 1px solid rgba(255, 255, 255, 0.2);
}

/* INPUT */
.search-input {
  border: none;
  outline: none;
  background: transparent;
  color: #333;

  width: 0;
  opacity: 0;

  transition: 0.4s ease;
  font-size: 14px;

  z-index: 2;
  pointer-events: none; 
}

/* ICON */
.search-icon {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  
  display: flex;
  align-items: center;
  justify-content: center;
  
  cursor: pointer;
  z-index: 3;
}

.search-icon svg {
  width: 18px;
  height: 18px;
  fill:  #333;;
  display: block;
}

/* HOVER ICON */
.search-icon:hover svg {
  transform: scale(1.2);
}

/* ========================= */
/* 🔥 ETAT OUVERT */
/* ========================= */

#searchToggle:checked ~ .search-box {
  width: 220px;
  padding-left: 10px;
}

/* input devient utilisable */
#searchToggle:checked ~ .search-box .search-input {
  width: 150px;
  opacity: 1;
  margin-left: 10px;
  pointer-events: auto; 
}

/* icône va à droite */
#searchToggle:checked ~ .search-box .search-icon {
  left: auto;
  right: 10px;
  transform: translateY(-50%);
}

/* glow effect */
.search-box:hover {
  box-shadow: 0 0 10px rgba(255,255,255,0.2);
}




