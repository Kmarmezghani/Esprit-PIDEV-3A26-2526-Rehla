{% extends 'adminbase.html.twig' %}

{% block title %}Modifier un Pays{% endblock %}

{% block sidebar %}
  {% include 'admin/partials/sidebar.html.twig' %}
{% endblock %}

{% block navbar %}
  {% include 'admin/partials/navbar.html.twig' %}
{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="card">
        <div class="card-header text-center">
            <h4>Modifier le pays</h4>
        </div>
        <div class="card-body">
            {{ form_start(form) }}

            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-end mb-1">
                    {{ form_label(form.nom) }}
                    <button type="button" id="btn-generate-image" class="btn btn-sm" style="background-color: #f0fdf4; color: #166534; border: 1px solid #166534; border-radius: 20px;">
                        🖼️ Générer Image
                    </button>
                </div>
                {{ form_widget(form.nom, {'attr': {'class': 'form-control'}}) }}
                {% for error in form.nom.vars.errors %}
                    <div class="alert alert-warning mt-1">{{ error.message }}</div>
                {% endfor %}
            </div>

            <div id="image-preview-container" class="mb-3 text-center" style="{{ pays.image ? '' : 'display: none;' }}">
                <label class="d-block mb-1">Aperçu de l'image</label>
                <img id="image-preview" src="{{ pays.image ? '/uploads/destinations/' ~ pays.image : '' }}" class="img-thumbnail" style="max-height: 200px;">
            </div>

            {{ form_widget(form.image, {'attr': {'id': 'hidden-image-input'}}) }}

            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-end mb-1">
                    {{ form_label(form.description) }}
                    <button type="button" id="btn-generate-ai" class="btn btn-sm" style="background-color: #e6f0ff; color: #223f91; border: 1px solid #223f91; border-radius: 20px;">
                        ✨ Générer via IA
                    </button>
                </div>
                {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': 4}}) }}
                {% for error in form.description.vars.errors %}
                    <div class="alert alert-warning mt-1">{{ error.message }}</div>
                {% endfor %}
            </div>

            <div class="mb-3">
                {{ form_label(form.visit_count) }}
                {{ form_widget(form.visit_count, {'attr': {'class': 'form-control'}}) }}
                {% for error in form.visit_count.vars.errors %}
                    <div class="alert alert-warning mt-1">{{ error.message }}</div>
                {% endfor %}
            </div>

            <div class="text-center">
                <a href="{{ path('admin_destination_index', {tab: 'pays'}) }}" class="btn btn-outline-secondary me-2"
                   style="border-radius: 25px; padding: 10px 30px;">
                    Retour
                </a>
                <button type="submit" class="btn"
                        style="background-color: #223f91; color: #fff; border-radius: 25px; padding: 10px 30px;">
                    Modifier
                </button>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}

{% block page_scripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const btnGenerateAi = document.getElementById('btn-generate-ai');
    const paysSelect = document.getElementById('pays_nom');
    const descriptionInput = document.getElementById('pays_description');

    if (!btnGenerateAi || !paysSelect || !descriptionInput) return;

    btnGenerateAi.addEventListener('click', function() {
        const countryName = paysSelect.options[paysSelect.selectedIndex]?.text || paysSelect.value;
        
        if (!countryName || countryName.trim() === '') {
            alert('Veuillez d\'abord sélectionner ou entrer un nom de pays.');
            return;
        }

        // Show loading state
        const originalText = btnGenerateAi.innerHTML;
        btnGenerateAi.innerHTML = '⏳ Génération...';
        btnGenerateAi.disabled = true;

        fetch('/admin/destination/api/ai/generate-description', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
            },
            body: JSON.stringify({ country: countryName })
        })
        .then(response => response.json())
        .then(data => {
            if (data.error) {
                alert('Erreur: ' + data.error);
            } else if (data.description) {
                descriptionInput.value = data.description;
            }
        })
        .catch(error => {
            console.error('Error generating description:', error);
            alert('Une erreur est survenue lors de la génération.');
        })
        .finally(() => {
            // Restore button state
            btnGenerateAi.innerHTML = originalText;
            btnGenerateAi.disabled = false;
        });
    });

    // Image Generation Logic
    const btnGenerateImage = document.getElementById('btn-generate-image');
    const imagePreview = document.getElementById('image-preview');
    const imageContainer = document.getElementById('image-preview-container');

    if (btnGenerateImage && paysSelect) {
        btnGenerateImage.addEventListener('click', function() {
            const countryName = paysSelect.options[paysSelect.selectedIndex]?.text || paysSelect.value;
            
            if (!countryName || countryName.trim() === '') {
                alert('Veuillez d\'abord entrer un nom de pays.');
                return;
            }

            const originalText = btnGenerateImage.innerHTML;
            btnGenerateImage.innerHTML = '⏳ Recherche...';
            btnGenerateImage.disabled = true;

            fetch('/admin/destination/api/generate-image', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                },
                body: JSON.stringify({ 
                    type: 'pays', 
                    id: '{{ pays.id }}', 
                    name: countryName 
                })
            })
            .then(response => response.json())
            .then(data => {
                if (data.error) {
                    alert('Erreur: ' + data.error);
                } else if (data.url) {
                    imagePreview.src = data.url;
                    imageContainer.style.display = 'block';
                    const hiddenImageInput = document.getElementById('hidden-image-input');
                    if (hiddenImageInput) {
                        hiddenImageInput.value = data.filename;
                    }
                }
            })
            .catch(error => {
                console.error('Error generating image:', error);
                alert('Une erreur est survenue lors de la recherche d\'image.');
            })
            .finally(() => {
                btnGenerateImage.innerHTML = originalText;
                btnGenerateImage.disabled = false;
            });
        });
    }
});
</script>
{% endblock %}
