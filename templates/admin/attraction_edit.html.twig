{% extends 'adminbase.html.twig' %}

{% block title %}Modifier une Attraction{% endblock %}

{% block sidebar %}
  {% include 'admin/partials/sidebar.html.twig' %}
{% endblock %}

{% block navbar %}
  {% include 'admin/partials/navbar.html.twig' %}
{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="card">
        <div class="card-header text-center">
            <h4>Modifier l'attraction</h4>
        </div>
        <div class="card-body">
            {{ form_start(form) }}

            <div class="mb-3">
                {{ form_label(form.nom) }}
                {{ form_widget(form.nom, {'attr': {'class': 'form-control'}}) }}
                {% for error in form.nom.vars.errors %}
                    <div class="alert alert-warning mt-1">{{ error.message }}</div>
                {% endfor %}
            </div>

            <div class="mb-3">
                {{ form_label(form.description) }}
                {{ form_widget(form.description, {'attr': {'class': 'form-control'}}) }}
                {% for error in form.description.vars.errors %}
                    <div class="alert alert-warning mt-1">{{ error.message }}</div>
                {% endfor %}
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    {{ form_label(form.type) }}
                    {{ form_widget(form.type, {'attr': {'class': 'form-control'}}) }}
                    {% for error in form.type.vars.errors %}
                        <div class="alert alert-warning mt-1">{{ error.message }}</div>
                    {% endfor %}
                </div>
                <div class="col-md-6">
                    {{ form_label(form.prix) }}
                    {{ form_widget(form.prix, {'attr': {'class': 'form-control'}}) }}
                    {% for error in form.prix.vars.errors %}
                        <div class="alert alert-warning mt-1">{{ error.message }}</div>
                    {% endfor %}
                </div>
            </div>

            <div class="mb-3">
                {{ form_label(form.ville_id) }}
                {{ form_widget(form.ville_id, {'attr': {'class': 'form-control'}}) }}
                {% for error in form.ville_id.vars.errors %}
                    <div class="alert alert-warning mt-1">{{ error.message }}</div>
                {% endfor %}
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    {{ form_label(form.heure_ouverture) }}
                    {{ form_widget(form.heure_ouverture, {'attr': {'class': 'form-control'}}) }}
                    {% for error in form.heure_ouverture.vars.errors %}
                        <div class="alert alert-warning mt-1">{{ error.message }}</div>
                    {% endfor %}
                </div>
                <div class="col-md-6">
                    {{ form_label(form.heure_fermeture) }}
                    {{ form_widget(form.heure_fermeture, {'attr': {'class': 'form-control'}}) }}
                    {% for error in form.heure_fermeture.vars.errors %}
                        <div class="alert alert-warning mt-1">{{ error.message }}</div>
                    {% endfor %}
                </div>
            </div>

            <div class="mb-3">
                {{ form_label(form.est_ferme) }}
                {{ form_widget(form.est_ferme, {'attr': {'class': 'form-check-input'}}) }}
                {% for error in form.est_ferme.vars.errors %}
                    <div class="alert alert-warning mt-1">{{ error.message }}</div>
                {% endfor %}
            </div>

            <div class="text-center">
                <a href="{{ path('admin_destination_index', {tab: 'attraction'}) }}" class="btn btn-outline-secondary me-2"
                   style="border-radius: 25px; padding: 10px 30px;">
                    Retour
                </a>
                <button type="submit" class="btn"
                        style="background-color: #223f91; color: #fff; border-radius: 25px; padding: 10px 30px;">
                    Modifier
                </button>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
