        style="
            background: {% if activite.isFlashSale and activite.flashPrice and activite.flashExpiresAt %}linear-gradient(135deg, #ff8c42, #f06d06){% else %}#223f91{% endif %};
            color: white;
            border: none;
            border-radius: 12px;
            padding: 8px 16px;
            font-weight: 700;
        "
