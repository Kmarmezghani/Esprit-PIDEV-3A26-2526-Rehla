/* BACKGROUND FLOU */
.overlay-blur {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  backdrop-filter: blur(8px);
  background: rgba(0,0,0,0.3);
  opacity: 0;
  visibility: hidden;
  transition: 0.3s;
  z-index: 999;
}

/* POPUP */
.comment-popup {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) scale(0.8);
  width: 400px;
  max-width: 90%;
  background: linear-gradient(135deg, #ffffff, #f8fbff);
  backdrop-filter: blur(20px);
  border-radius: 20px;
  box-shadow: 0 20px 60px rgba(0,0,0,0.2);
  opacity: 0;
  visibility: hidden;
  transition: 0.3s ease;
  z-index: 1000;
  overflow: hidden;
}

/* ACTIVE STATE */
.comment-popup.active,
.overlay-blur.active {
  opacity: 1;
  visibility: visible;
}

.comment-popup.active {
  transform: translate(-50%, -50%) scale(1);
}

