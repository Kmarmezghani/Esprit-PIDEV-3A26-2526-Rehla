.ai-gen-btn{width:100%;padding:13px;background:#223f91;color:#fff;border:none;border-radius:12px;font-size:15px;font-weight:500;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px}
.ai-gen-btn:hover{background:#1a2f6e}
.ai-gen-btn:disabled{opacity:.5;cursor:not-allowed}
