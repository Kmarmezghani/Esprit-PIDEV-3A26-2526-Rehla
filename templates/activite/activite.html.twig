    </span>
{% endif %}
{% if activite.isFlashSale and activite.flashPrice and activite.flashExpiresAt %}
    <span class="price">
        <span style="
            display: block;
            font-size: 11px;
            color: rgba(255,255,255,0.8);
            text-decoration: line-through;
            font-weight: 600;
            margin-bottom: 2px;
        ">
            {{ activite.prix|number_format(2, '.', '') }} TND
        </span>

        {{ activite.flashPrice|number_format(2, '.', '') }} TND/person
    </span>
{% else %}
    <span class="price">{{ activite.prix|number_format(2, '.', '') }} TND/person</span>
{% endif %}
</a>            <div class="text p-4">
                <span class="days">
