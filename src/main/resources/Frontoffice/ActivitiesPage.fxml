<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="1000.0"
            xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controllers.ActivitiesPageController"
            stylesheets="@css/profile-menu.css">

    <children>
        <BorderPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

            <!-- TOP NAVBAR -->
            <top>
                <HBox alignment="CENTER_LEFT" prefHeight="70.0"
                      style="-fx-background-color: #223f91;" BorderPane.alignment="CENTER">
                    <children>

                        <!-- Logo -->
                        <ImageView fitHeight="60.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../Backoffice/icons/IMG_20260125_122708_191-removebg-preview.png" />
                            </image>
                        </ImageView>

                        <Region HBox.hgrow="ALWAYS"/>

                        <!-- Center nav -->
                        <HBox alignment="CENTER" spacing="22.0">
                            <Button onAction="#goToHome"
                                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 16; -fx-cursor: hand;"
                                    text="Home" />
                            <Button onAction="#goToDestinations"
                                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 16; -fx-cursor: hand;"
                                    text="Destinations" />
                            <Button onAction="#goToPosts"
                                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 16; -fx-cursor: hand;"
                                    text="Posts" />
                            <Button onAction="#goToactivities"
                                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 16; -fx-cursor: hand;"
                                    text="Activities" />
                            <Button
                                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 16; -fx-cursor: hand;"
                                    text="About" />
                        </HBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <!-- NOTIFICATIONS -->
                        <!-- NOTIF -->
                        <StackPane fx:id="notifPane" prefWidth="40.0" prefHeight="40.0" minWidth="40.0" minHeight="40.0">
                            <HBox.margin><Insets right="10.0"/></HBox.margin>

                            <Button fx:id="btnNotif" onAction="#openNotifications"
                                    styleClass="iconBtn" text="🔔"/>

                            <Label fx:id="lblNotifCount"
                                   text="0" visible="false" managed="false"
                                   mouseTransparent="true"
                                   styleClass="notifBadge">
                                <StackPane.alignment>TOP_RIGHT</StackPane.alignment>
                                <!-- marge POSITIVE pour rester dedans -->
                                <StackPane.margin><Insets top="4.0" right="4.0"/></StackPane.margin>
                            </Label>
                        </StackPane>

                        <!-- PROFILE -->
                        <Button fx:id="btnProfile" onAction="#openProfileMenu"
                                styleClass="iconBtn" text="👤">
                            <HBox.margin><Insets right="20.0"/></HBox.margin>

                            <contextMenu>
                                <ContextMenu fx:id="profileMenu" styleClass="profileMenu">
                                    <items>

                                        <MenuItem onAction="#goToMyProfile" text="My Profile">
                                            <graphic>
                                                <SVGPath content="M12 12c2.7 0 5-2.3 5-5s-2.3-5-5-5-5 2.3-5 5 2.3 5 5 5zm0 2c-4 0-8 2-8 5v1h16v-1c0-3-4-5-8-5z"
                                                         style="-fx-fill: #374151; -fx-scale-x: 0.8; -fx-scale-y: 0.8;"/>
                                            </graphic>
                                        </MenuItem>

                                        <MenuItem onAction="#goToMyPosts" text="My Posts">
                                            <graphic>
                                                <SVGPath styleClass="menuIcon"
                                                         content="M9 6l1.5-2h3L15 6h3a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h3zm3 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zm0-2.2a1.8 1.8 0 1 1 0-3.6 1.8 1.8 0 0 1 0 3.6z"/>
                                            </graphic>
                                        </MenuItem>

                                        <MenuItem onAction="#goToMyReservations" text="My Reservations">
                                            <graphic>
                                                <SVGPath styleClass="menuIcon"
                                                         content="M7 2v2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-2V2h-2v2H9V2H7zm12 6H5V6h14v2zM7 12h3v3H7v-3zm4 0h3v3h-3v-3zm4 0h3v3h-3v-3z"/>
                                            </graphic>
                                        </MenuItem>

                                        <MenuItem onAction="#goToMyActivities" text="My Activities">
                                            <graphic>
                                                <SVGPath styleClass="menuIcon"
                                                         content="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm0 2a8 8 0 1 1 0 16 8 8 0 0 1 0-16zm3.2 4.8l-1.9 5-5 1.9 1.9-5 5-1.9z"/>
                                            </graphic>
                                        </MenuItem>

                                        <SeparatorMenuItem/>

                                        <MenuItem onAction="#handleLogout" text="Logout">
                                            <graphic>
                                                <SVGPath content="M10 3v2h6v14h-6v2h8V3z M4 12l4-4v3h8v2H8v3z"
                                                         style="-fx-fill: #dc2626; -fx-scale-x: 0.8; -fx-scale-y: 0.8;"/>
                                            </graphic>
                                        </MenuItem>

                                    </items>
                                </ContextMenu>
                            </contextMenu>
                        </Button>

                        <!-- window buttons -->
                        <Button onAction="#minwindow"
                                style="-fx-text-fill: white; -fx-font-size: 20;"
                                styleClass="button4"
                                stylesheets="@../Backoffice/css/styling.css"
                                text="−" />
                        <Button onAction="#maxwindow"
                                style="-fx-text-fill: white; -fx-font-size: 20;"
                                styleClass="button4"
                                stylesheets="@../Backoffice/css/styling.css"
                                text="□" />
                        <Button onAction="#closewindow"
                                style="-fx-text-fill: white; -fx-font-size: 16;"
                                styleClass="button3"
                                stylesheets="@../Backoffice/css/styling.css"
                                text="✕">
                            <HBox.margin><Insets top="4.0"/></HBox.margin>
                        </Button>

                    </children>

                    <padding>
                        <Insets left="30.0" right="30.0" />
                    </padding>
                </HBox>
            </top>

            <!-- CENTER CONTENT -->
            <center>
                <ScrollPane fitToWidth="true" style="-fx-background-color: #ffffff;" BorderPane.alignment="CENTER">
                    <content>
                        <VBox spacing="30.0" style="-fx-background-color: #ffffff;">

                            <!-- HERO -->
                            <VBox alignment="CENTER" spacing="20.0"
                                  style="-fx-background-color: linear-gradient(to bottom, #3A5BC7, #223f91); -fx-padding: 80;">
                                <Label text="Discover Activities Near You" textFill="WHITE">
                                    <font><Font name="System Bold" size="48.0" /></font>
                                </Label>

                                <Label text="Browse amazing activities and book in seconds" textFill="WHITE">
                                    <font><Font size="18.0" /></font>
                                </Label>

                                <HBox alignment="CENTER" spacing="10.0"
                                      style="-fx-background-color: white; -fx-background-radius: 30; -fx-padding: 10;">
                                    <padding>
                                        <Insets bottom="10.0" left="20.0" right="10.0" top="10.0" />
                                    </padding>

                                    <TextField fx:id="searchField" prefWidth="400.0"
                                               promptText="Search activities, destinations..."
                                               style="-fx-background-color: transparent; -fx-border-color: transparent;" />

                                    <Button onAction="#handleSearch"
                                            style="-fx-background-color: #3A5BC7; -fx-text-fill: white; -fx-background-radius: 20; -fx-cursor: hand; -fx-font-weight: bold; -fx-font-size: 14;"
                                            text="Search" />
                                </HBox>
                            </VBox>

                            <!-- LIST -->
                            <VBox spacing="20.0" style="-fx-background-color: #ffffff;">
                                <padding>
                                    <Insets left="40.0" right="40.0" top="10.0" />
                                </padding>

                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <ImageView fitHeight="28" fitWidth="28" preserveRatio="true">
                                        <image><Image url="@/Backoffice/icons/Bousole.png" /></image>
                                    </ImageView>

                                    <Label text="Activities" textFill="#223f91">
                                        <font><Font name="System Bold" size="32.0" /></font>
                                    </Label>

                                    <Region HBox.hgrow="ALWAYS"/>

                                    <Button text="🔥 Flash sales" onAction="#showFlashSales"
                                            style="-fx-background-color: #fff7ed; -fx-text-fill: #c2410c; -fx-font-weight: 900; -fx-background-radius: 999; -fx-padding: 8 14; -fx-border-color: #fdba74; -fx-border-radius: 999; -fx-cursor: hand;" />

                                    <Button text="All" onAction="#showAllActivities"
                                            style="-fx-background-color: #eef2ff; -fx-text-fill: #223f91; -fx-font-weight: 900; -fx-background-radius: 999; -fx-padding: 8 14; -fx-cursor: hand;" />
                                </HBox>

                                <Label text="Plan your day with the best activities" textFill="#4a5f88">
                                    <font><Font size="16.0" /></font>
                                </Label>

                                <FlowPane fx:id="activitiesFlowPane" hgap="25.0" prefWrapLength="900.0" vgap="25.0">
                                    <padding><Insets top="10.0" /></padding>
                                </FlowPane>

                                <Region prefHeight="10.0" />
                            </VBox>

                            <!-- FOOTER -->
                            <VBox alignment="CENTER" spacing="8.0"
                                  style="-fx-background-color: #223f91; -fx-padding: 20;">
                                <Label text="Rehla - Your Travel Companion" textFill="WHITE">
                                    <font><Font name="System Bold" size="16.0" /></font>
                                </Label>
                                <Label text="© 2026 Rehla. All rights reserved." textFill="#cccccc">
                                    <font><Font size="12.0" /></font>
                                </Label>
                            </VBox>

                        </VBox>
                    </content>
                </ScrollPane>
            </center>

        </BorderPane>
    </children>
</AnchorPane>