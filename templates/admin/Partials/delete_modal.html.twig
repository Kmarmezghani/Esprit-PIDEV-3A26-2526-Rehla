<div class="modal fade" id="delete{{ entity }}{{ id }}" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title text-danger"><i class="bx bx-error-circle me-1"></i> Suppression de {{ entity }}</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body text-center">
        <i class="bx bx-trash display-6 text-danger mb-3"></i>
        <h5>Voulez-vous vraiment supprimer cet élément ?</h5>
        <p class="text-muted mb-0">Cette action est <strong>irréversible</strong>.</p>
      </div>
      <div class="modal-footer justify-content-center">
        <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
        <form method="post" action="{{ path }}">
          <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ id) }}">
          <button class="btn btn-danger"><i class="bx bx-trash me-1"></i> Oui, supprimer</button>
        </form>
      </div>
    </div>
  </div>
</div>
