    <button class="btn btn-sm btn-outline-primary ml-auto">+ Suivre</button>
  </div>

  <div class="d-flex align-items-center">
    <img src="{{ asset('assets/images/profile3.jpg') }}"
         class="rounded-circle mr-2" width="35">
    <span>Cuisine Pro</span>
    <button class="btn btn-sm btn-outline-primary ml-auto">+ Suivre</button>
  </div>
</div>

<!-- Playlist -->
<div class="card border-0 shadow-sm rounded-4 p-3">
  <h6>🎧 Playlist du moment</h6>
  <small>Lo-fi Focus • 2h 14m</small>

  <div class="progress mt-2" style="height:6px;">
    <div class="progress-bar" style="width:40%"></div>
  </div>
</div>

</div>

</div>
</div>
</section>

