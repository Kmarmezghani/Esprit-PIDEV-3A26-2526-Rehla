      <button type="submit" class="btn-save">Enregistrer</button>
    </div>

  </form>

</div>




<script>
document.addEventListener('DOMContentLoaded', function() {
const hearts = document.querySelectorAll('.fa-heart');
hearts.forEach(heart => {
heart.addEventListener('click', function() {
this.classList.toggle('text-danger');
const count = this.nextElementSibling;
const current = parseInt(count.textContent);
count.textContent = this.classList.contains('text-danger') ? current + 1 : current - 1;
});
});
});
document.querySelectorAll('.fa-bookmark').forEach(icon => {
  icon.addEventListener('click', function() {
    this.classList.toggle('text-warning');
  });
});

/*-----------popup add comments----------------------------*/
const openBtns = document.querySelectorAll(".open-comment");
const popup = document.getElementById("commentPopup");
const overlay = document.getElementById("commentOverlay");
const closeBtn = document.getElementById("closePopup");
const form = document.getElementById("commentForm");
const postIdInput = document.getElementById("comment_post_id");

openBtns.forEach(btn => {
  btn.addEventListener("click", () => {

    const postId = btn.getAttribute("data-id");

    // 🔥 afficher bon bloc commentaires
    document.querySelectorAll(".comments-container").forEach(div => {
      div.style.display = "none";
    });

    const target = document.querySelector(`.comments-container[data-post="${postId}"]`);
    if (target) target.style.display = "block";

    // 🔥 préparer form
    postIdInput.value = postId;
    form.action = "/comment/add/" + postId;

    // 🔥 ouvrir popup
    popup.classList.add("active");
    overlay.classList.add("active");
  });
});

function closePopup() {
  popup.classList.remove("active");
  overlay.classList.remove("active");
}

if (closeBtn) {
  closeBtn.addEventListener("click", closePopup);
}

overlay.addEventListener("click", closePopup);


{# ----------------------------------------- pop up alerte add comment ------------------------------------------ #}
document.addEventListener("DOMContentLoaded", function () {

    const commentForm = document.getElementById("commentForm");
    const commentInput = document.getElementById("comment_input");
    if (!commentForm || !commentInput) return;

    commentForm.addEventListener("submit", function (e) {
        const value = (commentInput.value || "").trim();

        // ❌ champ vide
        if (value === "") {
            e.preventDefault();

            Swal.fire({
                icon: 'error',
                text: 'Le commentaire est obligatoire',
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 2500,
                background: '#fff1f2',
                color: '#991b1b',
                iconColor: '#ef4444',
                customClass: {
                    popup: 'red-toast'
                }
            });

            return;
        }

        // ⚠️ trop court
        if (value.length < 3) {
            e.preventDefault();

            Swal.fire({
                icon: 'warning',
                text: 'Minimum 3 caractères',
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 2500,
                background: '#fff7ed',
                color: '#9a3412',
                iconColor: '#f59e0b',
                customClass: {
                    popup: 'orange-toast'
                }
            });

            return;
        }
        if (!/^[a-zA-Z0-9]/.test(value)) {
        e.preventDefault();
        Swal.fire({
            icon: 'error',
            text: 'Le contenu doit commencer par une lettre ou un chiffre',
            toast: true,
            position: 'top-end',
            showConfirmButton: false,
            timer: 2500,
            background: '#fff1f2',
            color: '#991b1b',
            iconColor: '#ef4444',
            customClass: {
                    popup: 'red-toast'
                }
          });
          return;
          }

        // ✅ succès
        Swal.fire({
            icon: 'success',
            text: 'Commentaire ajouté avec succès',
            toast: true,
            position: 'top-end',
            showConfirmButton: false,
            timer: 2500,
            background: '#ecfdf5',
            color: '#065f46',
            iconColor: '#10b981',
            customClass: {
                popup: 'green-toast'
            }
        });

    });

});





{# --------------------------pop up edit post------------------------------- #}
document.addEventListener("DOMContentLoaded", function () {

  const editBtns = document.querySelectorAll(".open-edit");
  const editPopup = document.getElementById("editPostPopup");
  const overlay = document.getElementById("commentOverlay");

  const closeEdit = document.getElementById("closeEditPopup");
  const cancelEdit = document.getElementById("cancelEdit");

  const contenuInput = document.getElementById("edit_contenu");
  const imagePreview = document.getElementById("edit_image_preview");
  const postIdInput = document.getElementById("edit_post_id");
  const form = document.getElementById("editForm");

  editBtns.forEach(btn => {
    btn.addEventListener("click", () => {

      // 🔥 récupérer data
      const id = btn.getAttribute("data-id");
      const contenu = btn.getAttribute("data-contenu");
      const image = btn.getAttribute("data-image");

      // 🔥 remplir popup
      postIdInput.value = id;
      contenuInput.value = contenu;

      if (image) {
        imagePreview.src = "/" + image;
      } else {
        imagePreview.src = "/assets/images/bg_1.jpg";
      }

      // 🔥 action dynamique (route Symfony)
      form.action = "/post/edit/" + id;

      // afficher popup
      editPopup.classList.add("active");
      overlay.classList.add("active");
    });
  });

  function closePopup() {
    editPopup.classList.remove("active");
    overlay.classList.remove("active");
  }

  closeEdit.addEventListener("click", closePopup);
  cancelEdit.addEventListener("click", closePopup);
  overlay.addEventListener("click", closePopup);

});
document.getElementById("edit_image_input").addEventListener("change", function (event) {

    const file = event.target.files[0];
    const preview = document.getElementById("edit_image_preview");

    if (file) {
        const reader = new FileReader();

        reader.onload = function (e) {
            preview.src = e.target.result; 
        };

        reader.readAsDataURL(file);
    }
});


