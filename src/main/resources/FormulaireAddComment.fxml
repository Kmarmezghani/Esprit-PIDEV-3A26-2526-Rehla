<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<VBox spacing="12" alignment="CENTER"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="Controllers.AddCommentController">

    <Label text="Ajouter Commentaire"/>

    <TextArea fx:id="txtContenu"
              promptText="Contenu du commentaire"
              prefRowCount="3"/>

    <ComboBox fx:id="cbAuteur"
              promptText="Choisir Auteur"/>

    <ComboBox fx:id="cbPost"
              promptText="Choisir Post"/>

    <Button text="Ajouter"
            onAction="#addCommentaire"/>

</VBox>


