  box-shadow: 0 15px 35px rgba(0,0,0,0.1);
  animation: dropdownFade 0.25s ease;
  min-width: 180px;
}


/* animation */
@keyframes dropdownFade {
  from {
    opacity: 0;
    transform: translateY(-10px) scale(0.95);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

