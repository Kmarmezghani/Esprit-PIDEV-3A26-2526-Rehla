(function () {
    const API_KEY = 'YOUR_EXCHANGERATE_API_KEY'; // ← paste your key here
    const BASE    = 'TND';
    let rates     = { TND: 1, EUR: null, USD: null };
    let currentCurrency = 'TND';
    const symbols = { TND: 'TND', EUR: '€', USD: '$' };

    /* Fetch rates once, cache in memory */
    async function fetchRates() {
        try {
            const res  = await fetch('/api/exchange-rates');
            const data = await res.json();
            if (data.result === 'success') {
                rates.EUR = data.conversion_rates.EUR;
                rates.USD = data.conversion_rates.USD;
            }
        } catch (e) {
            console.error('ExchangeRate API error:', e);
        }
    }

    function updatePrices(currency) {
        const rate   = rates[currency];
        const badge  = document.getElementById('rate-badge');
        const cells  = document.querySelectorAll('.price-cell');

        if (!rate) {
            /* Show loading shimmer while fetching */
            cells.forEach(c => c.classList.add('price-loading'));
            return;
        }

        cells.forEach(c => {
            c.classList.remove('price-loading');
            const tnd      = parseFloat(c.dataset.tnd);
            const converted = (tnd * rate).toFixed(2);
            const sym      = symbols[currency];
            c.textContent  = currency === 'TND'
                ? `${converted} TND`
                : `${sym} ${converted}`;
        });

        /* Show exchange rate info badge */
        if (currency !== 'TND') {
            badge.style.display = 'inline-block';
            badge.textContent   = `1 TND = ${rate.toFixed(4)} ${currency}`;
        } else {
            badge.style.display = 'none';
        }
    }

    /* Init: fetch rates in background */
    fetchRates();

    /* Button clicks */
    document.querySelectorAll('.btn-currency').forEach(btn => {
        btn.addEventListener('click', async function () {
            const currency = this.dataset.currency;
            if (currency === currentCurrency) return;

            /* Toggle active state */
            document.querySelectorAll('.btn-currency').forEach(b => b.classList.remove('active'));
            this.classList.add('active');
            currentCurrency = currency;

            /* Fetch rates if not yet loaded */
            if (currency !== 'TND' && rates[currency] === null) {
                document.querySelectorAll('.price-cell').forEach(c => c.classList.add('price-loading'));
                await fetchRates();
            }

            updatePrices(currency);
        });
    });
})();
</script>

{% endblock %}
