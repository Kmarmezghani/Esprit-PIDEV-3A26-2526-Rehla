    {% endif %}
</ul>
</div>
		</div>
	</nav>


<section class="hero-wrap hero-wrap-2 activity-hero"
         style="background-image: url('{{ asset('uploads/activities/' ~ activite.image|split('\\')|last) }}');">
  <div class="overlay"></div>
</section>

<section class="ftco-section">
  <div class="container">
    <div class="row align-items-stretch">
      <div class="col-lg-7 d-flex">
        <div class="activity-main-card mb-4 w-100">
          <div class="activity-content">
            <div class="d-flex justify-content-between align-items-start flex-wrap mb-3" style="gap: 10px;">
              <div>
                <h2 class="activity-title mb-2">{{ activite.nom }}</h2>
                <p class="activity-location mb-0">
                  <span class="fa fa-map-marker"></span>
                  {{ activite.destination ? activite.destination.nom : 'Non défini' }}
                </p>
              </div>

              {% if activite.isFlashSale and activite.flashPrice and activite.flashExpiresAt %}
    <div style="display:flex; flex-direction:column; align-items:flex-end; gap:6px;">
        <div class="price-badge" style="background:#fff3eb; color:#f06d06; border:1px solid rgba(240,109,6,0.20);">
            🔥 Flash Sale
        </div>

        <div class="price-badge">
            <span style="
                display:block;
                font-size:12px;
                opacity:.75;
                text-decoration:line-through;
                font-weight:600;
                line-height:1.1;
                margin-bottom:2px;
            ">
                {{ activite.prix|number_format(2, '.', '') }} TND
            </span>

            {{ activite.flashPrice|number_format(2, '.', '') }} TND/person
        </div>
    </div>
{% else %}
    <div class="price-badge">
        {{ activite.prix|number_format(2, '.', '') }} TND/person
    </div>
{% endif %}
            </div>

            <div class="activity-meta-grid">
              <div class="meta-box">
                <span class="meta-label">Type</span>
                <span class="meta-value">{{ activite.typeActivite ?: 'Non défini' }}</span>
              </div>

              <div class="meta-box">
                <span class="meta-label">Places</span>
                <span class="meta-value">{{ activite.maxPlaces ?: 0 }}</span>
              </div>

              <div class="meta-box">
                <span class="meta-label">Date début</span>
                <span class="meta-value">{{ activite.dateDebut ? activite.dateDebut|date('d/m/Y H:i') : 'Non défini' }}</span>
              </div>

              <div class="meta-box">
                <span class="meta-label">Date fin</span>
                <span class="meta-value">{{ activite.dateFin ? activite.dateFin|date('d/m/Y H:i') : 'Non défini' }}</span>
              </div>
            </div>

            <div class="activity-description mt-4">
              <h4>Description</h4>
              <p>{{ activite.description }}</p>
            </div>
            {% if weatherData %}
  <div class="activity-weather-summary-box mt-4">
    <div class="activity-weather-summary-header">
      <h4>Météo prévue</h4>
      <div class="activity-weather-badge">
        <img
          src="https://openweathermap.org/img/wn/{{ weatherData.icon }}@2x.png"
          alt="{{ weatherData.description }}"
          class="activity-weather-badge-icon"
        >
        <span>{{ weatherData.temp }}°C</span>
      </div>
    </div>

    <div class="activity-weather-summary-grid">
      <div class="weather-summary-item">
        <span class="weather-summary-label">Ciel</span>
        <span class="weather-summary-value">{{ weatherData.description|capitalize }}</span>
      </div>

      <div class="weather-summary-item">
        <span class="weather-summary-label">Humidité</span>
        <span class="weather-summary-value">{{ weatherData.humidity }}%</span>
      </div>

      <div class="weather-summary-item">
        <span class="weather-summary-label">Vent</span>
        <span class="weather-summary-value">{{ weatherData.wind }} km/h</span>
      </div>

      <div class="weather-summary-item">
        <span class="weather-summary-label">Ressenti global</span>
        <span class="weather-summary-value">
          {% if weatherData.temp >= 30 %}
            Chaud
          {% elseif weatherData.temp >= 18 %}
            Agréable
          {% elseif weatherData.temp >= 12 %}
            Modéré
          {% else %}
            Frais
          {% endif %}
        </span>
      </div>
    </div>

    <p class="activity-weather-note mb-0">
      {% if weatherData.temp >= 30 %}
        Une météo chaude est attendue pour cette activité.
      {% elseif weatherData.temp >= 18 and weatherData.temp <= 24 %}
        Les conditions semblent globalement agréables pour cette activité.
      {% elseif weatherData.temp < 12 %}
        Une météo assez fraîche est prévue.
      {% else %}
        Des conditions modérées sont prévues pour cette activité.
      {% endif %}
      {% if weatherData.wind >= 30 %}
        Le vent pourrait aussi être un facteur à prendre en compte.
      {% endif %}
    </p>
  </div>
{% endif %}
          </div>
        </div>
      </div>

      <div class="col-lg-5 d-flex">
        <div class="reviews-summary-card mb-4 w-100">
          <p class="reviews-total">
            Total : <strong>{{ totalAvis }}</strong> avis
          </p>

          <div class="rating-overview">
            <div class="rating-score">
              {{ activite.noteMoyenne|default(0)|number_format(1, '.', ',') }}
            </div>

            <div class="rating-stars">
              {% set rounded = activite.noteMoyenne|default(0)|round(0, 'common') %}
              {% for i in 1..5 %}
                {% if i <= rounded %}
                  <span class="fa fa-star checked-star"></span>
                {% else %}
                  <span class="fa fa-star empty-star"></span>
                {% endif %}
              {% endfor %}
            </div>
          </div>

          <div class="distribution-wrap mt-4">
            {% for star in [5,4,3,2,1] %}
              {% set count = distribution[star] %}
              {% set percent = totalAvis > 0 ? (count * 100 / totalAvis) : 0 %}

              <div class="distribution-row">
                <span class="distribution-label">{{ star }}</span>
                <div class="distribution-bar">
                  <div class="distribution-fill" style="width: {{ percent }}%;"></div>
                </div>
                <span class="distribution-percent">{{ percent|round(0, 'common') }}%</span>
              </div>
            {% endfor %}
          </div>
          {% if weatherData %}
  <div class="weather-tips-box mt-4">
    <div class="weather-tips-header">
      <h4>Conseils personnalisés</h4>

      
    </div>

    {% if weatherTips is not empty %}
      <ul class="weather-tips-list">
        {% for tip in weatherTips %}
          <li>{{ tip }}</li>
        {% endfor %}
      </ul>
    {% else %}
      <p class="weather-empty mb-0">Aucun conseil météo disponible pour cette activité.</p>
    {% endif %}
  </div>
{% endif %}
        </div>
      </div>
    </div>

    <div class="row mt-4">
      <div class="col-lg-12">
        <div class="reviews-form-card" id="form-avis">
          <div class="reviews-header">
            <div class="reviews-title">
              {{ isEditMode ? '✏️ Modifier mon avis' : '✍️ Laisser un avis' }}
            </div>
          </div>

          {% if userAvis and not isEditMode %}
            <div class="review-hint-box">
              Vous avez déjà publié un avis pour cette activité.
              <a href="{{ path('activite_show', {'id': activite.id, 'editAvis': 1}) }}#form-avis">Cliquer ici pour le modifier</a>.
            </div>
          {% endif %}

          {{ form_start(avisForm) }}

          <div class="mb-3">
            <label class="review-form-label">Votre note</label>

            <div class="star-rating-input">
              {% for child in avisForm.note|reverse %}
                {{ form_widget(child, {'attr': {'class': 'star-input'}}) }}
                <label for="{{ child.vars.id }}" class="star-label">★</label>
              {% endfor %}
            </div>

            <div class="form-error">
              {{ form_errors(avisForm.note) }}
            </div>
          </div>

          <div class="mb-3">
            {{ form_label(avisForm.commentaire, null, {'label_attr': {'class': 'review-form-label'}}) }}
            {{ form_widget(avisForm.commentaire, {'attr': {'class': 'review-textarea'}}) }}
            <div class="form-error">
              {{ form_errors(avisForm.commentaire) }}
            </div>
          </div>

          <button type="submit" class="submit-review-btn">
            {{ isEditMode ? 'Mettre à jour mon avis' : 'Publier mon avis' }}
          </button>

          {{ form_end(avisForm) }}
        </div>
      </div>
    </div>

    <div class="row mt-4">
      <div class="col-lg-12">
        <div class="reviews-list-card">
          <div class="reviews-header">
            <div class="reviews-title">
              ⭐ Avis des voyageurs
            </div>

            <div class="reviews-count">
              {{ totalAvis }} avis
            </div>
          </div>

          {% if aviss|length > 0 %}
            <div class="reviews-list">
              {% for avis in aviss %}
                <div class="review-item {% if app.session.get('user_id') and avis.personne and avis.personne.id == app.session.get('user_id') %}own-review{% endif %}">
                  <div class="review-top">
                    <div class="review-user">
                      {% if avis.personne and avis.personne.profile_photo %}
                        <img src="{{ asset(avis.personne.profile_photo) }}"
                             alt="Photo de profil"
                             class="review-user-avatar">
                      {% else %}
                        <img src="{{ asset('assets/images/default-user.png') }}"
                             alt="Photo de profil"
                             class="review-user-avatar">
                      {% endif %}

                      <div class="review-user-info">
                        <h5 class="mb-1">
                          {{ avis.personne ? avis.personne.prenom ~ ' ' ~ avis.personne.nom : 'Utilisateur' }}
                        </h5>
                        <span class="review-date">
                          {{ avis.dateAvis ? avis.dateAvis|date('d/m/Y H:i') : '' }}
                        </span>
                      </div>
                    </div>

                    <div class="review-right">
                      {% if app.session.get('user_id') and avis.personne and avis.personne.id == app.session.get('user_id') %}
                        <div class="review-actions">
                          <a href="{{ path('activite_show', {'id': activite.id, 'editAvis': 1}) }}#form-avis"
                             class="review-action-btn edit-btn"
                             title="Modifier mon avis">
                            <i class="fa fa-pencil"></i>
                          </a>

                          <button type="button"
                                  class="review-action-btn delete-btn"
                                  data-bs-toggle="modal"
                                  data-bs-target="#deleteAvisModal{{ avis.id }}"
                                  title="Supprimer mon avis">
                            <i class="fa fa-trash"></i>
                          </button>
                        </div>
                      {% endif %}

                      <div class="review-stars-inline">
                        {% for i in 1..5 %}
                          {% if i <= avis.note %}
                            <span class="fa fa-star checked-star"></span>
                          {% else %}
                            <span class="fa fa-star empty-star"></span>
                          {% endif %}
                        {% endfor %}
                      </div>
                    </div>
                  </div>

                  <p class="review-comment mb-0">{{ avis.commentaire }}</p>
                </div>
              {% endfor %}
            </div>
          {% else %}
            <div class="empty-reviews">
              Aucun avis pour cette activité pour le moment.
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

