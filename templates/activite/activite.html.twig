                            </div>

                            <div style="flex:1;">
                               <div style="font-size:12px; font-weight:700; margin-bottom:4px;
    color:
{% if notif.type == 'WAITLIST_HOLD' %}#223f91
{% elseif notif.type == 'BOOKING_CONFIRMED' %}#16a34a
{% elseif notif.type == 'BOOKING_CANCELLED' %}#dc3545
{% elseif notif.type == 'WAITLIST_EXPIRED' %}#6b7280
{% else %}#223f91
{% endif %};
">
    {% if notif.type == 'WAITLIST_HOLD' %}
