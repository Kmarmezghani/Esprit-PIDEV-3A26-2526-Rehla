    <div class="dropdown-menu dropdown-menu-right messenger-dropdown shadow-lg p-0">

            <!-- HEADER -->
        <div class="messenger-header p-3 d-flex justify-content-between align-items-center">
            <strong>Chats</strong>
            <i class="fa fa-ellipsis-h"></i>
        </div>

        <!-- SEARCH -->
        <div class="px-3 pb-2">
            <input type="text" class="form-control messenger-search" placeholder="Search Messenger">
        </div>
        <!-- GROUP STORIES -->
        <div class="messenger-groups px-3 pt-2 pb-2">

            <!-- CREATE GROUP -->
            <div class="group-item create-group" title="Créer groupe">
                <i class="fa fa-plus"></i>
            </div>

            <!-- GROUP LIST -->
            {% if groups is defined and groups|length > 0 %}
            {% for group in groups %}
              <div class="group-item"
                  data-id="{{ group.id }}"
                  data-name="{{ group.nom }}"
                  data-photo="{{ group.image ? asset(group.image) : asset('assets/images/default-user.png') }}">

                  <div class="group-avatar">
                      <img src="{{ group.image ? asset(group.image) : asset('assets/images/default-user.png') }}">
                  </div>

                  <div class="group-name">
                      {{ group.nom }}
                  </div>

              </div>
          {% endfor %}
            {% endif %}

        </div>


        <!-- LIST -->
          <div class="messenger-list">
          
          {% for item in chatList %}

          <div class="messenger-item"
          data-id="{{ item.user.id }}"
          data-name="{{ item.user.nom }} {{ item.user.prenom }}"
          data-photo="{{ item.user.profile_photo ? asset(item.user.profile_photo) : asset('assets/images/default-user.png') }}">

              <img src="{{ asset(item.user.profile_photo ? item.user.profile_photo : 'assets/images/default-user.png') }}" class="avatar">

              <div class="msg-content">

              <div class="msg-top">
                
                <span class="name {{ item.unread ? 'fw-bold' : '' }}">
                    {{ item.user.nom }} {{ item.user.prenom }}
                </span>

                <div class="msg-right">
                    <span class="time">
                        {{ item.lastMessageTime ? item.lastMessageTime|timeAgo : '' }}
                    </span>

                    {% if item.unread %}
                        <span class="unread-dot"></span>
                    {% endif %}
                </div>

            </div>


                  <div class="msg-text {{ item.unread ? 'fw-bold' : '' }}">

                      {% if item.lastMessage %}

                      {% set isImage = item.lastMessage starts with 'uploads/chat' %}

                      {% if item.lastSenderId == currentUserId %}
                          Vous :
                      {% else %}
                          {{ item.user.prenom }} :
                      {% endif %}

                      {% if isImage %}
                          📷 Photo
                      {% else %}
                          {{ item.lastMessage }}
                      {% endif %}

                  {% else %}
                      Commencer une conversation
                  {% endif %}

                  </div>


              </div>
          </div>

          {% endfor %}


          </div>

    </div>
