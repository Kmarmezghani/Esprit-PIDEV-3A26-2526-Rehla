                <span>Administration</span>
            </a></li>
            {% endif %}
            <li><hr class="dropdown-divider my-1"></li>
            <li>
                <a class="dropdown-item d-flex align-items-center gap-2 text-danger" href="#"
                   onclick="confirmLogoutHome(event)"
                   style="padding:8px 16px; font-size:14px;">
                    <i class="fa fa-sign-out" style="width:18px;"></i>
                    <span>Déconnexion</span>
                </a>
            </li>
        </ul>
    </li>
    {% else %}
    {# ── Non connecté ── #}
    <li class="nav-item ms-2">
        <a href="{{ path('app_register') }}" class="nav-link">
            <i class="fa fa-user-plus"></i> &nbsp;S'inscrire
        </a>
    </li>
    {% endif %}
</ul>
</div>
		</div>
	</nav>
<section class="hero-wrap hero-wrap-2 js-fullheight" style="background-image: url('{{ asset('assets/images/bg_1.jpg')}}');">
  <div class="overlay"></div>
  <div class="container">
    <div class="row no-gutters slider-text js-fullheight align-items-end justify-content-center">
      <div class="col-md-9 ftco-animate pb-5 text-center">
         <p class="breadcrumbs"><span class="mr-2"><a href="{{ path('home') }}">Accueil <i class="fa fa-chevron-right"></i></a></span> <span>Destinations <i class="fa fa-chevron-right"></i></span></p>
         <h1 class="mb-0 bread">Explore Countries</h1>
     </div>
 </div>
</div>
</section>

<section class="ftco-section">
   <div class="container">
    <div class="row">
    {% for pays in paysList %}
       <div class="col-md-4 ftco-animate">
          <div class="project-wrap" style="position: relative; overflow: hidden; height: 100%;">
             <a href="{{ path('app_destination_villes', {'id': pays.id}) }}" style="display: block; color: inherit; text-decoration: none; height: 100%;">
                <div class="img" style="background-image: url('{{ asset('assets/images/place-' ~ (loop.index % 5 + 1) ~ '.jpg') }}');">
                    <span class="price">{{ pays.villes|length }} Cities</span>
                </div>
                <div class="text p-4 text-center">
                    <h3>{{ pays.nom }}</h3>
                    <p class="location"><span class="fa fa-globe"></span> {{ pays.visitCount|default(0) }} Visites</p>
                    
                    {% set categories = [] %}
                    {% set seasons = [] %}
                    {% for ville in pays.villes %}
                        {% if ville.typeTourisme and ville.typeTourisme not in categories %}
                            {% set categories = categories|merge([ville.typeTourisme]) %}
                        {% endif %}
                        {% if ville.saison and ville.saison not in seasons %}
                            {% set seasons = seasons|merge([ville.saison]) %}
                        {% endif %}
                    {% endfor %}

                    <div class="mb-3">
                        {% for cat in categories|slice(0, 3) %}
                            <span class="badge badge-primary px-2 py-1 mb-1" style="background-color: #223f91; color: #ffffff; border-radius: 20px; font-size: 11px;">
                                <i class="fa fa-tag"></i> {{ cat }}
                            </span>
                        {% endfor %}
                        {% for sea in seasons|slice(0, 2) %}
                            <span class="badge badge-info px-2 py-1 mb-1" style="background-color: #e8f0fe; color: #223f91; border-radius: 20px; font-size: 11px; border: 1px solid #223f91;">
                                <i class="fa fa-sun-o"></i> {{ sea }}
                            </span>
                        {% endfor %}
                    </div>

                    <p style="font-size: 14px;">{{ pays.description|slice(0, 100) }}{{ pays.description|length > 100 ? '...' : '' }}</p>
               </div>
            </a>
       </div>
    </div>
    {% else %}
        <div class="col-md-12 text-center">
            <p>Aucun pays trouvé pour le moment.</p>
        </div>
    {% endfor %}
</div>

    {# ── Pagination ── #}
    {% if paysList.pageCount > 1 %}
    <div class="row mt-5">
        <div class="col-md-12 text-center">
            <div class="block-27">
                <ul>
                    {% if paysList.currentPageNumber > 1 %}
                        <li><a href="{{ path('app_destination', {'page': paysList.currentPageNumber - 1}) }}">&lt;</a></li>
                    {% endif %}

                    {% for page in 1..paysList.pageCount %}
                        {% if page == paysList.currentPageNumber %}
                            <li class="active"><span>{{ page }}</span></li>
                        {% else %}
                            <li><a href="{{ path('app_destination', {'page': page}) }}">{{ page }}</a></li>
                        {% endif %}
                    {% endfor %}

                    {% if paysList.currentPageNumber < paysList.pageCount %}
                        <li><a href="{{ path('app_destination', {'page': paysList.currentPageNumber + 1}) }}">&gt;</a></li>
                    {% endif %}
                </ul>
            </div>
        </div>
    </div>
    {% endif %}

</div>
</section>

