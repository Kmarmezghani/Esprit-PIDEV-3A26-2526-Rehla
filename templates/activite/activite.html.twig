                border-radius: 12px;
                padding: 8px 16px;
                font-weight: 700;
                text-decoration: none;
            "
        >
            Rejoindre liste d’attente
        </a>
    {% endif %}

    <span style="
        background: #f8d7da;
        color: #dc3545;
        padding: 3px 8px;
        border-radius: 10px;
        font-size: 12px;
    ">
        Complet
    </span>

