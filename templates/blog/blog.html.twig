document.addEventListener("click", function (e) {

    // ✏️ ouvrir edit
    if (e.target.classList.contains("edit-comment")) {

        const box = e.target.closest(".comment-box");

        box.querySelector(".comment-text").style.display = "none";
        box.querySelector(".edit-zone").style.display = "block";

        // 🔥 auto focus
        box.querySelector(".edit-input").focus();
    }

    // ❌ cancel
    if (e.target.classList.contains("cancel-edit")) {

        const box = e.target.closest(".comment-box");

        box.querySelector(".edit-zone").style.display = "none";
        box.querySelector(".comment-text").style.display = "block";
    }

    // ✅ save edit
    if (e.target.classList.contains("save-edit")) {

        const btn = e.target;
        const box = btn.closest(".comment-box");
        const input = box.querySelector(".edit-input");

        const value = (input.value || "").trim();
        const url = btn.getAttribute("data-url");

        // ❌ vide
        if (value === "") {
            Swal.fire({
                icon: 'error',
                text: 'Le commentaire est obligatoire',
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 2500,
                background: '#fff1f2',
                color: '#991b1b',
                iconColor: '#ef4444',
                  customClass: {
                    popup: 'red-toast'
                }
            });
            return;
        }

        // ⚠️ trop court
        if (value.length < 3) {
            Swal.fire({
                icon: 'warning',
                text: 'Minimum 3 caractères',
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 2500,
                background: '#fff7ed',
                color: '#9a3412',
                iconColor: '#f59e0b',
                customClass: {
                    popup: 'orange-toast'
                }
            });
            return;
        }

        // ❌ regex
        if (!/^[a-zA-Z0-9]/.test(value)) {
            Swal.fire({
                icon: 'error',
                text: 'Doit commencer par lettre ou chiffre',
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 2500,
                background: '#fff1f2',
                color: '#991b1b',
                iconColor: '#ef4444',
                customClass: {
                    popup: 'red-toast'
                }
            });
            return;
        }

        fetch(url, {
            method: "POST",
            headers: {
                "Content-Type": "application/x-www-form-urlencoded"
            },
            body: "contenu=" + encodeURIComponent(value)
        })
        .then(res => res.json())
        .then(data => {

            box.querySelector(".comment-text").textContent = data.contenu;
            box.querySelector(".edit-zone").style.display = "none";
            box.querySelector(".comment-text").style.display = "block";

            // ✅ success toast
            Swal.fire({
                icon: 'success',
                text: 'Commentaire modifié avec succès',
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 2000,
                background: '#ecfdf5',
                color: '#065f46',
                iconColor: '#10b981',
                 customClass: {
                popup: 'green-toast'
            }
            });

        });

    }

});

