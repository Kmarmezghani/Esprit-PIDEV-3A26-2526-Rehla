{% extends 'base.html.twig' %}

{% block title %}Attractions à {{ ville.nom }} - Rehla{% endblock %}

{% block body %}
	<nav class="navbar navbar-expand-lg navbar-dark ftco_navbar bg-dark ftco-navbar-light" id="ftco-navbar">
		<div class="container">
			<a class="navbar-brand" href="{{ path('home') }}">
                <img src="{{ asset('assets/images/IMG_20260125_122708_191-removebg-preview.png') }}" alt="Rehla Logo" class="logo-default" style="height:50px; display:block;">
                <img src="{{ asset('assets/images/bluelogo.png') }}" alt="Rehla Logo" class="logo-scrolled" style="height:50px; display:none;">
                <span style="display: block; font-size: 14px ; color: #223f91;">Explore the World</span>
            </a>
			<button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#ftco-nav" aria-controls="ftco-nav" aria-expanded="false" aria-label="Toggle navigation">
				<span class="oi oi-menu"></span> Menu
			</button>

			<div class="collapse navbar-collapse" id="ftco-nav">
                <ul class="navbar-nav ml-auto">
                    <li class="nav-item"><a href="{{ path('home') }}" class="nav-link">Accueil</a></li>
                    <li class="nav-item"><a href="#" class="nav-link">À propos</a></li>
                    <li class="nav-item active"><a href="{{ path('app_destination') }}" class="nav-link">Destinations</a></li>
                    <li class="nav-item"><a href="{{ path('activite') }}" class="nav-link">Activités</a></li>
                    <li class="nav-item"><a href="#" class="nav-link">Hôtels</a></li>
                    <li class="nav-item"><a href="{{ path('blog') }}" class="nav-link">Blog</a></li>

                    {% if app.session.get('user_id') %}
                    <li class="nav-item dropdown ms-2 d-flex align-items-center">
                        <a class="nav-link dropdown-toggle p-0 d-flex align-items-center" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            {% if app.session.get('user_photo') %}
                                <img src="{{ asset(app.session.get('user_photo')) }}" alt="Profil" class="rounded-circle" style="width:35px; height:35px; object-fit:cover;">
                            {% else %}
                                <span style="display:inline-block;width:35px;height:35px;border-radius:50%;overflow:hidden;vertical-align:middle;">{{ avatar_svg(app.session.get('user_prenom') ?? '', app.session.get('user_nom') ?? '') | raw }}</span>
                            {% endif %}
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown" style="min-width:210px; border-radius:12px; border:none; box-shadow:0 8px 30px rgba(0,0,0,0.12); padding:8px 0;">
                            <li><span class="dropdown-item-text text-muted" style="font-size:11px; padding:6px 16px;">Connecté en tant que<br><strong style="color:#223f91;">{{ app.session.get('user_prenom') }} {{ app.session.get('user_nom') }}</strong></span></li>
                            <li><hr class="dropdown-divider my-1"></li>
                            <li><a class="dropdown-item d-flex align-items-center gap-2" href="{{ path('app_profile') }}" style="padding:8px 16px; font-size:14px;"><i class="fa fa-user" style="width:18px; color:#223f91;"></i><span>Mon profil</span></a></li>
                            <li><a class="dropdown-item d-flex align-items-center gap-2" href="{{ path('app_preferences') }}" style="padding:8px 16px; font-size:14px;"><i class="fa fa-sliders" style="width:18px; color:#223f91;"></i><span>Mes préférences</span></a></li>
                            <li><a class="dropdown-item d-flex align-items-center gap-2" href="{{ path('mes_activites') }}" style="padding:8px 16px; font-size:14px;"><i class="fa fa-compass" style="width:18px; color:#223f91;"></i><span>Mes activités</span></a></li>
                            <li><a class="dropdown-item d-flex align-items-center gap-2" href="{{ path('mes_reservations') }}" style="padding:8px 16px; font-size:14px;"><i class="fa fa-calendar" style="width:18px; color:#223f91;"></i><span>Mes réservations</span></a></li>
                            {% if app.session.get('user_role') == 'ADMIN' %}
                            <li><hr class="dropdown-divider my-1"></li>
                            <li><a class="dropdown-item d-flex align-items-center gap-2 text-primary" href="{{ path('admin_users') }}" style="padding:8px 16px; font-size:14px;"><i class="fa fa-cogs" style="width:18px;"></i><span>Administration</span></a></li>
                            {% endif %}
                            <li><hr class="dropdown-divider my-1"></li>
                            <li><a class="dropdown-item d-flex align-items-center gap-2 text-danger" href="#" onclick="confirmLogoutHome(event)" style="padding:8px 16px; font-size:14px;"><i class="fa fa-sign-out" style="width:18px;"></i><span>Déconnexion</span></a></li>
                        </ul>
                    </li>
                    {% else %}
                    <li class="nav-item ms-2"><a href="{{ path('app_register') }}" class="nav-link"><i class="fa fa-user-plus"></i> &nbsp;S'inscrire</a></li>
                    {% endif %}
                </ul>
            </div>
		</div>
	</nav>

<section class="hero-wrap hero-wrap-2 js-fullheight" style="background-image: url('{{ ville.image ? asset('uploads/destinations/' ~ ville.image) : asset('assets/images/bg_1.jpg') }}');">
  <div class="overlay"></div>
  <div class="container">
    <div class="row no-gutters slider-text js-fullheight align-items-end justify-content-center">
      <div class="col-md-9 ftco-animate pb-5 text-center">
         <p class="breadcrumbs">
            <span class="mr-2"><a href="{{ path('home') }}">Accueil <i class="fa fa-chevron-right"></i></a></span>
            <span class="mr-2"><a href="{{ path('app_destination') }}">Destinations <i class="fa fa-chevron-right"></i></a></span>
            <span class="mr-2"><a href="{{ path('app_destination_villes', {'id': ville.paysId.id}) }}">{{ ville.paysId.nom }} <i class="fa fa-chevron-right"></i></a></span>
            <span>{{ ville.nom }} <i class="fa fa-chevron-right"></i></span>
         </p>
         <h1 class="mb-0 bread">Attractions à {{ ville.nom }}</h1>
     </div>
 </div>
</div>
</section>

<section class="ftco-section">
   <div class="container">
    <div class="row">
    {% for attraction in attractions %}
       <div class="col-md-4 ftco-animate">
          <div class="project-wrap">
             <div class="img" style="background-image: url('{{ asset('assets/images/destination-' ~ (loop.index % 9 + 1) ~ '.jpg') }}');">
                <span class="price">${{ attraction.prix }}/personne</span>
            </div>
            <div class="text p-4">
                <div class="mb-2 d-flex justify-content-between align-items-center">
                    <span class="badge badge-primary px-2 py-1" style="background-color: #223f91; border-radius: 20px; font-size: 11px;">
                        <i class="fa fa-tag"></i> Attraction : {{ attraction.type }}
                    </span>
                    
                    {% if attraction.isOpenNow %}
                        <span class="badge px-2 py-1" style="background-color: #e6f4ea; color: #1e8e3e; border: 1px solid #1e8e3e; border-radius: 20px; font-size: 10px; font-weight: bold;">
                            <i class="fa fa-circle" style="font-size: 8px; vertical-align: middle; margin-right: 2px;"></i> Ouvert actuellement
                        </span>
                    {% else %}
                        <span class="badge px-2 py-1" style="background-color: #fce8e6; color: #d93025; border: 1px solid #d93025; border-radius: 20px; font-size: 10px; font-weight: bold;">
                            <i class="fa fa-circle" style="font-size: 8px; vertical-align: middle; margin-right: 2px;"></i> Fermé
                        </span>
                    {% endif %}
                </div>
                <h3>{{ attraction.nom }}</h3>
                <p class="location"><span class="fa fa-map-marker"></span> {{ ville.nom }}, {{ ville.paysId.nom }}</p>
                <p>{{ attraction.description|slice(0, 100) }}...</p>
                <ul>
                   <li><span class="fa fa-clock-o"></span> {{ attraction.heureOuverture|date('H:i') }} - {{ attraction.heureFermeture|date('H:i') }}</li>
               </ul>
           </div>
       </div>
    </div>
    {% else %}
        <div class="col-md-12 text-center">
            <p>Aucune attraction trouvée pour cette ville.</p>
        </div>
    {% endfor %}
</div>

    {# ── Pagination ── #}
    {% if attractions.pageCount > 1 %}
    <div class="row mt-5">
        <div class="col-md-12 text-center">
            <div class="block-27">
                <ul>
                    {% if attractions.currentPageNumber > 1 %}
                        <li><a href="{{ path('app_destination_attractions', {'id': ville.id, 'page': attractions.currentPageNumber - 1}) }}">&lt;</a></li>
                    {% endif %}

                    {% for page in 1..attractions.pageCount %}
                        {% if page == attractions.currentPageNumber %}
                            <li class="active"><span>{{ page }}</span></li>
                        {% else %}
                            <li><a href="{{ path('app_destination_attractions', {'id': ville.id, 'page': page}) }}">{{ page }}</a></li>
                        {% endif %}
                    {% endfor %}

                    {% if attractions.currentPageNumber < attractions.pageCount %}
                        <li><a href="{{ path('app_destination_attractions', {'id': ville.id, 'page': attractions.currentPageNumber + 1}) }}">&gt;</a></li>
                    {% endif %}
                </ul>
            </div>
        </div>
    </div>
    {% endif %}

    {# ── Similar Cities Section ── #}
    {% if similarCities is not empty and similarCities|length > 0 %}
    <section class="ftco-section" style="background: #f8f9fa;">
        <div class="container">
            <div class="row mb-4">
                <div class="col-md-12 text-center">
                    <h2 style="font-weight: 700; color: #223f91; margin-bottom: 10px;">
                        <i class="fa fa-map-marker-alt me-2"></i> Destinations similaires à {{ ville.nom }}
                    </h2>
                    <p style="color: #666;">Basé sur le type de tourisme, la saison, et les caractéristiques</p>
                </div>
            </div>
            <div class="row">
                {% for similar in similarCities %}
                    <div class="col-md-3 ftco-animate">
                        <div class="project-wrap" style="position: relative; overflow: hidden; height: 100%;">
                            <a href="{{ path('app_destination_attractions', {'id': similar.city.id}) }}" style="display: block; color: inherit; text-decoration: none; height: 100%;">
                                <div class="img" style="background-image: url('{{ similar.city.image ? asset('uploads/destinations/' ~ similar.city.image) : asset('assets/images/place-' ~ (loop.index % 5 + 1) ~ '.jpg') }}');">
                                    <span class="price" style="background: rgba(34,63,145,0.9);">
                                        {{ (similar.similarity * 100)|round(0) }}% similaire
                                    </span>
                                </div>
                                <div class="text p-4 text-center">
                                    <h3>{{ similar.city.nom }}</h3>
                                    <p class="location"><span class="fa fa-map-marker"></span> {{ similar.city.paysId.nom }}</p>
                                    <div class="mb-2">
                                        <span class="badge badge-primary px-2 py-1" style="background-color: #223f91; border-radius: 20px; font-size: 11px;">
                                            <i class="fa fa-tag"></i> {{ similar.city.typeTourisme }}
                                        </span>
                                        <span class="badge badge-info px-2 py-1" style="background-color: #e8f0fe; color: #223f91; border-radius: 20px; font-size: 11px; border: 1px solid #223f91;">
                                            <i class="fa fa-sun-o"></i> {{ similar.city.saison }}
                                        </span>
                                    </div>
                                    <p style="font-size: 12px; color: #666;">{{ similar.city.attractions|length }} attractions</p>
                                </div>
                            </a>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>
    {% endif %}

</div>
</section>

<footer class="ftco-footer bg-bottom ftco-no-pt" style="background-image: url('{{ asset('assets/images/bg_3.jpg')}}');">
  <div class="container">
    <div class="row mb-5">
      <div class="col-md pt-5">
        <div class="ftco-footer-widget pt-md-5 mb-4">
          <h2 class="ftco-heading-2">About Rehla</h2>
          <p>Explore the world's most beautiful destinations and attractions with ease.</p>
          <ul class="ftco-footer-social list-unstyled float-md-left float-lft">
            <li class="ftco-animate"><a href="#"><span class="fa fa-twitter"></span></a></li>
            <li class="ftco-animate"><a href="#"><span class="fa fa-facebook"></span></a></li>
            <li class="ftco-animate"><a href="#"><span class="fa fa-instagram"></span></a></li>
        </ul>
    </div>
</div>
<div class="col-md pt-5 border-left">
    <div class="ftco-footer-widget pt-md-5 mb-4 ml-md-5">
      <h2 class="ftco-heading-2">Information</h2>
      <ul class="list-unstyled">
        <li><a href="#" class="py-2 d-block">Online Enquiry</a></li>
        <li><a href="#" class="py-2 d-block">General Enquiries</a></li>
        <li><a href="#" class="py-2 d-block">Booking Conditions</a></li>
        <li><a href="#" class="py-2 d-block">Privacy and Policy</a></li>
        <li><a href="#" class="py-2 d-block">Refund Policy</a></li>
        <li><a href="#" class="py-2 d-block">Call Us</a></li>
    </ul>
</div>
</div>
<div class="col-md pt-5 border-left">
   <div class="ftco-footer-widget pt-md-5 mb-4">
      <h2 class="ftco-heading-2">Experience</h2>
      <ul class="list-unstyled">
        <li><a href="#" class="py-2 d-block">Adventure</a></li>
        <li><a href="#" class="py-2 d-block">Hotel and Restaurant</a></li>
        <li><a href="#" class="py-2 d-block">Beach</a></li>
        <li><a href="#" class="py-2 d-block">Nature</a></li>
        <li><a href="#" class="py-2 d-block">Camping</a></li>
        <li><a href="#" class="py-2 d-block">Party</a></li>
    </ul>
</div>
</div>
<div class="col-md pt-5 border-left">
    <div class="ftco-footer-widget pt-md-5 mb-4">
       <h2 class="ftco-heading-2">Have Question?</h2>
       <div class="block-23 mb-3">
         <ul>
           <li><span class="icon fa fa-map-marker"></span><span class="text">Tunis, Tunisie</span></li>
           <li><a href="#"><span class="icon fa fa-phone"></span><span class="text">+216 12 345 678</span></a></li>
           <li><a href="#"><span class="icon fa fa-paper-plane"></span><span class="text">contact@rehla.tn</span></a></li>
       </ul>
   </div>
</div>
</div>
</div>
<div class="row">
  <div class="col-md-12 text-center">
    <p>Copyright &copy;<script>document.write(new Date().getFullYear());</script> All rights reserved | Rehla Travel Agency</p>
  </div>
</div>
</div>
</footer>

<!-- loader -->
<div id="ftco-loader" class="show fullscreen"><svg class="circular" width="48px" height="48px"><circle class="path-bg" cx="24" cy="24" r="22" fill="none" stroke-width="4" stroke="#eeeeee"/><circle class="path" cx="24" cy="24" r="22" fill="none" stroke-width="4" stroke-miterlimit="10" stroke="#F96D00"/></svg></div>

<form id="logoutFormHome" method="get" action="{{ path('app_logout') }}" style="display:none;"></form>

<script>
function confirmLogoutHome(e) {
    e.preventDefault();
    Swal.fire({
        title: 'Déconnexion',
        text: 'Êtes-vous sûr de vouloir vous déconnecter ?',
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#223f91',
        cancelButtonColor: '#6c757d',
        confirmButtonText: 'Oui, me déconnecter',
        cancelButtonText: 'Annuler'
    }).then((result) => {
        if (result.isConfirmed) {
            document.getElementById('logoutFormHome').submit();
        }
    });
}
</script>
{% endblock %}
