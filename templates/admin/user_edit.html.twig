{% extends 'adminbase.html.twig' %}

{% block title %}Modifier l'utilisateur – Rehla Admin{% endblock %}

{% block sidebar %}
  {% include 'admin/Partials/sidebar.html.twig' %}
{% endblock %}

{% block navbar %}
  {% include 'admin/Partials/navbar.html.twig' %}
{% endblock %}

{% block body %}

<div class="row justify-content-center">
  <div class="col-md-8">

    <div class="d-flex align-items-center mb-4">
        <a href="{{ path('admin_users') }}" class="btn btn-outline-secondary btn-sm me-3">
            <i class="bx bx-arrow-back me-1"></i> Retour
        </a>
        <h4 class="mb-0">
            <i class="bx bx-shield-alt-2 me-2" style="color:#223f91;"></i>
            Modifier : {{ personne.prenom }} {{ personne.nom }}
        </h4>
    </div>

    {# ── Fiche utilisateur (lecture seule) ── #}
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
            <h6 class="mb-0 text-muted">
                <i class="bx bx-user me-2"></i>Informations personnelles (lecture seule)
            </h6>
        </div>
        <div class="card-body">
            <div class="d-flex align-items-center mb-3">
                {% if personne.profile_photo %}
                    <img src="{{ personne.profile_photo }}" alt="Photo"
                         class="rounded-circle me-3"
                         style="width:60px;height:60px;object-fit:cover;border:2px solid #223f91;">
                {% else %}
                    <img src="{{ asset('assets/images/default-user.png') }}" alt="Photo"
                         class="rounded-circle me-3"
                         style="width:60px;height:60px;object-fit:cover;border:2px solid #223f91;">
                {% endif %}
                <div>
                    <h5 class="mb-0">{{ personne.prenom }} {{ personne.nom }}</h5>
                    <small class="text-muted">{{ personne.email }}</small>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4">
                    <label class="form-label fw-semibold text-muted small">Téléphone</label>
                    <p class="mb-0">{{ personne.telephone ?? '–' }}</p>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold text-muted small">Date d'inscription</label>
                    <p class="mb-0">{{ personne.dateInscription ? personne.dateInscription|date('d/m/Y') : '–' }}</p>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold text-muted small">Notifications SMS</label>
                    <p class="mb-0">{{ personne.notifSmsActive ? 'Activées' : 'Désactivées' }}</p>
                </div>
            </div>
        </div>
    </div>

    {# ── Formulaire : rôle + statut uniquement ── #}
    <div class="card shadow-sm">
        <div class="card-header" style="background:#223f91;">
            <h5 class="mb-0 text-white">
                <i class="bx bx-shield-alt-2 me-2"></i>Modifier le rôle et le statut
            </h5>
        </div>
        <div class="card-body p-4">
            <form method="post" action="{{ path('admin_user_edit', {id: personne.id}) }}">

                <div class="row mb-4">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Rôle</label>
                        <select name="role" class="form-select" id="roleSelect" onchange="toggleGuideFields()">
                            <option value="CLIENT" {% if personne.role == 'CLIENT' %}selected{% endif %}>CLIENT</option>
                            <option value="GUIDE"  {% if personne.role == 'GUIDE'  %}selected{% endif %}>GUIDE</option>
                            <option value="ADMIN"  {% if personne.role == 'ADMIN'  %}selected{% endif %}>ADMIN</option>
                        </select>
                        <small class="text-muted">Définit les permissions de l'utilisateur.</small>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Statut du compte</label>
                        <select name="statutCompte" class="form-select">
                            <option value="ACTIF"    {% if personne.statutCompte == 'ACTIF'    %}selected{% endif %}>ACTIF</option>
                            <option value="INACTIF"  {% if personne.statutCompte == 'INACTIF'  %}selected{% endif %}>INACTIF</option>
                            <option value="SUSPENDU" {% if personne.statutCompte == 'SUSPENDU' %}selected{% endif %}>SUSPENDU</option>
                        </select>
                        <small class="text-muted">SUSPENDU bloque la connexion de cet utilisateur.</small>
                    </div>
                </div>

                {# ── Champs Guide ── #}
                <div id="guideFields" style="display:{% if personne.role == 'GUIDE' %}block{% else %}none{% endif %};">
                    <div class="alert alert-info py-2 px-3 mb-3" style="font-size:13px; border-radius:8px;">
                        <i class="bx bx-info-circle me-1"></i>
                        Ces champs sont requis pour le rôle GUIDE.
                        {% if guide %}Enregistré actuellement dans la table guide.{% else %}Aucune entrée guide existante.{% endif %}
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Spécialité</label>
                            <input type="text" name="specialite" class="form-control"
                                   placeholder="ex: Randonnée, Culture…"
                                   value="{{ guide ? guide.specialite : '' }}">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Langues parlées</label>
                            <input type="text" name="langues" class="form-control"
                                   placeholder="ex: Français, Anglais…"
                                   value="{{ guide ? guide.langues : '' }}">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Expérience</label>
                            <input type="text" name="experience" class="form-control"
                                   placeholder="ex: 5 ans, Expert…"
                                   value="{{ guide ? guide.experience : '' }}">
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn"
                            style="background:#223f91; color:#fff; border-radius:8px; padding:10px 28px;">
                        <i class="bx bx-save me-2"></i>Enregistrer
                    </button>
                    <a href="{{ path('admin_users') }}" class="btn btn-outline-secondary"
                       style="border-radius:8px;">
                        Annuler
                    </a>
                </div>

            </form>
        </div>
    </div>

  </div>
</div>

{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
function toggleGuideFields() {
    const role = document.getElementById('roleSelect').value;
    document.getElementById('guideFields').style.display = role === 'GUIDE' ? 'block' : 'none';
}
</script>
{% endblock %}
