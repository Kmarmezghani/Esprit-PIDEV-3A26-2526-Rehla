<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.CountryDetailController" stylesheets="@/Frontoffice/css/profile-menu.css">
    <children>
        <BorderPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <!-- Top Navigation Bar (Standardized) -->
            <top>
                <HBox alignment="CENTER_LEFT" prefHeight="70.0" style="-fx-background-color: #223f91;" BorderPane.alignment="CENTER">
                    <children>
                        <!-- Logo -->
                        <ImageView fitHeight="60.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../Backoffice/icons/IMG_20260125_122708_191-removebg-preview.png" />
                            </image>
                        </ImageView>

                        <!-- Back Button (Specific to Detail Page) -->
                        <Button onAction="#goToHome" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14; -fx-cursor: hand;" text="&#9664; Back">
                            <HBox.margin><Insets left="10.0"/></HBox.margin>
                        </Button>

                        <!-- Spacer left -->
                        <Region HBox.hgrow="ALWAYS"/>

                        <!-- Center nav -->
                        <HBox alignment="CENTER" spacing="22.0">
                            <Button onAction="#goToHome" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 16; -fx-cursor: hand;" text="Home" />
                            <!-- Active state for Destinations -->
                            <Button style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-font-size: 16; -fx-cursor: hand; -fx-background-radius: 20; -fx-padding: 5 15;" text="Destinations" />
                            <Button style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 16; -fx-cursor: hand;" text="Posts" />
                            <Button style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 16; -fx-cursor: hand;" text="Activities" />
                            <Button style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 16; -fx-cursor: hand;" text="About" />
                        </HBox>

                        <!-- Spacer right -->
                        <Region HBox.hgrow="ALWAYS"/>

                        <!-- NOTIF -->
                        <Button styleClass="iconBtn" text="&#128276;">
                            <HBox.margin><Insets right="10.0"/></HBox.margin>
                        </Button>

                        <!-- PROFILE -->
                        <Button fx:id="btnProfile" styleClass="iconBtn" text="&#128100;">
                            <HBox.margin><Insets right="20.0"/></HBox.margin>
                            <contextMenu>
                                <ContextMenu fx:id="profileMenu" styleClass="profileMenu">
                                    <items>
                                        <MenuItem onAction="#goToMyProfile" text="My Profile">
                                            <graphic><SVGPath styleClass="menuIcon" content="M12 12c2.21 0 4-1.79 4-4S14.21 4 12 4 8 5.79 8 8s1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></graphic>
                                        </MenuItem>
                                        <MenuItem onAction="#goToMyPosts" text="My Posts">
                                            <graphic><SVGPath styleClass="menuIcon" content="M9 6l1.5-2h3L15 6h3a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h3zm3 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zm0-2.2a1.8 1.8 0 1 1 0-3.6 1.8 1.8 0 0 1 0 3.6z"/></graphic>
                                        </MenuItem>
                                        <MenuItem onAction="#goToMyReservations" text="My Reservations">
                                            <graphic><SVGPath styleClass="menuIcon" content="M7 2v2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-2V2h-2v2H9V2H7zm12 6H5V6h14v2zM7 12h3v3H7v-3zm4 0h3v3h-3v-3zm4 0h3v3h-3v-3z"/></graphic>
                                        </MenuItem>
                                        <SeparatorMenuItem/>
                                        <MenuItem onAction="#handleLogout" text="Logout">
                                            <graphic><SVGPath styleClass="menuIconLogout" content="M10 17l1.41-1.41L9.83 14H20v-2H9.83l1.58-1.59L10 9l-5 5 5 5zM4 21h2V3H4v18z"/></graphic>
                                        </MenuItem>
                                    </items>
                                </ContextMenu>
                            </contextMenu>
                        </Button>

                        <!-- Window Controls -->
                        <Button onAction="#minwindow" style="-fx-font-size: 20; -fx-text-fill: white;" styleClass="button4" stylesheets="@../Backoffice/css/styling.css" text="&#8722;" />
                        <Button onAction="#maxwindow" style="-fx-font-size: 20; -fx-text-fill: white;" styleClass="button4" stylesheets="@../Backoffice/css/styling.css" text="&#9633;" />
                        <Button onAction="#closewindow" style="-fx-font-size: 16; -fx-text-fill: white;" styleClass="button3" stylesheets="@../Backoffice/css/styling.css" text="&#10005;">
                            <HBox.margin><Insets top="4.0"/></HBox.margin>
                        </Button>
                    </children>
                    <padding>
                        <Insets left="30.0" right="30.0" />
                    </padding>
                </HBox>
            </top>

            <!-- Main Content -->
            <center>
                <ScrollPane fitToWidth="true" style="-fx-background-color: #ffffff;" BorderPane.alignment="CENTER">
                    <content>
                        <VBox spacing="30.0" style="-fx-background-color: #ffffff;">
                            <!-- Country Header -->
                            <VBox alignment="CENTER" spacing="15.0" style="-fx-background-color: #ffffff; -fx-padding: 0;">
                                <ImageView fx:id="countryImageView" fitHeight="450" fitWidth="1000" pickOnBounds="true" preserveRatio="false">
                                </ImageView>
                                <VBox alignment="CENTER" spacing="0.0" style="-fx-background-color: #ffffff; -fx-padding: 5;">
                                    <Label fx:id="countryFlagLabel" text="&#127467;&#127479;" textFill="WHITE">
                                        <font>
                                            <Font size="80.0" />
                                        </font>
                                    </Label>
                                    <Label fx:id="countryNameLabel" text="France" textFill="#223f91" style="-fx-effect: dropshadow(gaussian, rgba(255,255,255,0.8), 10, 0, 0, 2);">
                                        <font>
                                            <Font name="System Bold" size="56.0" />
                                        </font>
                                    </Label>
                                    <Label fx:id="countryDescriptionLabel" text="Description of the country..." textFill="#223f91" wrapText="true">
                                        <font>
                                            <Font size="16.0" />
                                        </font>
                                        <VBox.margin>
                                            <Insets left="100.0" right="100.0" />
                                        </VBox.margin>
                                    </Label>
                                </VBox>
                            </VBox>
                            
                            <!-- Cities Section -->
                            <VBox spacing="20.0" style="-fx-background-color: #ffffff;">
                                <padding>
                                    <Insets bottom="40.0" left="40.0" right="40.0" />
                                </padding>
                                
                                <Label fx:id="citiesSectionLabel" text="&#127961; Explore Cities" textFill="#223f91">
                                    <font>
                                        <Font name="System Bold" size="36.0" />
                                    </font>
                                </Label>
                                <Label fx:id="citiesCountLabel" text="Choose from 5 amazing cities" textFill="#666">
                                    <font>
                                        <Font size="18.0" />
                                    </font>
                                </Label>
                                
                                <FlowPane fx:id="citiesFlowPane" hgap="30.0" vgap="30.0">
                                    <padding>
                                        <Insets top="20.0" />
                                    </padding>
                                </FlowPane>
                            </VBox>
                            
                            <!-- Footer -->
                            <VBox alignment="CENTER" spacing="8.0" style="-fx-background-color: #223f91; -fx-padding: 20;">
                                <Label text="Rehla - Your Travel Companion" textFill="WHITE">
                                    <font>
                                        <Font name="System Bold" size="16.0" />
                                    </font>
                                </Label>
                                <Label text="&#169; 2026 Rehla. All rights reserved." textFill="#cccccc">
                                    <font>
                                        <Font size="12.0" />
                                    </font>
                                </Label>
                            </VBox>
                        </VBox>
                    </content>
                </ScrollPane>
            </center>
        </BorderPane>
    </children>
</AnchorPane>