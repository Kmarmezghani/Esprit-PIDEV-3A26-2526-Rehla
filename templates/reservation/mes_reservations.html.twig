                    <a class="nav-link dropdown-toggle p-0 d-flex align-items-center"
                       href="#" id="userDropdown" role="button"
                       data-bs-toggle="dropdown" aria-expanded="false">
                        {% if app.session.get('user_photo') %}
                            <img src="{{ app.session.get('user_photo') }}" alt="Photo de profil"
                                 class="rounded-circle" style="width:35px; height:35px; object-fit:cover;">
                        {% else %}
                            <img src="{{ asset('assets/images/default-user.png') }}" alt="Photo de profil"
                                 class="rounded-circle" style="width:35px; height:35px; object-fit:cover;">
                        {% endif %}
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown"
                        style="min-width:210px; border-radius:12px; border:none; box-shadow:0 8px 30px rgba(0,0,0,0.12); padding:8px 0;">
                        <li>
                            <span class="dropdown-item-text text-muted" style="font-size:11px; padding:6px 16px;">
                                Connecté en tant que<br>
                                <strong style="color:#223f91;">{{ app.session.get('user_prenom') }} {{ app.session.get('user_nom') }}</strong>
                            </span>
                        </li>
                        <li><hr class="dropdown-divider my-1"></li>
                        <li><a class="dropdown-item d-flex align-items-center gap-2" href="{{ path('app_profile') }}" style="padding:8px 16px; font-size:14px;">
                            <i class="fa fa-user" style="width:18px; color:#223f91;"></i><span>Mon profil</span>
                        </a></li>
                        <li><a class="dropdown-item d-flex align-items-center gap-2" href="{{ path('app_preferences') }}" style="padding:8px 16px; font-size:14px;">
                            <i class="fa fa-sliders" style="width:18px; color:#223f91;"></i><span>Mes préférences</span>
                        </a></li>
                        {% if app.session.get('user_role') == 'GUIDE' %}
                        <li><a class="dropdown-item d-flex align-items-center gap-2" href="{{ path('mes_activites') }}" style="padding:8px 16px; font-size:14px;">
                            <i class="fa fa-compass" style="width:18px; color:#223f91;"></i><span>Mes activités</span>
                        </a></li>
                        {% endif %}
                        <li><a class="dropdown-item d-flex align-items-center gap-2" href="{{ path('mes_reservations') }}" style="padding:8px 16px; font-size:14px;">
                            <i class="fa fa-calendar" style="width:18px; color:#223f91;"></i><span>Mes réservations</span>
                        </a></li>
                        {% if app.session.get('user_role') == 'ADMIN' %}
                        <li><hr class="dropdown-divider my-1"></li>
                        <li><a class="dropdown-item d-flex align-items-center gap-2 text-primary" href="{{ path('admin_users') }}" style="padding:8px 16px; font-size:14px;">
                            <i class="fa fa-cogs" style="width:18px;"></i><span>Administration</span>
                        </a></li>
                        {% endif %}
                        <li><hr class="dropdown-divider my-1"></li>
                        <li>
                            <a class="dropdown-item d-flex align-items-center gap-2 text-danger" href="#"
                               onclick="confirmLogoutHome(event)" style="padding:8px 16px; font-size:14px;">
                                <i class="fa fa-sign-out" style="width:18px;"></i><span>Déconnexion</span>
                            </a>
                        </li>
                    </ul>
                </li>
                {% else %}
                <li class="nav-item ms-2">
                    <a href="{{ path('app_register') }}" class="nav-link">
                        <i class="fa fa-user-plus"></i> &nbsp;S'inscrire
                    </a>
                </li>
                {% endif %}
            </ul>
        </div>
    </div>
</nav>

<section class="hero-wrap hero-wrap-2 js-fullheight" style="background-image: url('{{ asset('assets/images/bg_1.jpg')}}');">
    <div class="overlay"></div>
    <div class="container">
        <div class="row no-gutters slider-text js-fullheight align-items-end justify-content-center">
            <div class="col-md-9 ftco-animate pb-5 text-center">
                <p class="breadcrumbs">
                    <span class="mr-2"><a href="{{ path('home') }}">Home <i class="fa fa-chevron-right"></i></a></span>
                    <span>Mes Réservations <i class="fa fa-chevron-right"></i></span>
                </p>
                <h1 class="mb-0 bread">Mes Réservations</h1>
            </div>
        </div>
    </div>
</section>

<section class="ftco-section">
    <div class="container">
        <div class="d-flex justify-content-end mb-4">
            <a href="{{ path('ajouter_reservation') }}" class="btn btn-primary px-4 py-2">
                <i class="fa fa-plus"></i> Ajouter une réservation
            </a>
        </div>
        <div class="row">

            <!-- TABLE -->
            <div class="col-12 mb-4">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <h4 class="mb-0">Mes Réservations</h4>
                        <div class="d-flex align-items-center gap-2">
                            <div class="btn-group" role="group" id="currency-toggle">
                                <button type="button" class="btn btn-currency active" data-currency="TND">🇹🇳 TND</button>
                                <button type="button" class="btn btn-currency" data-currency="EUR">🇪🇺 EUR</button>
                                <button type="button" class="btn btn-currency" data-currency="USD">🇺🇸 USD</button>
                            </div>
                            <span id="rate-badge" style="display:none; font-size:11px; background:#f0f4ff; color:#223f91; border-radius:8px; padding:3px 10px;"></span>
                        </div>
                    </div>
                    <div class="table-responsive p-3">
                        <table class="table align-middle table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Date Début</th>
                                    <th>Date Fin</th>
                                    <th>Destination</th>
                                    <th>Tickets</th>
                                    <th>Coût Total</th>
                                    <th>Statut</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for reservation in reservations %}
                                    <tr class="reservation-row" data-id="{{ reservation.id }}" style="cursor:pointer;">
                                        <td>{{ reservation.dateDebut|date('d M Y') }}</td>
                                        <td>{{ reservation.dateFin|date('d M Y') }}</td>
                                        <td>
                                            <i class="fa fa-map-marker text-primary"></i>
                                            {{ reservation.destination ? reservation.destination.nom : 'Non défini' }}
                                        </td>
                                        <td><span>{{ reservation.nb_Tickets }}</span></td>
                                        <td>
                                            <strong class="price-cell" data-tnd="{{ reservation.coutTotal }}">
                                                {{ reservation.coutTotal }} TND
                                            </strong>
                                        </td>
                                        <td>
                                            {% set statut = reservation.statut|lower %}
                                            {% if statut == 'confirmée' %}
                                                <span class="badge rounded-pill px-3 py-2 bg-success"><i class="fa fa-check"></i> Confirmée</span>
                                            {% elseif statut == 'réservée' %}
                                                <span class="badge rounded-pill px-3 py-2 bg-warning text-dark"><i class="fa fa-clock"></i> Réservée</span>
                                            {% elseif statut == 'annulée' %}
                                                <span class="badge rounded-pill px-3 py-2 bg-danger"><i class="fa fa-times"></i> Annulée</span>
                                            {% else %}
                                                <span class="badge rounded-pill px-3 py-2 bg-secondary">{{ reservation.statut }}</span>
                                            {% endif %}
                                        </td>
                                        <td class="text-center" onclick="event.stopPropagation()">
                                            <div class="dropdown">
                                                <button class="btn btn-sm btn-outline-secondary rounded-pill px-3" type="button" data-bs-toggle="dropdown">
                                                    <i class="fa fa-ellipsis-v"></i>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                                                    <li>
                                                        <a class="dropdown-item" href="{{ path('user_reservation_edit', {id: reservation.id}) }}">
                                                            <i class="fa fa-pencil text-primary me-2"></i> Modifier
                                                        </a>
                                                    </li>
                                                    <li><hr class="dropdown-divider"></li>
                                                    <li>
                                                        <a class="dropdown-item text-danger" href="#" onclick="deleteReservation(event, {{ reservation.id }})">
                                                            <i class="fa fa-trash me-2"></i> Supprimer
                                                        </a>
                                                        <form id="delete-form-{{ reservation.id }}" method="post"
                                                              action="{{ path('user_reservation_delete', {id: reservation.id}) }}" style="display:none;">
                                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ reservation.id) }}">
                                                        </form>
                                                    </li>
                                                    {% if reservation.statut|lower == 'réservée' %}
                                                    <li><hr class="dropdown-divider"></li>
                                                    <li>
                                                        <a class="dropdown-item d-flex align-items-center gap-2 text-success"
                                                           href="{{ path('reservation_pay', {id: reservation.id}) }}">
                                                            <i class="fa fa-credit-card" style="width:18px;"></i> Payer
                                                        </a>
                                                    </li>
                                                    {% endif %}
                                                </ul>
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- CALENDAR -->
            <div class="col-12">
                <div class="card p-4">
                    <h4 class="mb-3">Calendrier des Tickets</h4>
                    <div id="calendar"></div>
                </div>
            </div>

        </div>
    </div>
</section>

