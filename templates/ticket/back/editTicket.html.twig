{% extends 'adminbase.html.twig' %}

{% block sidebar %}
  {% include 'admin/partials/sidebar.html.twig' %}
{% endblock %}

{% block navbar %}
  {% include 'admin/partials/navbar.html.twig' %}
{% endblock %}

{% block body %}
<div class="content-wrapper">
  <div class="container-xxl flex-grow-1 container-p-y">

    <div class="row mb-6 gy-6">
      <div class="col-xl">
        <div class="card">
          <div class="card-header">
            <h5 class="mb-0">Modifier Ticket</h5>
          </div>

          <div class="card-body">

            {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

<div class="row">

  <div class="col-md-6 mb-4">
      <label class="form-label">Type</label>
      {{ form_widget(form.type, {'attr': {'class': 'form-select'}}) }}
      {{ form_errors(form.type) }}
  </div>

  <div class="col-md-6 mb-4">
      <label class="form-label">Prix</label>
      {{ form_widget(form.prix, {'attr': {'class': 'form-control'}}) }}
      {{ form_errors(form.prix) }}
  </div>

  <div class="col-md-6 mb-4">
      <label class="form-label">Destination</label>
      {{ form_widget(form.destination, {'attr': {'class': 'form-select'}}) }}
      {{ form_errors(form.destination) }}
  </div>

  <div class="col-md-6 mb-4">
      <label class="form-label">Status</label>
      {{ form_widget(form.statut, {'attr': {'class': 'form-select'}}) }}
      {{ form_errors(form.statut) }}
  </div>

</div>

<div class="mt-3">
    <button type="submit" class="btn btn-primary">
        {{ ticket is defined ? 'Update Ticket' : 'Modifier Ticket' }}
    </button>
</div>

{{ form_end(form) }}


          </div>
        </div>
      </div>
    </div>

  </div>
</div>
{% endblock %}