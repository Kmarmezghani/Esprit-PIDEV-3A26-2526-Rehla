<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.shape.SVGPath?>
<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="Controllers.ClientPostsController" fx:id="root"     stylesheets="@css/reviews.css,@/Frontoffice/css/profile-menu.css,@/Frontoffice/css/home.css,@/Frontoffice/css/blog_styles.css">

    <BorderPane fx:id="mainContent" styleClass="root">

        <!-- ********************************-->
    <!-- HERO / TOP -->
        <top>
            <HBox alignment="CENTER_LEFT"
                  prefHeight="70.0"
                  minHeight="70.0"
                  maxHeight="70.0"
                  styleClass="topBlueBar"
                  BorderPane.alignment="CENTER">

                <children>
                    <ImageView fitHeight="44.0" preserveRatio="true" pickOnBounds="true" styleClass="brandLogo">
                        <image>
                            <Image url="@../Backoffice/icons/IMG_20260125_122708_191-removebg-preview.png"/>
                        </image>
                    </ImageView>

                    <Region HBox.hgrow="ALWAYS"/>

                    <HBox alignment="CENTER" spacing="22.0">
                        <Button onAction="#goToHome" text="Home" styleClass="navBtnBlue"/>
                        <Button onAction="#goToDestinations" text="Destinations" styleClass="navBtnBlue"/>
                        <Button onAction="#goToPosts" text="Posts" styleClass="navBtnBlue"/>
                        <Button onAction="#goToactivities" text="Activities" styleClass="navBtnBlue"/>
                        <Button text="About" styleClass="navBtnBlue"/>
                    </HBox>

                    <Region HBox.hgrow="ALWAYS"/>
                    <HBox spacing="12" alignment="CENTER_RIGHT">
                    <StackPane>
                        <Button fx:id="btnMessage" text="💬" styleClass="iconBtn"/>

                        <Label fx:id="lblMessageBadge"
                               visible="true"
                               StackPane.alignment="TOP_RIGHT"
                               translateX="6"
                               translateY="-6"
                               style="-fx-background-color: #ff3b30;
                  -fx-text-fill: white;
                  -fx-font-size: 7px;
                  -fx-font-weight: bold;
                  -fx-padding: 2 6 2 6;
                  -fx-background-radius: 10;
                  -fx-min-width: 16;
                  -fx-alignment: center;"/>
                    </StackPane>
                    <Button fx:id="btnNotif" onAction="#openNotifications" styleClass="iconBtn" text="🔔">
                        <HBox.margin><Insets right="10.0"/></HBox.margin>
                    </Button>
                    </HBox>
                    <Button fx:id="btnProfile" onAction="#openProfileMenu" styleClass="iconBtn" text="👤">
                        <HBox.margin><Insets right="14.0"/></HBox.margin>
                        <contextMenu>
                            <ContextMenu fx:id="profileMenu" styleClass="profileMenu">
                                <items>

                                    <MenuItem onAction="#goToMyProfile" text="My Profile">
                                        <graphic>
                                            <SVGPath styleClass="menuIcon"
                                                     content="M12 12c2.21 0 4-1.79 4-4S14.21 4 12 4 8 5.79 8 8s1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                                        </graphic>
                                    </MenuItem>

                                    <MenuItem onAction="#goToMyPosts" text="My Posts">
                                        <graphic>
                                            <SVGPath styleClass="menuIcon"
                                                     content="M9 6l1.5-2h3L15 6h3a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h3zm3 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zm0-2.2a1.8 1.8 0 1 1 0-3.6 1.8 1.8 0 0 1 0 3.6z"/>
                                        </graphic>
                                    </MenuItem>

                                    <MenuItem onAction="#goToMyReservations" text="My Reservations">
                                        <graphic>
                                            <SVGPath styleClass="menuIcon"
                                                     content="M7 2v2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-2V2h-2v2H9V2H7zm12 6H5V6h14v2zM7 12h3v3H7v-3zm4 0h3v3h-3v-3zm4 0h3v3h-3v-3z"/>
                                        </graphic>
                                    </MenuItem>

                                    <MenuItem fx:id="menuMyActivities"
                                              onAction="#goToMyActivities"
                                              text="My Activities">
                                        <graphic>
                                            <SVGPath styleClass="menuIcon"
                                                     content="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm0 2a8 8 0 1 1 0 16 8 8 0 0 1 0-16zm3.2 4.8l-1.9 5-5 1.9 1.9-5 5-1.9z"/>
                                        </graphic>
                                    </MenuItem>

                                    <SeparatorMenuItem/>

                                    <MenuItem onAction="#handleLogout" text="Logout">
                                        <graphic>
                                            <SVGPath styleClass="menuIconLogout"
                                                     content="M10 17l1.41-1.41L9.83 14H20v-2H9.83l1.58-1.59L10 9l-5 5 5 5zM4 21h2V3H4v18z"/>
                                        </graphic>
                                    </MenuItem>

                                </items>
                            </ContextMenu>
                        </contextMenu>
                    </Button>

                    <HBox styleClass="winBox" alignment="CENTER_RIGHT" spacing="0">
                        <Button onAction="#minwindow" styleClass="winCtrlBtn" focusTraversable="false">
                            <graphic>
                                <SVGPath content="M2 8 H12"
                                         stroke="white"
                                         strokeWidth="1.8"
                                         strokeLineCap="round"/>
                            </graphic>
                        </Button>

                        <Button onAction="#maxwindow" styleClass="winCtrlBtn" focusTraversable="false">
                            <graphic>
                                <SVGPath content="M3 3 H11 V11 H3 Z"
                                         fill="transparent"
                                         stroke="white"
                                         strokeWidth="1.6"
                                         strokeLineJoin="round"/>
                            </graphic>
                        </Button>

                        <Button focusTraversable="false" onAction="#closewindow" styleClass="winCtrlClose" text="">
                            <graphic>
                                <SVGPath content="M4 4 L12 12 M12 4 L4 12"
                                         fill="transparent"
                                         stroke="white"
                                         strokeLineCap="round"
                                         strokeWidth="1.8"/>
                            </graphic>
                        </Button>
                    </HBox>

                </children>

                <padding>
                    <Insets left="30.0" right="30.0"/>
                </padding>
            </HBox>
        </top>


    <right>

            <VBox spacing="14"
                  styleClass="right"
                  prefWidth="320"
                  minWidth="320"
                  maxWidth="320">

                <VBox styleClass="glass" spacing="12" prefWidth="280">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="📌" styleClass="card-emoji"/>
                        <Label text="Insights" styleClass="card-title"/>
                    </HBox>
                    <HBox spacing="12" alignment="CENTER">
                        <VBox styleClass="mini-stat" spacing="4" alignment="CENTER">
                            <Label text="1.2k" styleClass="mini-stat-val"/>
                            <Label text="Vues" styleClass="mini-stat-lbl"/>
                        </VBox>
                        <VBox styleClass="mini-stat" spacing="4" alignment="CENTER">
                            <Label text="86" styleClass="mini-stat-val"/>
                            <Label text="Likes" styleClass="mini-stat-lbl"/>
                        </VBox>
                        <VBox styleClass="mini-stat" spacing="4" alignment="CENTER">
                            <Label text="14" styleClass="mini-stat-val"/>
                            <Label text="Posts" styleClass="mini-stat-lbl"/>
                        </VBox>
                    </HBox>
                </VBox>

                <VBox styleClass="glass" spacing="10" prefWidth="280">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="🔥" styleClass="card-emoji"/>
                        <Label text="Tendances" styleClass="card-title"/>
                    </HBox>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="#Voyage" styleClass="tag"/>
                        <Label text="#Cuisine" styleClass="tag"/>
                        <Label text="#Tech" styleClass="tag"/>
                    </HBox>
                </VBox>
            <VBox styleClass="glass" spacing="10">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="🚀" styleClass="card-emoji"/>
                    <Label text="À suivre" styleClass="card-title"/>
                </HBox>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <ImageView fitWidth="32" fitHeight="32" preserveRatio="true" styleClass="avatar"/>
                    <VBox spacing="0">
                        <Label text="Tech Daily" styleClass="who"/>
                        <Label text="Recommandé" styleClass="muted"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="+ Suivre" styleClass="btn-soft"/>
                </HBox>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <ImageView fitWidth="32" fitHeight="32" preserveRatio="true" styleClass="avatar"/>
                    <VBox spacing="0">
                        <Label text="Cuisine Pro" styleClass="who"/>
                        <Label text="Populaire" styleClass="muted"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="+ Suivre" styleClass="btn-soft"/>
                </HBox>
            </VBox>

            <VBox styleClass="glass" spacing="8">
                <Label text="🎧 Playlist du moment" styleClass="card-title"/>
                <Label text="Lo-fi Focus • 2h 14m" styleClass="muted"/>
                <ProgressBar progress="0.35" styleClass="bar"/>
            </VBox>
        </VBox>
    </right>

    <!-- CENTER FEED -->
    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    styleClass="scroll">


        <content>
            <StackPane alignment="TOP_CENTER">
            <VBox spacing="14"
                  styleClass="feed"
                  maxWidth="720"
                  alignment="TOP_CENTER">

                    <!-- COMPOSER (creative) -->
                    <VBox styleClass="glass composer" spacing="10">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <ImageView fx:id="imgMe2" fitWidth="40" fitHeight="40" preserveRatio="true" styleClass="avatar"/>
                            <TextField fx:id="txtNewPost"
                                       promptText="Écrivez quelque chose de fort..."
                                       styleClass="composer-input"
                                       HBox.hgrow="ALWAYS"/>
                            <Button text="Publier"
                                    styleClass="btn-primary"
                                    onAction="#handleAddPost"/>
                        </HBox>

                        <HBox spacing="10">
                            <Button text="🖼 Image" styleClass="btn-soft" onAction="#handleChooseImage" />
                            <Button text="🎥 Vidéo" styleClass="btn-soft"/>
                            <Button text="📍 Lieu"
                                    styleClass="btn-soft"
                                    onAction="#handleLocalisation"/>

                            <Button text="🧠 Sondage" styleClass="btn-soft" style=" "/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="Astuce: utilisez #tags" styleClass="hint"/>
                        </HBox>
                    </VBox>

                    <!-- container dynamique -->
                    <VBox fx:id="postsContainer" spacing="14"/>




                </VBox>
            </StackPane>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
</StackPane>