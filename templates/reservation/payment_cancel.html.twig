{% extends 'base.html.twig' %}
{% block body %}
<section class="ftco-section d-flex align-items-center justify-content-center" style="min-height:80vh;">
  <div class="text-center" style="background:#fff; border:1px solid #eee; border-radius:16px; padding:2.5rem 2rem; max-width:440px; width:100%; margin:auto;">

    <div style="width:72px; height:72px; border-radius:50%; background:#fff0f0; display:flex; align-items:center; justify-content:center; margin:0 auto 1.5rem;">
      <i class="fa fa-times" style="font-size:28px; color:#c0392b;"></i>
    </div>

    <h2 style="font-weight:600; margin-bottom:8px; color:#1a1a1a;">Paiement annulé</h2>
    <p style="color:#777; margin-bottom:1.8rem; font-size:15px; line-height:1.6;">
      Votre paiement a été annulé.<br>Votre réservation reste en attente.
    </p>

    <div style="background:#f8f9fa; border-radius:12px; padding:1rem 1.25rem; margin-bottom:1.8rem; text-align:left;">
      <div class="d-flex justify-content-between align-items-center mb-2">
        <span style="font-size:14px; color:#888;">Statut</span>
        <span style="font-size:13px; font-weight:600; background:#c0392b; color:#fff; padding:4px 14px; border-radius:20px;">Annulé</span>
      </div>
      <div class="d-flex justify-content-between align-items-center">
        <span style="font-size:14px; color:#888;">Montant</span>
        <span style="font-size:14px; font-weight:600; color:#1a1a1a;">{{ reservation.coutTotal }} TND</span>
      </div>
    </div>

    <a href="{{ path('reservation_pay', {id: reservation.id}) }}"
       style="display:block; width:100%; padding:12px; background:#223f91; color:#fff; border-radius:12px; font-size:15px; font-weight:600; text-decoration:none; margin-bottom:10px;">
      Réessayer le paiement
    </a>
    <a href="{{ path('mes_reservations') }}"
       style="display:block; width:100%; padding:12px; background:#fff; color:#555; border:1px solid #ddd; border-radius:12px; font-size:15px; text-decoration:none;">
      Mes réservations
    </a>

  </div>
</section>
{% endblock %}