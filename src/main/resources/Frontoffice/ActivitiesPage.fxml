<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="1000.0"
            xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controllers.ActivitiesPageController"
            stylesheets="@/Frontoffice/css/profile-menu.css,@/Frontoffice/css/home.css">

    <children>
        <BorderPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

            <center>
                <ScrollPane fitToWidth="true"
                            BorderPane.alignment="CENTER"
                            styleClass="page"
                            prefWidth="1.7976931348623157E308"
                            maxWidth="1.7976931348623157E308"
                            hbarPolicy="NEVER">

                    <content>
                        <VBox spacing="28.0"
                              styleClass="page"
                              prefWidth="1.7976931348623157E308"
                              maxWidth="1.7976931348623157E308">

                            <!-- ========================= HERO ========================= -->
                            <StackPane styleClass="heroWrap">
                                <children>

                                    <!-- Background via CSS -->
                                    <Region styleClass="heroBgActivities"/>
                                    <Region styleClass="heroOverlay"/>

                                    <!-- ✅ CONTENT: pushed LOWER with a spacer -->
                                    <VBox prefWidth="1.7976931348623157E308"
                                          maxWidth="1.7976931348623157E308"
                                          StackPane.alignment="TOP_CENTER"
                                          styleClass="activitiesHeroCenter">

                                        <!-- Spacer that pushes everything down -->
                                        <Region VBox.vgrow="ALWAYS"/>

                                        <!-- Actual hero content (LOW) -->
                                        <VBox alignment="CENTER" spacing="12.0"
                                              style="-fx-padding: 0 60 40 60;">
                                            <!-- ^ bottom padding controls how LOW it is -->

                                            <Label text="Discover Activities Near You" textFill="WHITE">
                                                <font><Font name="System Bold" size="48.0"/></font>
                                            </Label>

                                            <Label text="Browse amazing activities and book in seconds"
                                                   style="-fx-text-fill: rgba(255,255,255,0.85);">
                                                <font><Font size="18.0"/></font>
                                            </Label>

                                            <!-- ✅ Search bar limited width + CSS classes -->
                                            <HBox alignment="CENTER"
                                                  styleClass="activitiesSearchBar">

                                                <TextField fx:id="searchField"
                                                           promptText="Search activities, destinations..."
                                                           styleClass="activitiesSearchField"
                                                           HBox.hgrow="ALWAYS"/>

                                                <Button text="Search"
                                                        onAction="#handleSearch"
                                                        styleClass="activitiesSearchBtn"/>
                                            </HBox>

                                        </VBox>
                                    </VBox>

                                    <!-- ========================= HEADER (HOME) ========================= -->
                                    <HBox alignment="CENTER_LEFT"
                                          styleClass="topGlassOverlay"
                                          StackPane.alignment="TOP_CENTER"
                                          minHeight="70.0" prefHeight="70.0" maxHeight="70.0">
                                        <children>

                                            <ImageView fitHeight="44.0" preserveRatio="true" pickOnBounds="true" styleClass="brandLogo">
                                                <image>
                                                    <Image url="@../Backoffice/icons/IMG_20260125_122708_191-removebg-preview.png"/>
                                                </image>
                                            </ImageView>

                                            <Region HBox.hgrow="ALWAYS"/>

                                            <HBox alignment="CENTER" spacing="22.0">
                                                <Button onAction="#goToHome" text="Home" styleClass="navBtn"/>
                                                <Button onAction="#goToDestinations" text="Destinations" styleClass="navBtn"/>
                                                <Button onAction="#goToPosts" text="Posts" styleClass="navBtn"/>
                                                <Button onAction="#goToactivities" text="Activities" styleClass="navBtn"/>
                                                <Button text="About" styleClass="navBtn"/>
                                            </HBox>

                                            <Region HBox.hgrow="ALWAYS"/>

                                            <StackPane alignment="TOP_RIGHT">
                                                <HBox.margin>
                                                    <Insets right="10.0"/>
                                                </HBox.margin>

                                                <Button fx:id="btnNotif"
                                                        onAction="#openNotifications"
                                                        styleClass="iconBtn"
                                                        text="🔔"/>

                                                <Label fx:id="lblNotifCount"
                                                       text="0"
                                                       visible="false"
                                                       managed="false"
                                                       StackPane.alignment="TOP_RIGHT"
                                                       translateX="8"
                                                       translateY="-6"
                                                       style="-fx-background-color: #ef4444;
                  -fx-text-fill: white;
                  -fx-font-weight: 900;
                  -fx-font-size: 11px;
                  -fx-padding: 2 6;
                  -fx-background-radius: 999;
                  -fx-min-width: 18px;
                  -fx-alignment: center;"/>
                                            </StackPane>

                                            <Button fx:id="btnProfile" onAction="#openProfileMenu" styleClass="iconBtn" text="👤">
                                                <HBox.margin><Insets right="14.0"/></HBox.margin>
                                                <contextMenu>
                                                    <ContextMenu fx:id="profileMenu" styleClass="profileMenu">
                                                        <items>

                                                            <MenuItem onAction="#goToMyProfile" text="My Profile">
                                                                <graphic>
                                                                    <SVGPath styleClass="menuIcon"
                                                                             content="M12 12c2.21 0 4-1.79 4-4S14.21 4 12 4 8 5.79 8 8s1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                                                                </graphic>
                                                            </MenuItem>

                                                            <MenuItem onAction="#goToMyPosts" text="My Posts">
                                                                <graphic>
                                                                    <SVGPath styleClass="menuIcon"
                                                                             content="M9 6l1.5-2h3L15 6h3a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h3zm3 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zm0-2.2a1.8 1.8 0 1 1 0-3.6 1.8 1.8 0 0 1 0 3.6z"/>
                                                                </graphic>
                                                            </MenuItem>

                                                            <MenuItem onAction="#goToMyReservations" text="My Reservations">
                                                                <graphic>
                                                                    <SVGPath styleClass="menuIcon"
                                                                             content="M7 2v2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-2V2h-2v2H9V2H7zm12 6H5V6h14v2zM7 12h3v3H7v-3zm4 0h3v3h-3v-3zm4 0h3v3h-3v-3z"/>
                                                                </graphic>
                                                            </MenuItem>

                                                            <MenuItem fx:id="menuMyActivities"
                                                                      onAction="#goToMyActivities"
                                                                      text="My Activities">
                                                                <graphic>
                                                                    <SVGPath styleClass="menuIcon"
                                                                             content="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm0 2a8 8 0 1 1 0 16 8 8 0 0 1 0-16zm3.2 4.8l-1.9 5-5 1.9 1.9-5 5-1.9z"/>
                                                                </graphic>
                                                            </MenuItem>

                                                            <SeparatorMenuItem/>

                                                            <MenuItem onAction="#handleLogout" text="Logout">
                                                                <graphic>
                                                                    <SVGPath styleClass="menuIconLogout"
                                                                             content="M10 17l1.41-1.41L9.83 14H20v-2H9.83l1.58-1.59L10 9l-5 5 5 5zM4 21h2V3H4v18z"/>
                                                                </graphic>
                                                            </MenuItem>

                                                        </items>
                                                    </ContextMenu>
                                                </contextMenu>
                                            </Button>

                                            <HBox styleClass="winBox" alignment="CENTER_RIGHT" spacing="0">
                                                <Button onAction="#minwindow" styleClass="winCtrlBtn" focusTraversable="false">
                                                    <graphic>
                                                        <SVGPath content="M2 8 H12"
                                                                 stroke="white"
                                                                 strokeWidth="1.8"
                                                                 strokeLineCap="round"/>
                                                    </graphic>
                                                </Button>

                                                <Button onAction="#maxwindow" styleClass="winCtrlBtn" focusTraversable="false">
                                                    <graphic>
                                                        <SVGPath content="M3 3 H11 V11 H3 Z"
                                                                 fill="transparent"
                                                                 stroke="white"
                                                                 strokeWidth="1.6"
                                                                 strokeLineJoin="round"/>
                                                    </graphic>
                                                </Button>

                                                <Button focusTraversable="false" onAction="#closewindow" styleClass="winCtrlClose" text="">
                                                    <graphic>
                                                        <SVGPath content="M4 4 L12 12 M12 4 L4 12"
                                                                 fill="transparent"
                                                                 stroke="white"
                                                                 strokeLineCap="round"
                                                                 strokeWidth="1.8"/>
                                                    </graphic>
                                                </Button>
                                            </HBox>

                                        </children>

                                        <padding>
                                            <Insets left="30.0" right="18.0"/>
                                        </padding>
                                    </HBox>

                                </children>
                            </StackPane>

                            <!-- ========================= LIST ========================= -->
                            <VBox spacing="20.0" style="-fx-background-color: #ffffff;">
                                <padding>
                                    <Insets left="40.0" right="40.0" top="10.0"/>
                                </padding>

                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <ImageView fitHeight="28.0" fitWidth="28.0" preserveRatio="true">
                                        <image><Image url="@/Backoffice/icons/Bousole.png"/></image>
                                    </ImageView>

                                    <Label text="Activities" textFill="#223f91">
                                        <font><Font name="System Bold" size="32.0"/></font>
                                    </Label>

                                    <Region HBox.hgrow="ALWAYS"/>

                                    <Button text="🔥 Flash sales" onAction="#showFlashSales"
                                            style="-fx-background-color: #fff7ed; -fx-text-fill: #c2410c; -fx-font-weight: 900; -fx-background-radius: 999; -fx-padding: 8 14; -fx-border-color: #fdba74; -fx-border-radius: 999; -fx-cursor: hand;"/>

                                    <Button text="All" onAction="#showAllActivities"
                                            style="-fx-background-color: #eef2ff; -fx-text-fill: #223f91; -fx-font-weight: 900; -fx-background-radius: 999; -fx-padding: 8 14; -fx-cursor: hand;"/>
                                </HBox>

                                <Label text="Plan your day with the best activities" textFill="#4a5f88">
                                    <font><Font size="16.0"/></font>
                                </Label>

                                <FlowPane fx:id="activitiesFlowPane" hgap="25.0" vgap="25.0" prefWrapLength="900.0">
                                    <padding><Insets top="10.0"/></padding>
                                </FlowPane>

                                <Region prefHeight="10.0"/>
                            </VBox>

                            <!-- FOOTER -->
                            <VBox alignment="CENTER" spacing="8.0"
                                  style="-fx-background-color: #223f91; -fx-padding: 20;">
                                <Label text="Rehla - Your Travel Companion" textFill="WHITE">
                                    <font><Font name="System Bold" size="16.0"/></font>
                                </Label>
                                <Label text="© 2026 Rehla. All rights reserved." textFill="#cccccc">
                                    <font><Font size="12.0"/></font>
                                </Label>
                            </VBox>

                        </VBox>
                    </content>
                </ScrollPane>
            </center>

        </BorderPane>
    </children>
</AnchorPane>