 <section class="hero-wrap hero-wrap-2 js-fullheight" style="background-image: url('{{ asset('assets/images/bg_1.jpg') }}');">
<div class="overlay"></div>
<div class="container">
<div class="row no-gutters slider-text js-fullheight align-items-end justify-content-center">
<div class="col-md-9 ftco-animate pb-5 text-center">
<p class="breadcrumbs"><span class="mr-2"><a href="{{ path('home') }}">Home <i class="fa fa-chevron-right"></i></a></span> <span>Posts <i class="fa fa-chevron-right"></i></span></p>
<h1 class="mb-0 bread">Nos Publications</h1>
</div>
</div>
</div>
</section>
<section class="ftco-section pt-5" style="background:#eef2f7;">
<div class="container">
<div class="row">

<!-- ================= LEFT FEED ================= -->
<div class="col-lg-8">

<div class="card border-0 shadow-sm mb-4 p-3 rounded-4">

{{ form_start(form, {
    attr: {
        enctype: 'multipart/form-data',
        novalidate: 'novalidate'
    }
}) }}

  <div class="d-flex">
    {{ form_widget(form.contenu, {
    attr: {
        class: 'form-control rounded-pill px-4 ',
        id: 'post_contenu'
    }
}) }}

    <button type="submit" class="btn btn-primary rounded-pill px-4 ml-2">
  Publier
</button>
  </div>


  <!-- boutons -->
  <div class="d-flex mt-3">

    <button type="button"
            class="btn btn-outline-primary rounded-pill mr-2"
            onclick="document.getElementById('post_image').click()">
      📷 Image
    </button>
        <button class="btn btn-outline-primary rounded-pill mr-2">🎥 Vidéo</button>
    <button class="btn btn-outline-primary rounded-pill mr-2">📍 Lieu</button>
    <button class="btn btn-outline-primary rounded-pill">📊 Sondage</button>

    {{ form_widget(form.image) }}

  </div>

  {{ form_end(form) }}

</div>


<!-- POST IMAGE -->
{% for post in posts %}

<div class="card border-0 shadow-sm mb-4 rounded-4">
  <div class="card-body">

    <div class="d-flex align-items-center mb-2">

      <!-- IMAGE PROFIL -->
      <img src="{{ post.personne_id.profile_photo ? asset(post.personne_id.profile_photo) : asset('assets/img/bg_1.jpg') }}"
           class="profile-img mr-2">

      <div>
        <!-- NOM -->
        <strong>
          {{ post.personne_id.nom }} {{ post.personne_id.prenom }}
        </strong><br>

        <!-- DATE -->
       <small class="text-muted">
        {{ post.datePublication ? post.datePublication|date('Y-m-d H:i:s') : '---' }} • Public
      </small>
      </div>

      <!-- DROPDOWN (inchangé) -->
      <div class="dropdown ms-3">
        <button class="btn p-0 border-0 bg-transparent post-icon-dropdown dropdown-toggle"
                type="button" data-toggle="dropdown">
          <i class="fa fa-cog"></i>
        </button>

        <div class="dropdown-menu dropdown-menu-end modern-dropdown shadow-lg">
          <a class="dropdown-item open-edit">
            <i class="fa fa-edit"></i> Modifier
          </a>
          <a class="dropdown-item" href="#">
            <i class="fa fa-trash"></i> Supprimer
          </a>
        </div>
      </div>

      <!-- TAGS -->
      <div class="ml-auto d-flex align-items-center">
        <span class="badge badge-light me-1">#Design</span>
        <span class="badge badge-primary me-1">#JavaFX</span>
        <span class="badge badge-pink">Tendance</span>
      </div>

    </div>

    <!-- CONTENU -->
    <p>{{ post.contenu }}</p>

    <!-- IMAGE POST -->
    {% if post.image %}
      <img src="{{ asset(post.image) }}"
           class="img-fluid rounded mt-2">
    {% endif %}

    <!-- ACTIONS (inchangées) -->
    <div class="d-flex justify-content-between align-items-center mt-3 text-muted">

      <div class="d-flex">

        <div class="mr-3 post-action">
          <i class="fa fa-heart"></i> <span>0</span>
        </div>

        <div class="mr-3 post-action open-comment">
          <i class="fa fa-comment"></i> 0
        </div>

        <div class="post-action">
          <i class="fa fa-bookmark"></i>
        </div>

      </div>

      <div class="post-action">
        <i class="fa fa-share-alt"></i>
      </div>

    </div>

  </div>
</div>

{% else %}
  <p class="text-center text-muted">Aucun post disponible</p>
{% endfor %}


</div>


<!-- ================= RIGHT SIDEBAR ================= -->
<div class="col-lg-4 sidebar-sticky">

<!-- Insights -->
<div class="card border-0 shadow-sm mb-4 rounded-4 p-3">
