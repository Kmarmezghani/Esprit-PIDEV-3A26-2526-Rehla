<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="Controllers.FaceLoginController"
           prefWidth="900" prefHeight="650"
           style="-fx-background-color: linear-gradient(to bottom right, #1a1a2e, #16213e, #0f3460);">

    <!-- Main Content Card -->
    <VBox alignment="CENTER" spacing="20" maxWidth="500"
          style="-fx-background-color: rgba(255,255,255,0.95); -fx-background-radius: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 25, 0, 0, 10);">
        <padding>
            <Insets top="40" right="50" bottom="40" left="50"/>
        </padding>

        <!-- Header -->
        <Label text="👤" style="-fx-font-size: 48;"/>
        <Label text="Face Login" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
        <Label fx:id="instructionLabel" text="Position your face in the frame"
               style="-fx-font-size: 14; -fx-text-fill: #666666;"/>

        <!-- Webcam View Container -->
        <StackPane fx:id="webcamContainer" prefWidth="320" prefHeight="240"
                   style="-fx-background-color: #1a1a2e; -fx-background-radius: 15;">
            
            <!-- Webcam Feed -->
            <ImageView fx:id="webcamView" fitWidth="320" fitHeight="240" preserveRatio="true">
                <clip>
                    <Rectangle width="320" height="240" arcWidth="30" arcHeight="30"/>
                </clip>
            </ImageView>

            <!-- Face Overlay Guide -->
            <Rectangle fx:id="faceGuide" width="180" height="220" 
                       fill="transparent" stroke="#4facfe" strokeWidth="3"
                       arcWidth="90" arcHeight="90" strokeDashArray="15, 10"/>
            
            <!-- Loading Indicator -->
            <ProgressIndicator fx:id="loadingIndicator" visible="false" 
                               maxWidth="60" maxHeight="60"/>
            
            <!-- No Camera Message -->
            <VBox fx:id="noCameraBox" alignment="CENTER" spacing="10" visible="false">
                <Label text="📷" style="-fx-font-size: 40;"/>
                <Label text="No camera detected" style="-fx-text-fill: white; -fx-font-size: 14;"/>
            </VBox>
        </StackPane>

        <!-- Status Label -->
        <Label fx:id="statusLabel" text="" 
               style="-fx-font-size: 14; -fx-text-fill: #666666; -fx-font-weight: bold;"/>

        <!-- Error Label -->
        <Label fx:id="errorLabel" text="" wrapText="true" maxWidth="350"
               style="-fx-font-size: 13; -fx-text-fill: #e74c3c; -fx-font-weight: bold;"/>

        <!-- Confidence Bar (shown during verification) -->
        <HBox fx:id="confidenceBox" alignment="CENTER" spacing="10" visible="false">
            <Label text="Confidence:" style="-fx-font-size: 12; -fx-text-fill: #666;"/>
            <Label fx:id="confidenceLabel" text="0%" 
                   style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #4facfe;"/>
        </HBox>

        <!-- Action Buttons -->
        <HBox alignment="CENTER" spacing="15">
            <Button fx:id="captureButton" text="📸 Capture &amp; Verify" onAction="#handleCapture"
                    prefWidth="160" prefHeight="45"
                    style="-fx-background-color: linear-gradient(to right, #4facfe, #00f2fe); -fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold; -fx-background-radius: 25; -fx-cursor: hand;"/>
            
            <Button fx:id="retryButton" text="🔄 Retry" onAction="#handleRetry" visible="false"
                    prefWidth="100" prefHeight="45"
                    style="-fx-background-color: linear-gradient(to right, #f093fb, #f5576c); -fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold; -fx-background-radius: 25; -fx-cursor: hand;"/>
        </HBox>

        <!-- Separator -->
        <HBox alignment="CENTER" spacing="15">
            <Rectangle width="100" height="1" fill="#dddddd"/>
            <Label text="OR" style="-fx-text-fill: #999999; -fx-font-size: 12;"/>
            <Rectangle width="100" height="1" fill="#dddddd"/>
        </HBox>

        <!-- Back to Login -->
        <Button text="← Back to Login" onAction="#goToLogin"
                style="-fx-background-color: transparent; -fx-text-fill: #4facfe; -fx-font-size: 14; -fx-cursor: hand; -fx-underline: true;"/>

    </VBox>

</StackPane>
