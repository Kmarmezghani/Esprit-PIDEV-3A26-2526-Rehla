{% extends 'adminbase.html.twig' %}

{% block title %}Gestion des Utilisateurs – Rehla Admin{% endblock %}

{% block sidebar %}
  {% include 'admin/Partials/sidebar.html.twig' %}
{% endblock %}

{% block navbar %}
  {% include 'admin/Partials/navbar.html.twig' %}
{% endblock %}

{% block body %}

{# ── Flash messages ── #}
{% for msg in app.flashes('admin_success') %}
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bx bx-check-circle me-2"></i> {{ msg }}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
{% endfor %}
{% for msg in app.flashes('danger') %}
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bx bx-error-circle me-2"></i> {{ msg }}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
{% endfor %}

<div class="row g-6">
  <div class="col-12">

    {# ── En-tête + stats rapides ── #}
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-center p-3">
                <h4 class="mb-0" style="color:#223f91;">{{ users|length }}</h4>
                <small class="text-muted">Total comptes</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center p-3">
                <h4 class="mb-0 text-success">
                    {{ users|filter(u => u.statutCompte == 'ACTIF')|length }}
                </h4>
                <small class="text-muted">Actifs</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center p-3">
                <h4 class="mb-0 text-danger">
                    {{ users|filter(u => u.statutCompte == 'SUSPENDU')|length }}
                </h4>
                <small class="text-muted">Suspendus</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center p-3">
                <h4 class="mb-0 text-warning">
                    {{ users|filter(u => u.role == 'GUIDE')|length }}
                </h4>
                <small class="text-muted">Guides</small>
            </div>
        </div>
    </div>

    {# ── Tableau principal ── #}
    <div class="card">
      <div class="d-flex align-items-center p-3">
        <h5 class="card-header mb-0 ps-0">
            <i class="bx bx-group me-2" style="color:#223f91;"></i>Liste des comptes utilisateurs
        </h5>
        <div class="ms-auto d-flex gap-2 align-items-center">
            {# Filtre par rôle #}
            <select id="roleFilter" class="form-select form-select-sm" style="width:auto;" onchange="filterTable()">
                <option value="">Tous les rôles</option>
                <option value="CLIENT">Clients</option>
                <option value="GUIDE">Guides</option>
                <option value="ADMIN">Admins</option>
            </select>
            {# Recherche #}
            <input type="text" id="searchInput" class="form-control form-control-sm"
                   placeholder="Rechercher…" oninput="filterTable()" style="width:200px;">
            {# Boutons export / stats #}
            <a href="{{ path('admin_users_pdf') }}" class="btn btn-sm" style="background:#223f91;color:#fff;border-radius:8px;white-space:nowrap;">
                <i class="bx bx-download me-1"></i> Export PDF
            </a>
            <a href="{{ path('admin_stats') }}" class="btn btn-sm btn-outline-secondary" style="border-radius:8px;white-space:nowrap;">
                <i class="bx bx-bar-chart-alt-2 me-1"></i> Statistiques
            </a>
            <a href="{{ path('admin_risk_analysis') }}" class="btn btn-sm" style="background:#6f42c1;color:#fff;border-radius:8px;white-space:nowrap;">
                <i class="bx bx-brain me-1"></i> Analyse IA
            </a>
        </div>
      </div>

      <div class="table-responsive text-nowrap">
        <table class="table table-striped table-hover" id="usersTable">
          <thead>
            <tr>
              <th>Photo</th>
              <th>Nom & Prénom</th>
              <th>Email</th>
              <th>Téléphone</th>
              <th>Rôle</th>
              <th>Statut</th>
              <th>Inscription</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            {% for user in users %}
            <tr data-role="{{ user.role }}" data-name="{{ user.nom|lower }} {{ user.prenom|lower }} {{ user.email|lower }}">


              <td>
                {% if user.profile_photo %}
                    {% set cleanPath = user.profile_photo starts with '/' ? user.profile_photo[1:] : user.profile_photo %}
                    {% if cleanPath starts with 'uploads/' %}
                        <img src="{{ asset(cleanPath) }}" alt="Photo"
                             class="rounded-circle" style="width:36px;height:36px;object-fit:cover;">
                    {% else %}
                        <span style="display:inline-block;width:36px;height:36px;border-radius:50%;overflow:hidden;">
                            {{ avatar_svg(user.prenom, user.nom) | raw }}
                        </span>
                    {% endif %}
                {% else %}
                    <span style="display:inline-block;width:36px;height:36px;border-radius:50%;overflow:hidden;">
                        {{ avatar_svg(user.prenom, user.nom) | raw }}
                    </span>
                {% endif %}
              </td>

              <td>
                <strong>{{ user.prenom }} {{ user.nom }}</strong>
              </td>

              <td>{{ user.email }}</td>

              <td>{{ user.telephone ?? '–' }}</td>

              <td>
                {% if user.role == 'ADMIN' %}
                    <span class="badge bg-label-danger">Admin</span>
                {% elseif user.role == 'GUIDE' %}
                    <span class="badge bg-label-warning">Guide</span>
                {% else %}
                    <span class="badge bg-label-primary">Client</span>
                {% endif %}
              </td>

              <td>
                {% if user.statutCompte == 'ACTIF' %}
                    <span class="badge bg-label-success">Actif</span>
                {% elseif user.statutCompte == 'SUSPENDU' %}
                    <span class="badge bg-label-danger">Suspendu</span>
                {% else %}
                    <span class="badge bg-label-secondary">{{ user.statutCompte }}</span>
                {% endif %}
              </td>

              <td>
                {% if user.dateInscription %}
                    {{ user.dateInscription|date('d/m/Y') }}
                {% else %}–{% endif %}
              </td>

              <td>
                <div class="dropdown">
                    <button type="button" class="btn p-0 dropdown-toggle hide-arrow"
                            data-bs-toggle="dropdown">
                        <i class="icon-base bx bx-dots-vertical-rounded"></i>
                    </button>
                    <div class="dropdown-menu">
                        <a class="dropdown-item"
                           href="{{ path('admin_user_edit', {id: user.id}) }}">
                            <i class="icon-base bx bx-edit-alt me-2"></i> Modifier
                        </a>
                        <a class="dropdown-item"
                           href="{{ path('admin_user_preferences', {id: user.id}) }}">
                            <i class="icon-base bx bx-slider me-2"></i> Voir préférences
                        </a>
                        {% if user.role != 'ADMIN' %}
                        <button class="dropdown-item text-danger"
                                data-bs-toggle="modal"
                                data-bs-target="#deleteModal{{ user.id }}">
                            <i class="icon-base bx bx-trash me-2"></i> Supprimer
                        </button>
                        {% endif %}
                    </div>
                </div>
              </td>
            </tr>
            {% else %}
            <tr>
                <td colspan="8" class="text-center py-4 text-muted">
                    Aucun utilisateur trouvé.
                </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>

  </div>
</div>

{# ── Modals de suppression ── #}
{% for user in users %}
{% if user.role != 'ADMIN' %}
<div class="modal fade" id="deleteModal{{ user.id }}" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-danger">
                    <i class="bx bx-error-circle me-1"></i> Suppression du compte
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <i class="bx bx-user-x display-6 text-danger mb-3"></i>
                <h5>Supprimer le compte de <strong>{{ user.prenom }} {{ user.nom }}</strong> ?</h5>
                <p class="text-muted mb-0">Cette action est <strong>irréversible</strong>. Toutes les données de cet utilisateur seront supprimées.</p>
            </div>
            <div class="modal-footer justify-content-center">
                <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
                <form method="post" action="{{ path('admin_user_delete', {id: user.id}) }}" style="display:inline;">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete_user' ~ user.id) }}">
                    <button class="btn btn-danger">
                        <i class="bx bx-trash me-1"></i> Oui, supprimer
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endif %}
{% endfor %}

{% endblock %}

{% block page_scripts %}
<script>
function filterTable() {
    const roleVal  = document.getElementById('roleFilter').value.toLowerCase();
    const search   = document.getElementById('searchInput').value.toLowerCase();
    const rows     = document.querySelectorAll('#usersTable tbody tr[data-role]');

    rows.forEach(row => {
        const role  = row.dataset.role.toLowerCase();
        const name  = row.dataset.name;
        const matchRole   = !roleVal || role === roleVal;
        const matchSearch = !search  || name.includes(search);
        row.style.display = (matchRole && matchSearch) ? '' : 'none';
    });
}
</script>
{% endblock %}
