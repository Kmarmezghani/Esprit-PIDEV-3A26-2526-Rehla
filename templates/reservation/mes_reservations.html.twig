{# Bouton déclencheur #}
<div class="d-flex justify-content-end mb-3">
    <button onclick="openAIPanel()" class="btn" style="background:#223f91;color:#fff;border-radius:20px;padding:10px 22px;font-size:14px;display:inline-flex;align-items:center;gap:8px;">
        <i class="fa fa-magic"></i> Recommandation IA
    </button>
</div>

{# Panneau IA #}
<div class="ai-panel-overlay" id="aiPanelOverlay" onclick="handleAIOverlay(event)">
  <div class="ai-panel" id="aiPanel">
    <div class="d-flex justify-content-between align-items-center">
        <div style="font-size:17px;font-weight:500;color:#223f91;display:flex;align-items:center;gap:8px;">
            <i class="fa fa-magic"></i> Recommandation personnalisée
            <span style="font-size:11px;background:#e8f0fe;color:#223f91;padding:3px 9px;border-radius:20px;font-weight:400">IA</span>
        </div>
        <button onclick="closeAIPanel()" style="border:none;background:none;font-size:24px;cursor:pointer;color:#aaa;line-height:1;">&times;</button>
    </div>

    {# Contexte client #}
    <div>
        <div class="ai-section-label">Contexte analysé</div>
        <div class="ai-ctx-grid">
            <div class="ai-ctx-card">
                <div class="ai-ctx-label">Réservations</div>
                <div class="ai-ctx-value">{{ reservations|length }} voyages</div>
            </div>
            <div class="ai-ctx-card">
                <div class="ai-ctx-label">Destinations visitées</div>
                <div class="ai-ctx-value">
                    {% set dests = [] %}
                    {% for r in reservations %}{% if r.destination %}{% set dests = dests|merge([r.destination.nom]) %}{% endif %}{% endfor %}
                    {% set dests = [] %}
{% for r in reservations %}
    {% if r.destination and r.destination.nom not in dests %}
        {% set dests = dests|merge([r.destination.nom]) %}
    {% endif %}
{% endfor %}
{{ dests|join(', ')|default('Aucune') }}
                </div>
            </div>
            <div class="ai-ctx-card">
                <div class="ai-ctx-label">Budget préférence</div>
                <div class="ai-ctx-value">
                    {% set pref = app.session.get('user_preference') %}
                    {% if pref %}{{ pref.budgetMin }} – {{ pref.budgetMax }} TND{% else %}Non défini{% endif %}
                </div>
            </div>
        </div>
    </div>

    {# Budget #}
    <div>
        <div class="ai-section-label">Budget pour ce voyage (TND)</div>
        <div class="ai-row">
            <input type="number" class="ai-input" id="aiBudgetMin" placeholder="Min" value="500" style="width:110px">
            <span style="color:#aaa">–</span>
            <input type="number" class="ai-input" id="aiBudgetMax" placeholder="Max" value="2000" style="width:110px">
            <span style="font-size:13px;color:#888">TND</span>
        </div>
    </div>

    {# Dates #}
    <div>
        <div class="ai-section-label">Période souhaitée</div>
        <div class="ai-row">
            <input type="date" class="ai-input" id="aiDateDebut">
            <span style="color:#aaa">→</span>
            <input type="date" class="ai-input" id="aiDateFin">
        </div>
    </div>

    <button class="ai-gen-btn" id="aiGenBtn" onclick="launchAIRecommendation()">
        <i class="fa fa-magic"></i> Générer ma recommandation
    </button>

    <div class="ai-result" id="aiResult">
        <div id="aiResultInner"></div>
    </div>
  </div>
</div>

<script>
function openAIPanel() {
    document.getElementById('aiPanelOverlay').classList.add('open');
    const today = new Date();
    const next  = new Date(); next.setDate(today.getDate() + 30);
    document.getElementById('aiDateDebut').value = today.toISOString().split('T')[0];
    document.getElementById('aiDateFin').value   = next.toISOString().split('T')[0];
}
function closeAIPanel() {
    document.getElementById('aiPanelOverlay').classList.remove('open');
    document.getElementById('aiResult').classList.remove('visible');
}
function handleAIOverlay(e) {
    if (e.target === document.getElementById('aiPanelOverlay')) closeAIPanel();
}

let aiLastCall = 0;

async function launchAIRecommendation() {
    const now = Date.now();
    if (now - aiLastCall < 15000) {
        const remaining = Math.ceil((15000 - (now - aiLastCall)) / 1000);
        document.getElementById('aiResult').classList.add('visible');
        document.getElementById('aiResultInner').innerHTML = `
            <div style="color:#e67e22;text-align:center;padding:20px">
                <i class="fa fa-clock-o" style="font-size:28px;margin-bottom:8px;display:block"></i>
                Attendez encore <strong>${remaining}s</strong> avant de relancer.
            </div>`;
        return;
    }
    aiLastCall = now;

    const btn    = document.getElementById('aiGenBtn');
    const result = document.getElementById('aiResult');
    const inner  = document.getElementById('aiResultInner');

    btn.disabled = true;
    btn.innerHTML = '<div class="ai-typing"><span></span><span></span><span></span></div>&nbsp;Analyse en cours...';
    result.classList.add('visible');
    inner.innerHTML = '<div class="ai-typing"><span></span><span></span><span></span></div>';

    const dateDebutVal = document.getElementById('aiDateDebut').value;
    const dateFinVal   = document.getElementById('aiDateFin').value;

    try {
        const resp = await fetch('/api/recommandation-ia', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                budgetMin: document.getElementById('aiBudgetMin').value,
                budgetMax: document.getElementById('aiBudgetMax').value,
                dateDebut: dateDebutVal,
                dateFin:   dateFinVal,
            })
        });

        const d = await resp.json();
        console.log('RAW RESPONSE:', JSON.stringify(d));

        if (resp.status === 429) {
            inner.innerHTML = `
                <div style="color:#e67e22;text-align:center;padding:20px">
                    <i class="fa fa-clock-o" style="font-size:28px;margin-bottom:8px;display:block"></i>
                    <strong>IA temporairement indisponible</strong><br>
                    <span style="font-size:13px;color:#888">Réessayez dans quelques secondes.</span>
                </div>`;
            return;
        }

        if (d.error) {
            inner.innerHTML = `<div style="color:#c00;text-align:center;padding:20px"><i class="fa fa-warning"></i> ${d.error}</div>`;
            return;
        }

        const ticketIdsChoisis = (d.tickets || []).map(t => t.id).filter(Boolean);

        const ticketsHTML = (d.tickets || []).map(t => `
            <div class="ai-ticket">
                <span style="color:#223f91;font-weight:500">
                    <i class="fa fa-ticket" style="margin-right:6px"></i>${t.nom}
                </span>
                <span>${t.prix} TND</span>
            </div>`).join('');

        inner.innerHTML = `
            <div class="ai-rec-dest">
                <i class="fa fa-map-marker" style="margin-right:6px"></i>${d.destination}
            </div>
            <div class="ai-tags">
                <span class="ai-tag">📅 ${d.dateDebut} → ${d.dateFin}</span>
                <span class="ai-tag">☀️ ${d.meteo || 'Météo favorable'}</span>
                <span class="ai-tag">✅ Dans votre budget</span>
            </div>
            <div class="ai-raison">${d.raison}</div>
            <div class="ai-section-label">Composition de la réservation</div>
            ${ticketsHTML}
            <div class="ai-total"><span>Total estimé</span><span>${d.total} TND</span></div>
            <button onclick="creerReservationIA(${d.destination_id}, ${JSON.stringify(ticketIdsChoisis)}, '${dateDebutVal}', '${dateFinVal}')"
                style="margin-top:16px;width:100%;padding:13px;background:#27ae60;color:#fff;border:none;border-radius:12px;font-size:15px;font-weight:500;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;">
                <i class="fa fa-check-circle"></i> Créer cette réservation
            </button>`;

    } catch (err) {
        inner.innerHTML = `<div style="color:#c00;text-align:center;padding:20px"><i class="fa fa-warning"></i> Erreur réseau. Réessayez.</div>`;
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="fa fa-magic"></i> Régénérer';
    }
}

// ── SEPARATE FUNCTION — outside launchAIRecommendation ──
async function creerReservationIA(destinationId, ticketIds, dateDebut, dateFin) {
    if (!destinationId || !ticketIds.length) {
        Swal.fire('Erreur', "Données de réservation incomplètes.", 'error');
        return;
    }

    const confirmation = await Swal.fire({
        title: 'Confirmer la réservation ?',
        text: "Une réservation sera créée avec les tickets sélectionnés par l'IA.",
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#27ae60',
        cancelButtonText: 'Annuler',
        confirmButtonText: 'Oui, créer !'
    });

    if (!confirmation.isConfirmed) return;

    try {
        const resp = await fetch('/api/recommandation-ia/creer', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                destination_id: destinationId,
                ticket_ids: ticketIds,
                dateDebut,
                dateFin
            })
        });

        const d = await resp.json();

        if (d.success) {
            Swal.fire({
                title: 'Réservation créée !',
                text: d.message,
                icon: 'success',
                confirmButtonText: 'Voir mes réservations'
            }).then(() => window.location.reload());
        } else {
            Swal.fire('Erreur', d.error || 'Une erreur est survenue.', 'error');
        }
    } catch (e) {
        Swal.fire('Erreur', 'Erreur réseau.', 'error');
    }
}
</script>
