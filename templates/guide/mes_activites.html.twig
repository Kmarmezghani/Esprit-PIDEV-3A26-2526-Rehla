<section class="ftco-section">
    <div class="container">
        <div class="d-flex justify-content-end mb-4">
    <a href="{{ path('ajouter_activite') }}" class="btn btn-primary px-4 py-2">
        <i class="fa fa-plus"></i> Ajouter une activité
    </a>
</div>
        <div class="row">
            
            {% if activites is not empty %}
                {% for activite in activites %}
                    <div class="col-md-4 ftco-animate">
                        <div class="project-wrap position-relative">

                            <!-- Icons Modifier / Supprimer -->
                            <div class="card-icons position-absolute" style="top:10px; right:10px; display:flex; gap:10px; z-index:10;">
                                <a href="{{ path('modifier_activite', {'id': activite.id}) }}" title="Modifier" style="color:#fff;">
                                    <i class="fa fa-pencil fa-lg"></i>
                                </a>
                                <a href="#"
                                class="delete-activity-btn"
                                data-delete-url="{{ path('supprimer_activite', {'id': activite.id}) }}"
                                data-activity-name="{{ activite.nom }}"
                                title="Supprimer"
                                style="color:#fff;">
                                    <i class="fa fa-trash fa-lg"></i>
                                </a>
                            </div>

                            <!-- Image -->
                            <a href="#" class="img d-block" 
                               style="background-image: url('{{ asset('uploads/activities/' ~ activite.image|split('\\')|last) }}');">
                                <span class="price">${{ activite.prix }}/person</span>
                            </a>

                            <!-- Info -->
                            <div class="text p-4">
                                <span class="days">
                                    {{ activite.dateDebut ? activite.dateDebut|date('d M') : 'Date non définie' }}
                                    {{ activite.dateFin ? activite.dateFin|date('d M') : 'Date non définie' }}
                                </span>
                                <h3><a href="#">{{ activite.nom }}</a></h3>
                                <p class="location">
                                    <span class="fa fa-map-marker"></span> 
                                    {{ activite.destination ? activite.destination.nom : 'Non défini' }}
                                </p>

                                <!-- Places et Note sur la même ligne, Type en dessous -->
                                <div style="margin-top:10px;">
                                    <div style="display:flex; align-items:center; gap:20px; margin-bottom:5px;">
                                        <!-- Places -->
                                        <div style="display:flex; align-items:center; gap:5px;">
                                            <img src="{{ asset('assets/icons/community.svg') }}" style="width:25px; height:25px;">
                                            {{ activite.maxPlaces ?: '0' }} Places
                                        </div>
                                        <!-- Note moyenne -->
                                        <div style="display:flex; align-items:center; gap:5px;">
                                            <img src="{{ asset('assets/icons/star.svg') }}" style="width:20px; height:20px;">
                                            {{ activite.noteMoyenne|round(1) }}
                                        </div>
                                    </div>
                                    <!-- Type d'activité -->
                                    <div>
                                        <span class="flaticon-sun-umbrella"></span> {{ activite.typeActivite ?: 'Non défini' }}
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                {% endfor %}
            {% else %}
                <p class="text-center">Vous n'avez aucune activité pour le moment.</p>
            {% endif %}
        </div>
    </div>
</section>
