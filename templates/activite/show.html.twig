<form id="logoutFormShow" method="get" action="{{ path('app_logout') }}" style="display:none;"></form>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
  function confirmLogoutShow(e) {
    e.preventDefault();
    Swal.fire({
      title: 'Déconnexion',
      text: 'Êtes-vous sûr de vouloir vous déconnecter ?',
      icon: 'question',
      showCancelButton: true,
      confirmButtonColor: '#223f91',
      cancelButtonColor: '#6c757d',
      confirmButtonText: 'Oui, me déconnecter',
      cancelButtonText: 'Annuler'
    }).then((result) => {
      if (result.isConfirmed) document.getElementById('logoutFormShow').submit();
    });
  }
</script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.waitlist-notif-link').forEach(function (link) {
        link.addEventListener('click', function (e) {
            e.preventDefault();

            const activiteId = this.dataset.activiteId;
            const message = this.dataset.message;
            const maxTickets = parseInt(this.dataset.maxTickets || '1', 10);

            Swal.fire({
                title: 'Place disponible',
                html: `
                    <div style="font-size:14px; color:#444; line-height:1.5; margin-bottom:14px;">
                        ${message}<br><br>
                        Vous pouvez réserver de <strong>1</strong> à <strong>${maxTickets}</strong> ticket(s).
                    </div>

                    <div style="text-align:left;">
                        <label style="font-size:14px; font-weight:600; color:#223f91; display:block; margin-bottom:8px;">
                            Nombre de tickets
                        </label>
                        <input id="hold-ticket-qty" type="number" min="1" max="${maxTickets}" value="1"
                               style="width:100%; height:42px; border:1px solid #d9e2f2; border-radius:10px; padding:0 12px;">
                    </div>
                `,
                icon: 'info',
                showCancelButton: true,
                showDenyButton: true,
                confirmButtonText: 'Confirmer',
                denyButtonText: 'Refuser',
                cancelButtonText: 'Fermer',
                confirmButtonColor: '#223f91',
                denyButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                preConfirm: () => {
                    const qty = parseInt(document.getElementById('hold-ticket-qty').value, 10);

                    if (!qty || qty < 1 || qty > maxTickets) {
                        Swal.showValidationMessage('Choisissez une quantité valide.');
                        return false;
                    }

                    return qty;
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    const qty = result.value;
                    window.location.href = '/waitlist/confirm/' + activiteId + '?qty=' + qty;
                } else if (result.isDenied) {
                    window.location.href = '/waitlist/refuse/' + activiteId;
                }
            });
        });
    });
});
</script>

