<nav class="layout-navbar container-xxl navbar-detached navbar navbar-expand-xl align-items-center bg-navbar-theme" id="layout-navbar">
  <div class="layout-menu-toggle navbar-nav align-items-xl-center me-4 me-xl-0 d-xl-none">
    <a class="nav-item nav-link px-0 me-xl-6" href="javascript:void(0)">
      <i class="icon-base bx bx-menu icon-md"></i>
    </a>
  </div>
  <div class="navbar-nav-right d-flex align-items-center justify-content-end" id="navbar-collapse">
    <div class="navbar-nav align-items-center me-auto">
  {% set currentRoute = app.request.attributes.get('_route') %}

<form method="get"
      action="{% if currentRoute starts with 'admin_reservation' %}
                  {{ path('admin_reservations_tickets') }}
              {% else %}
                  {{ path('activite_admin') }}
              {% endif %}"
      class="nav-item d-flex align-items-center w-100">

    <input type="hidden"
           name="tab"
           value="{% if currentRoute starts with 'admin_reservation' %}reservation{% else %}activite{% endif %}">

    <span class="w-px-22 h-px-22">
      <i class="icon-base bx bx-search icon-md"></i>
    </span>

    <input
        type="text"
        {% if not (currentRoute starts with 'admin_reservation') %}id="admin-activity-search"{% endif %}
        name="search"
        value="{{ app.request.get('search') }}"
        class="form-control border-0 shadow-none ps-1 ps-sm-2"
        placeholder="{% if currentRoute starts with 'admin_reservation' %}
            Rechercher réservation ou ticket...
        {% else %}
            Rechercher activité...
        {% endif %}"
    />
</form>
</div>
    <ul class="navbar-nav flex-row align-items-center ms-md-auto">
    <li class="nav-item dropdown me-3">
  <a class="nav-link position-relative" href="#" data-bs-toggle="dropdown">
    <i class="icon-base bx bx-bell icon-md"></i>

    <!-- badge notification -->
    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
       {% if notifications is defined %}
          {{ notifications|length }}
      {% else %}
          0
      {% endif %}
    </span>
  </a>

  <!-- dropdown notifications -->
  <ul class="dropdown-menu dropdown-menu-end p-2" style="width: 300px;">
  <li class="dropdown-header">Notifications</li>
  <li><hr class="dropdown-divider"></li>

  {% if notifications is defined and notifications|length > 0 %}

  {% for notif in notifications %}
    <li>
  <a class="dropdown-item notif-item" href="#" title="{{ notif.message }}">
    🔔 {{ notif.message|length > 40 ? notif.message|slice(0, 40) ~ '...' : notif.message }}
  </a>
</li>
  {% endfor %}

{% else %}

  <li>
    <a class="dropdown-item text-muted text-center">
      Aucune notification
    </a>
  </li>

{% endif %}

<li>
  <a class="dropdown-item text-center text-success"
     href="{{ path('admin_notifications_clear') }}">
    ✔ Marquer comme lues
  </a>
</li>
</ul>
</li>
      <li class="nav-item navbar-dropdown dropdown-user dropdown">
        <a class="nav-link dropdown-toggle hide-arrow p-0" href="javascript:void(0);" data-bs-toggle="dropdown">
          <div class="avatar avatar-online">
            <img src="{{ asset('assetsback/img/avatars/1.png') }}" alt class="w-px-40 h-auto rounded-circle" />
          </div>
        </a>
        <ul class="dropdown-menu dropdown-menu-end">
          <li>
            <a class="dropdown-item" href="#">
              <div class="d-flex">
                <div class="flex-shrink-0 me-3">
                  <div class="avatar avatar-online">
                    {% if app.session.get('user_photo') %}
                      <img src="{{ asset(app.session.get('user_photo')) }}" alt class="w-px-40 h-auto rounded-circle" style="object-fit:cover;" />
                    {% else %}
                      <img src="{{ asset('assetsback/img/avatars/1.png') }}" alt class="w-px-40 h-auto rounded-circle" />
                    {% endif %}
                  </div>
                </div>
                <div class="flex-grow-1">
                  <h6 class="mb-0">{{ app.session.get('user_prenom') }} {{ app.session.get('user_nom') }}</h6>
                  <small class="text-body-secondary">{{ app.session.get('user_role') }}</small>
                </div>
              </div>
            </a>
          </li>
          <li><div class="dropdown-divider my-1"></div></li>
          <li>
            <a class="dropdown-item text-danger" href="#" onclick="confirmAdminLogout(event)">
              <i class="icon-base bx bx-power-off icon-md me-3"></i><span>Déconnexion</span>
            </a>
          </li>
        </ul>

        {# Formulaire de déconnexion caché #}
        <form id="adminLogoutForm" method="get" action="{{ path('app_logout') }}" style="display:none;"></form>

        <script>
        function confirmAdminLogout(e) {
            e.preventDefault();
            Swal.fire({
                title: 'Déconnexion',
                text: 'Êtes-vous sûr de vouloir vous déconnecter ?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#223f91',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Oui, me déconnecter',
                cancelButtonText: 'Annuler'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('adminLogoutForm').submit();
                }
            });
        }
        </script>
        <style>
        .notif-item {
        display: block;
        max-width: 250px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
        </style>

      </li>
    </ul>
  </div>
</nav>