    {# USER HAS A RESERVED PLACE (HOLD) #}
    <button
        type="button"
        class="btn btn-sm"
        style="
            background: #16a34a;
            color: white;
            border: none;
            border-radius: 12px;
            padding: 8px 16px;
            font-weight: 700;
        "
        onclick="openHoldPopup({{ activite.id }}, '{{ activite.nom|e('js') }}')"
    >
        Confirmer ma place
    </button>

    <span style="
        background: #dcfce7;
        color: #166534;
        padding: 3px 8px;
        border-radius: 10px;
        font-size: 12px;
    ">
        Place réservée pour vous
    </span>

{% elseif activityCanBook[activite.id] %}
    {# NORMAL BOOKING #}
    <button
        type="button"
        class="btn btn-sm"
        data-toggle="modal"
