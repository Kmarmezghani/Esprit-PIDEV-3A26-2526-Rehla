<style>
.search-input .form-control {
border: 2px solid #e9ecef;
border-right: none;
border-radius: 50px 0 0 50px;
padding: 15px 20px;
font-size: 16px;
}

.search-input .btn {
border-radius: 0 50px 50px 0;
padding: 15px 30px;
font-weight: 600;
}

.badge-purple { background: linear-gradient(45deg, #6f42c1, #8b5cf6); color: white; }
.badge-blue { background: linear-gradient(45deg, #0d6efd, #4dabf7); color: white; }

.post-card {
border-radius: 20px !important;
overflow: hidden;
transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.post-card:hover {
transform: translateY(-5px);
box-shadow: 0 20px 40px rgba(0,0,0,0.1) !important;
}

.navbar-brand {
font-size: 1.8rem;
font-weight: 800;
}

.breadcrumbs {
font-size: 1.1rem;
}

.bread {
font-size: 3rem;
font-weight: 700;
color: white;
text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
}

.btn-primary {
background: linear-gradient(45deg, #667eea 0%, #764ba2 100%);
border: none;
padding: 12px 30px;
border-radius: 50px;
font-weight: 600;
transition: all 0.3s ease;
}

.btn-primary:hover {
transform: translateY(-2px);
box-shadow: 0 10px 20px rgba(102, 126, 234, 0.4);
}

.fa-heart.text-danger {
color: #e74c3c !important;
}

.badge {
padding: 8px 12px;
border-radius: 20px;
font-size: 0.8rem;
font-weight: 500;
}

.badge-light { background: #f8f9fa; color: #495057; }
.badge-primary { background: linear-gradient(45deg, #007bff, #0056b3); color: white; }

.card-body {
background: linear-gradient(145deg, #ffffff, #f8f9fa);
}

.overlay {
background: rgba(0,0,0,0.4);
}

.hero-wrap {
background-size: cover;
background-position: center;
min-height: 500px;
display: flex;
align-items: center;
}

@media (max-width: 768px) {
.search-input .form-control, .search-input .btn {
border-radius: 10px;
margin-bottom: 10px;
} .col-md-3 { order: -1; margin-bottom: 20px; }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
const hearts = document.querySelectorAll('.fa-heart');
hearts.forEach(heart => {
heart.addEventListener('click', function() {
this.classList.toggle('text-danger');
const count = this.nextElementSibling;
const current = parseInt(count.textContent);
count.textContent = this.classList.contains('text-danger') ? current + 1 : current - 1;
});
});
});
</script>

