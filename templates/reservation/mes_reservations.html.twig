                    <div class="table-responsive p-3">
                        <table class="table align-middle table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Date Début</th>
                                    <th>Date Fin</th>
                                    <th>Destination</th>
                                    <th>Tickets</th>
                                    <th>Coût Total</th>
                                    <th>Statut</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for reservation in reservations %}
                                    <tr class="reservation-row" data-id="{{ reservation.id }}" style="cursor:pointer;">
                                        <td>{{ reservation.dateDebut|date('d M Y') }}</td>
                                        <td>{{ reservation.dateFin|date('d M Y') }}</td>
                                        <td>
                                            <i class="fa fa-map-marker text-primary"></i>
                                            {{ reservation.destination ? reservation.destination.nom : 'Non défini' }}
                                        </td>
                                        <td><span>{{ reservation.nb_Tickets }}</span></td>
                                        <td>
                                            <strong class="price-cell" data-tnd="{{ reservation.coutTotal }}">
                                                {{ reservation.coutTotal }} TND
                                            </strong>
                                        </td>
                                        <td>
                                            {% set statut = reservation.statut|lower %}
                                            {% if statut == 'confirmée' %}
                                                <span class="badge rounded-pill px-3 py-2 bg-success"><i class="fa fa-check"></i> Confirmée</span>
                                            {% elseif statut == 'réservée' %}
                                                <span class="badge rounded-pill px-3 py-2 bg-warning text-dark"><i class="fa fa-clock"></i> réservée</span>
                                            {% elseif statut == 'annulée' %}
                                                <span class="badge rounded-pill px-3 py-2 bg-danger"><i class="fa fa-times"></i> Annulée</span>
                                            {% else %}
                                                <span class="badge rounded-pill px-3 py-2 bg-secondary">{{ reservation.statut }}</span>
                                            {% endif %}
                                        </td>
                                        <td class="text-center" onclick="event.stopPropagation()">
                                            <div class="dropdown">
                                                <button class="btn btn-sm btn-outline-secondary rounded-pill px-3" type="button" data-bs-toggle="dropdown">
                                                    <i class="fa fa-ellipsis-v"></i>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                                                    <li>
                                                        <a class="dropdown-item" href="{{ path('user_reservation_edit', {id: reservation.id}) }}">
                                                            <i class="fa fa-pencil text-primary me-2"></i> Modifier
                                                        </a>
                                                    </li>
                                                    <li><hr class="dropdown-divider"></li>
                                                    <li>
                                                        <a class="dropdown-item text-danger" href="#" onclick="deleteReservation(event, {{ reservation.id }})">
                                                            <i class="fa fa-trash me-2"></i> Supprimer
                                                        </a>
                                                        <form id="delete-form-{{ reservation.id }}" method="post"
                                                              action="{{ path('user_reservation_delete', {id: reservation.id}) }}" style="display:none;">
                                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ reservation.id) }}">
                                                        </form>
                                                    </li>
                                                </ul>
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
