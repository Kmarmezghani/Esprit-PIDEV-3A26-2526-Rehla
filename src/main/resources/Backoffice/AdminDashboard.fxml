<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="Controllers.AdminDashboardController"
            stylesheets="@/Backoffice/css/styling.css"
            style="-fx-background-color: #f5f7ff;">

    <!-- TOP BAR -->
    <top>
        <HBox alignment="CENTER_LEFT"
              style="-fx-background-color: #223f91;"
              prefHeight="50">

            <Label text="📊 Admin Analytics Dashboard"
                   textFill="white"
                   style="-fx-font-size:18px; -fx-font-weight:bold;">
                <HBox.margin>
                    <Insets left="20"/>
                </HBox.margin>
            </Label>

        </HBox>
    </top>

    <!-- CENTER CONTENT -->
    <center>
        <VBox spacing="20">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <!-- KPI CARDS -->
            <HBox spacing="20">

                <VBox style="-fx-background-color:white; -fx-padding:20; -fx-background-radius:10;">
                    <Label text="Total Revenue"/>
                    <Label fx:id="lblTotalRevenue"
                           style="-fx-font-size:20px; -fx-font-weight:bold;"/>
                </VBox>

                <VBox style="-fx-background-color:white; -fx-padding:20; -fx-background-radius:10;">
                    <Label text="Most Reserved Destination"/>
                    <Label fx:id="lblMostDestination"
                           style="-fx-font-size:16px; -fx-font-weight:bold;"/>
                </VBox>

                <VBox style="-fx-background-color:white; -fx-padding:20; -fx-background-radius:10;">
                    <Label text="Conversion Rate"/>
                    <Label fx:id="lblConversionRate"
                           style="-fx-font-size:16px; -fx-font-weight:bold;"/>
                </VBox>

            </HBox>

            <!-- CHART -->
            <BarChart fx:id="revenueChart" prefHeight="350">

                <xAxis>
                    <CategoryAxis label="Month"/>
                </xAxis>

                <yAxis>
                    <NumberAxis label="Revenue (TND)"/>
                </yAxis>

            </BarChart>

        </VBox>
    </center>

</BorderPane>