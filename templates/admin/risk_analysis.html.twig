{% extends 'adminbase.html.twig' %}
{% block title %}Analyse IA des Risques – Rehla Admin{% endblock %}
{% block sidebar %}{% include 'admin/Partials/sidebar.html.twig' %}{% endblock %}
{% block navbar %}{% include 'admin/Partials/navbar.html.twig' %}{% endblock %}

{% block body %}

<div class="d-flex align-items-center justify-content-between mb-4">
  <div>
    <h4 class="fw-bold mb-1" style="color:#223f91;">
      <i class="bx bx-shield-alt-2 me-2"></i> Analyse IA des Comptes à Risque
    </h4>
    <p class="text-muted mb-0" style="font-size:13px;">
      Gemini AI évalue chaque utilisateur selon son comportement et génère un niveau de risque.
    </p>
  </div>
  <a href="{{ path('admin_users') }}" class="btn btn-outline-secondary btn-sm">
    <i class="bx bx-arrow-back me-1"></i> Retour
  </a>
</div>


{% if results is empty %}
  <div class="alert alert-warning">
    <i class="bx bx-error me-2"></i>
    L'analyse Gemini n'a retourné aucun résultat. Vérifiez la clé API Gemini dans le fichier <code>.env</code>.
  </div>
{% else %}

{# ── Résumé ── #}
{% set nb_eleve  = results|filter(r => r.niveau == 'ÉLEVÉ')|length %}
{% set nb_moyen  = results|filter(r => r.niveau == 'MOYEN')|length %}
{% set nb_faible = results|filter(r => r.niveau == 'FAIBLE')|length %}

<div class="row g-3 mb-4">
  <div class="col-md-4">
    <div class="card border-0 shadow-sm text-center p-3" style="border-radius:14px; border-left:4px solid #dc3545 !important;">
      <div style="font-size:28px; font-weight:800; color:#dc3545;">{{ nb_eleve }}</div>
      <div class="text-muted" style="font-size:12px;">Risque ÉLEVÉ</div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card border-0 shadow-sm text-center p-3" style="border-radius:14px; border-left:4px solid #fd7e14 !important;">
      <div style="font-size:28px; font-weight:800; color:#fd7e14;">{{ nb_moyen }}</div>
      <div class="text-muted" style="font-size:12px;">Risque MOYEN</div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card border-0 shadow-sm text-center p-3" style="border-radius:14px; border-left:4px solid #28a745 !important;">
      <div style="font-size:28px; font-weight:800; color:#28a745;">{{ nb_faible }}</div>
      <div class="text-muted" style="font-size:12px;">Risque FAIBLE</div>
    </div>
  </div>
</div>

{# ── Tableau des résultats ── #}
<div class="card border-0 shadow-sm" style="border-radius:14px;">
  <div class="p-3 border-bottom d-flex align-items-center gap-2">
    <i class="bx bx-brain" style="color:#223f91; font-size:20px;"></i>
    <strong style="color:#223f91;">Résultats de l'analyse Gemini</strong>
    <span class="badge ms-auto" style="background:#223f91;">{{ results|length }} utilisateurs analysés</span>
  </div>
  <div class="table-responsive">
    <table class="table table-hover mb-0">
      <thead style="background:#f8f9fa;">
        <tr>
          <th>Utilisateur</th>
          <th>Rôle</th>
          <th>Statut</th>
          <th>Posts suspects</th>
          <th>Niveau de risque</th>
          <th>Explication IA</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        {% for user in users %}
          {% if user.role != 'ADMIN' and results[user.id] is defined %}
            {% set risk = results[user.id] %}
            {% if risk.niveau == 'ÉLEVÉ' %}
              {% set color = '#dc3545' %}{% set bg = '#fff5f5' %}
            {% elseif risk.niveau == 'MOYEN' %}
              {% set color = '#fd7e14' %}{% set bg = '#fff8f0' %}
            {% else %}
              {% set color = '#28a745' %}{% set bg = '#f0fff4' %}
            {% endif %}
            <tr style="background:{{ bg }};">
              <td>
                <strong>{{ user.nom }} {{ user.prenom }}</strong><br>
                <small class="text-muted">{{ user.email }}</small>
              </td>
              <td><span class="badge" style="background:#223f91;">{{ user.role }}</span></td>
              <td>
                {% if user.statutCompte == 'ACTIF' %}
                  <span class="badge bg-success">ACTIF</span>
                {% elseif user.statutCompte == 'SUSPENDU' %}
                  <span class="badge bg-danger">SUSPENDU</span>
                {% else %}
                  <span class="badge bg-secondary">INACTIF</span>
                {% endif %}
              </td>
              <td>
                <span class="fw-bold" style="color:{{ user.nbPostsSuspects > 0 ? '#dc3545' : '#28a745' }};">
                  {{ user.nbPostsSuspects }}
                </span>
              </td>
              <td>
                <span class="badge fs-6 px-3 py-2" style="background:{{ color }}; color:#fff;">
                  {{ risk.niveau }}
                </span>
              </td>
              <td style="font-size:12px; color:#555; max-width:280px;">{{ risk.raison }}</td>
              <td>
                <a href="{{ path('admin_user_edit', {id: user.id}) }}" class="btn btn-sm btn-outline-primary" style="font-size:11px;">
                  <i class="bx bx-edit"></i> Modifier
                </a>
              </td>
            </tr>
          {% endif %}
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% endif %}

{% endblock %}
