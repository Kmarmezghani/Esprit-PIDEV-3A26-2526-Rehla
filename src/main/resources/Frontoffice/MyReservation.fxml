<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.layout.StackPane?>
<AnchorPane prefHeight="700.0" prefWidth="1100.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.MyReservationsController" stylesheets="@css/reviews.css,@/Frontoffice/css/profile-menu.css,@/Frontoffice/css/home.css">

    <children>
        <BorderPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

            <!-- Top Navigation Bar -->
            <top>
                <HBox alignment="CENTER_LEFT"
                      prefHeight="70.0"
                      minHeight="70.0"
                      maxHeight="70.0"
                      styleClass="topBlueBar"
                      BorderPane.alignment="CENTER">

                    <children>
                        <ImageView fitHeight="44.0" preserveRatio="true" pickOnBounds="true" styleClass="brandLogo">
                            <image>
                                <Image url="@../Backoffice/icons/IMG_20260125_122708_191-removebg-preview.png"/>
                            </image>
                        </ImageView>

                        <Region HBox.hgrow="ALWAYS"/>

                        <HBox alignment="CENTER" spacing="22.0">
                            <Button onAction="#goToHome" text="Home" styleClass="navBtnBlue"/>
                            <Button onAction="#goToDestinations" text="Destinations" styleClass="navBtnBlue"/>
                            <Button onAction="#goToPosts" text="Posts" styleClass="navBtnBlue"/>
                            <Button onAction="#goToactivities" text="Activities" styleClass="navBtnBlue"/>
                            <Button text="About" styleClass="navBtnBlue"/>
                        </HBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Button fx:id="btnNotif" onAction="#openNotifications" styleClass="iconBtn" text="🔔">
                            <HBox.margin><Insets right="10.0"/></HBox.margin>
                        </Button>

                        <Button fx:id="btnProfile" onAction="#openProfileMenu" styleClass="iconBtn" text="👤">
                            <HBox.margin><Insets right="14.0"/></HBox.margin>
                            <contextMenu>
                                <ContextMenu fx:id="profileMenu" styleClass="profileMenu">
                                    <items>

                                        <MenuItem onAction="#goToMyProfile" text="My Profile">
                                            <graphic>
                                                <SVGPath styleClass="menuIcon"
                                                         content="M12 12c2.21 0 4-1.79 4-4S14.21 4 12 4 8 5.79 8 8s1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                                            </graphic>
                                        </MenuItem>

                                        <MenuItem onAction="#goToMyPosts" text="My Posts">
                                            <graphic>
                                                <SVGPath styleClass="menuIcon"
                                                         content="M9 6l1.5-2h3L15 6h3a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h3zm3 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zm0-2.2a1.8 1.8 0 1 1 0-3.6 1.8 1.8 0 0 1 0 3.6z"/>
                                            </graphic>
                                        </MenuItem>

                                        <MenuItem onAction="#goToMyReservations" text="My Reservations">
                                            <graphic>
                                                <SVGPath styleClass="menuIcon"
                                                         content="M7 2v2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-2V2h-2v2H9V2H7zm12 6H5V6h14v2zM7 12h3v3H7v-3zm4 0h3v3h-3v-3zm4 0h3v3h-3v-3z"/>
                                            </graphic>
                                        </MenuItem>

                                        <MenuItem fx:id="menuMyActivities"
                                                  onAction="#goToMyActivities"
                                                  text="My Activities">
                                            <graphic>
                                                <SVGPath styleClass="menuIcon"
                                                         content="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm0 2a8 8 0 1 1 0 16 8 8 0 0 1 0-16zm3.2 4.8l-1.9 5-5 1.9 1.9-5 5-1.9z"/>
                                            </graphic>
                                        </MenuItem>

                                        <SeparatorMenuItem/>

                                        <MenuItem onAction="#handleLogout" text="Logout">
                                            <graphic>
                                                <SVGPath styleClass="menuIconLogout"
                                                         content="M10 17l1.41-1.41L9.83 14H20v-2H9.83l1.58-1.59L10 9l-5 5 5 5zM4 21h2V3H4v18z"/>
                                            </graphic>
                                        </MenuItem>

                                    </items>
                                </ContextMenu>
                            </contextMenu>
                        </Button>

                        <HBox styleClass="winBox" alignment="CENTER_RIGHT" spacing="0">
                            <Button onAction="#minwindow" styleClass="winCtrlBtn" focusTraversable="false">
                                <graphic>
                                    <SVGPath content="M2 8 H12"
                                             stroke="white"
                                             strokeWidth="1.8"
                                             strokeLineCap="round"/>
                                </graphic>
                            </Button>

                            <Button onAction="#maxwindow" styleClass="winCtrlBtn" focusTraversable="false">
                                <graphic>
                                    <SVGPath content="M3 3 H11 V11 H3 Z"
                                             fill="transparent"
                                             stroke="white"
                                             strokeWidth="1.6"
                                             strokeLineJoin="round"/>
                                </graphic>
                            </Button>

                            <Button focusTraversable="false" onAction="#closewindow" styleClass="winCtrlClose" text="">
                                <graphic>
                                    <SVGPath content="M4 4 L12 12 M12 4 L4 12"
                                             fill="transparent"
                                             stroke="white"
                                             strokeLineCap="round"
                                             strokeWidth="1.8"/>
                                </graphic>
                            </Button>
                        </HBox>

                    </children>

                    <padding>
                        <Insets left="30.0" right="30.0"/>
                    </padding>
                </HBox>
            </top>


            <!-- ================= CENTER CONTENT ================= -->
            <center>
                <ScrollPane fitToWidth="true" style="-fx-background-color: #ffffff;">

                    <content>
                        <VBox spacing="30" style="-fx-background-color: #ffffff;">

                            <padding>
                                <Insets bottom="40" left="40" right="40" top="30" />
                            </padding>

                            <!-- ===== TITLE ===== -->
                            <Label text="📅 My Reservations" textFill="#223f91">
                                <font>
                                    <Font name="System Bold" size="32" />
                                </font>
                            </Label>

                            <!-- ===== RESERVATION SECTION ===== -->
                            <VBox spacing="15">

                                <HBox alignment="CENTER_LEFT" spacing="15">

                                    <Label text="Reservations" textFill="#3A5BC7">
                                        <font>
                                            <Font name="System Bold" size="20" />
                                        </font>
                                    </Label>

                                    <Region HBox.hgrow="ALWAYS" />
                                </HBox>

                                <TableView fx:id="tableReservation" prefHeight="250" style="-fx-background-radius: 12;                                                   -fx-border-radius: 12;                                                   -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 8,0,0,2);">

                                    <columns>
                                        <TableColumn fx:id="colDateDebut" prefWidth="128.79998397827148" text="Start Date" />
                                        <TableColumn fx:id="colDateFin" prefWidth="152.0000457763672" text="End Date" />
                                        <TableColumn fx:id="colStatut" prefWidth="122.4000244140625" text="Status" />
                                        <TableColumn fx:id="colCoutTotal" prefWidth="146.39996337890625" text="Total Cost" />
                                        <TableColumn fx:id="colNbrTickets" prefWidth="132.79998779296875" text="Number of Tickets" />
                                        <TableColumn fx:id="colDestination" minWidth="0.0" prefWidth="141.5999755859375" text="Destination" />
                                        <TableColumn fx:id="colDeleteReservation" prefWidth="55.0" />
                                        <TableColumn fx:id="colPdf" prefWidth="55.0" />
                                        <TableColumn fx:id="colPay" prefWidth="75.20001220703125" />
                                    </columns>
                                </TableView>

                            </VBox>

                            <!-- ===== TICKET SECTION ===== -->
                            <!-- ===== CALENDAR SECTION ===== -->
                            <VBox spacing="15" VBox.vgrow="ALWAYS">

                                <Label text="Calendar View" textFill="#3A5BC7">
                                    <font>
                                        <Font name="System Bold" size="20" />
                                    </font>
                                </Label>

                                <AnchorPane fx:id="calendarContainer" style="-fx-background-color: #f5f7fb;                        -fx-background-radius: 12;                        -fx-border-radius: 12;" VBox.vgrow="ALWAYS" />

                            </VBox>
                        </VBox>
                    </content>
                </ScrollPane>
            </center>

        </BorderPane>
    </children>
</AnchorPane>
