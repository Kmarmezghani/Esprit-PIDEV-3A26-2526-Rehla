{% extends 'base.html.twig' %}


{% block body %}

{% if type == 'sent' %}
<div class="msg-row sent-row">
    <div>

        {% if image %}
            <img src="/{{ image }}" class="chat-img">
        {% else %}
            <div class="msg sent">{{ message }}</div>
        {% endif %}

        <div class="msg-time text-right">{{ time }}</div>
    </div>
</div>
{% else %}
<div class="msg-row received-row">
    <img class="avatar2" src="{{ asset('assets/images/default-user.png') }}">
    <div>

        {% if image %}
            <img src="/{{ image }}" class="chat-img">
        {% else %}
            <div class="msg received">{{ message }}</div>
        {% endif %}

        <div class="msg-time">{{ time }}</div>
    </div>
</div>
{% endif %}

{% endblock %}