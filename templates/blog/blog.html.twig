    width: 35px;
    height: 35px;
    border-radius: 50%;
    margin-right: 8px;
}

.chat-user .name {
    font-weight: bold;
    font-size: 14px;
}

.chat-user .status {
    font-size: 11px;
}

/* ACTIONS */
.chat-actions i {
    margin-left: 10px;
    cursor: pointer;
}

/* BODY */
.chat-body {
    flex: 1;
    padding: 10px;
    overflow-y: auto;
    background: #f0f2f5;
}

/* MESSAGES */
.msg {
  display: inline-block;
  max-width: 65%;
  min-width: fit-content; 

  padding: 8px 12px;
  border-radius: 18px;
  font-size: 13px;

  word-break: normal;
  overflow-wrap: break-word;
}

.chat-body,
.msg-row,
.msg {
  word-break: normal ;
  overflow-wrap: break-word;
  white-space: normal;
}
.sent {
    background: #1877f2;
    color: white;
    margin-left: auto;
    display: block;
    width: fit-content;
}


.received {
    background: #e4e6eb;
    color: black;
    display: block;
    width: fit-content; /* 🔥 clé */
}


/* FOOTER */
.chat-footer {
  display: flex;
  align-items: center;
  padding: 8px;
  background: #fff;
}

/* bouton + */
.left-icons i {
  font-size: 18px;
  color: #1877f2;
  margin-right: 8px;
  cursor: pointer;
}

/* zone input */
.input-box {
  flex: 1;
  position: relative;
}

/* input style messenger */
.input-box input {
  width: 100%;
  border: none;
  outline: none;
  background: #f0f2f5;
  padding: 10px 40px 10px 12px;
  border-radius: 20px;
  font-size: 14px;
}

/* icone dans input (smile) */
.inside-icons {
  position: absolute;
  right: 10px;
  top: 50%;
  transform: translateY(-50%);
}

.inside-icons i {
  color: #1877f2;
  font-size: 16px;
  cursor: pointer;
}

/* bouton send */
.right-icons i {
  font-size: 20px;
  color: #1877f2;
  margin-left: 8px;
  cursor: pointer;
}




.msg-row > div {
  flex: 1;
  max-width: 100%;
}
/* alignement ligne message */
.msg-row {
  display: flex;
  align-items: flex-end;
  margin-bottom: 8px;
}

/* received à gauche */
.received-row {
  justify-content: flex-start;
}

/* sent à droite */
.sent-row {
  justify-content: flex-end;
  flex-direction: column;
  align-items: flex-end;
}

/* avatar receiver */
.avatar2 {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  margin-right: 8px;
  object-fit: cover;
}

/* heure message */
.msg-time {
  font-size: 11px;
  color: gray;
  margin-top: 2px;
  margin-left: 5px;
  
}

/* heure côté sender alignée droite */
.sent-row .msg-time {
  margin-right: 5px;
}

/*-------------------image discussion-----------------*/
#imageInput1 {
    display: none;
}
.chat-img {
    max-width: 220px;   /* limite largeur */
    max-height: 220px;  /* limite hauteur */
    width: auto;
    height: auto;
    border-radius: 12px;
    margin-top: 5px;
    object-fit: cover;
    display: block;
}

/*------------------------------------------------- GROUPS-------------------------------------------------------- */
.messenger-groups {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-behavior: smooth;
