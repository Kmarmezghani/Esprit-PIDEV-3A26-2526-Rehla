    let box = document.getElementById("translate-comment-box-" + commentId);
    let select = document.getElementById("select-comment-" + commentId);
    let targetDiv = document.getElementById("translation-comment-" + commentId);

    let commentElement = button.closest(".comment-bubble");
    let content = commentElement.querySelector(".comment-text").innerText;

    // 👉 afficher select
    box.style.display = "block";

    // 👉 ATTACHER UNE SEULE FOIS
    if (!select.dataset.listener) {

        select.onchange = async function () {

            let targetLang = this.value;

            targetDiv.innerText = "Traduction...";
            targetDiv.style.display = "block";

            try {
                let response = await fetch("/translate", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({
                        text: content,
                        target: targetLang
                    })
                });

                let data = await response.json();

                targetDiv.innerText = data.translation || "Erreur API";

            } catch (error) {
                console.error(error);
                targetDiv.innerText = "Erreur traduction";
            }
        };

        // ✅ marquer comme attaché
        select.dataset.listener = "true";
    }

});


