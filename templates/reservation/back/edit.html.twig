{% extends 'adminbase.html.twig' %}

{% block sidebar %}
  {% include 'admin/partials/sidebar.html.twig' %}
{% endblock %}

{% block navbar %}
  {% include 'admin/partials/navbar.html.twig' %}
{% endblock %}

{% block body %}
<div class="content-wrapper">
  <div class="container-xxl flex-grow-1 container-p-y">

    <div class="row mb-6 gy-6">
      <div class="col-xl">
        <div class="card">
          <div class="card-header">
            <h5 class="mb-0">Modifier Réservation</h5>
          </div>

          <div class="card-body">
            {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

            <div class="row">

              <div class="col-md-6 mb-4">
                  <label class="form-label">Date Début</label>
                  {{ form_widget(form.dateDebut, {'attr': {'class': 'form-control'}}) }}
                  {{ form_errors(form.dateDebut) }}
              </div>

              <div class="col-md-6 mb-4">
                  <label class="form-label">Date Fin</label>
                  {{ form_widget(form.dateFin, {'attr': {'class': 'form-control'}}) }}
                  {{ form_errors(form.dateFin) }}
              </div>

              <div class="col-md-6 mb-4">
                  <label class="form-label">Destination</label>
                  {{ form_widget(form.destination, {'attr': {'class': 'form-select'}}) }}
                  {{ form_errors(form.destination) }}
              </div>

              <div class="col-md-6 mb-4">
                  <label class="form-label">Statut</label>
                  {{ form_widget(form.statut, {'attr': {'class': 'form-select'}}) }}
                  {{ form_errors(form.statut) }}
              </div>

            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary">
                    Modifier Réservation
                </button>
            </div>

            {{ form_end(form) }}

          </div>
        </div>
      </div>
    </div>

  </div>
</div>
{% endblock %}