{% extends 'base.html.twig' %}

{% block title %}Book Your Tour!{% endblock %}

{% block body %}
<nav class="navbar navbar-expand-lg navbar-dark ftco_navbar bg-dark ftco-navbar-light" id="ftco-navbar">
		<div class="container">
			<a class="navbar-brand" href="index.html">
    
    <img src="{{ asset('assets/images/IMG_20260125_122708_191-removebg-preview.png') }}" alt="Rehla Logo" class="logo-default" style="height:50px; display:block;">
    
    <img src="{{ asset('assets/images/bluelogo.png') }}" alt="Rehla Logo" class="logo-scrolled" style="height:50px; display:none;">
    <span style="display: block; font-size: 14px ; color: #223f91;">Explore the World</span>
</a>
			<button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#ftco-nav" aria-controls="ftco-nav" aria-expanded="false" aria-label="Toggle navigation">
				<span class="oi oi-menu"></span> Menu
			</button>

			<div class="collapse navbar-collapse" id="ftco-nav">
    <ul class="navbar-nav ml-auto">
    <li class="nav-item {% if app.request.attributes.get('_route') == 'home' %}active{% endif %}"><a href="{{ path('home') }}" class="nav-link">Accueil</a></li>
    <li class="nav-item"><a href="#" class="nav-link">À propos</a></li>
    <li class="nav-item {% if app.request.attributes.get('_route') == 'app_destination' %}active{% endif %}"><a href="{{ path('app_destination') }}" class="nav-link">Destinations</a></li>
    <li class="nav-item active"><a href="{{ path('activite') }}" class="nav-link">Activités</a></li>
    <li class="nav-item"><a href="#" class="nav-link">Hôtels</a></li>
    <li class="nav-item"><a href="{{ path('blog') }}" class="nav-link">Blog</a></li>

    {% if app.session.get('user_id') %}
    {# ── Utilisateur connecté ── #}
    <li class="nav-item dropdown ms-2 d-flex align-items-center">
        <a class="nav-link dropdown-toggle p-0 d-flex align-items-center"
           href="#" id="userDropdown" role="button"
           data-bs-toggle="dropdown" aria-expanded="false">
            {% if app.session.get('user_photo') %}
                <img src="{{ app.session.get('user_photo') }}" alt="Photo de profil"
                     class="rounded-circle" style="width:35px; height:35px; object-fit:cover;">
            {% else %}
                <img src="{{ asset('assets/images/default-user.png') }}" alt="Photo de profil"
                     class="rounded-circle" style="width:35px; height:35px; object-fit:cover;">
            {% endif %}
        </a>
        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown"
            style="min-width:210px; border-radius:12px; border:none; box-shadow:0 8px 30px rgba(0,0,0,0.12); padding:8px 0;">
            <li>
                <span class="dropdown-item-text text-muted" style="font-size:11px; padding:6px 16px;">
                    Connecté en tant que<br>
                    <strong style="color:#223f91;">{{ app.session.get('user_prenom') }} {{ app.session.get('user_nom') }}</strong>
                </span>
            </li>
            <li><hr class="dropdown-divider my-1"></li>
            <li><a class="dropdown-item d-flex align-items-center gap-2" href="{{ path('app_profile') }}"
                   style="padding:8px 16px; font-size:14px;">
                <i class="fa fa-user" style="width:18px; color:#223f91;"></i>
                <span>Mon profil</span>
            </a></li>
            <li><a class="dropdown-item d-flex align-items-center gap-2" href="{{ path('app_preferences') }}"
                   style="padding:8px 16px; font-size:14px;">
                <i class="fa fa-sliders" style="width:18px; color:#223f91;"></i>
                <span>Mes préférences</span>
            </a></li>
            
			{% if app.session.get('user_role') == 'GUIDE' %}
<li><a class="dropdown-item d-flex align-items-center gap-2" href="{{ path('mes_activites') }}"
       style="padding:8px 16px; font-size:14px;">
    <i class="fa fa-compass" style="width:18px; color:#223f91;"></i>
    <span>Mes activités</span>
</a></li>
{% endif %}
            <li><a class="dropdown-item d-flex align-items-center gap-2" href="{{ path('mes_reservations') }}"
                   style="padding:8px 16px; font-size:14px;">
                <i class="fa fa-calendar" style="width:18px; color:#223f91;"></i>
                <span>Mes réservations</span>
            </a></li>
            {% if app.session.get('user_role') == 'ADMIN' %}
            <li><hr class="dropdown-divider my-1"></li>
            <li><a class="dropdown-item d-flex align-items-center gap-2 text-primary" href="{{ path('admin_users') }}"
                   style="padding:8px 16px; font-size:14px;">
                <i class="fa fa-cogs" style="width:18px;"></i>
                <span>Administration</span>
            </a></li>
            {% endif %}
            <li><hr class="dropdown-divider my-1"></li>
            <li>
                <a class="dropdown-item d-flex align-items-center gap-2 text-danger" href="#"
                   onclick="confirmLogoutHome(event)"
                   style="padding:8px 16px; font-size:14px;">
                    <i class="fa fa-sign-out" style="width:18px;"></i>
                    <span>Déconnexion</span>
                </a>
            </li>
        </ul>
    </li>
    {% else %}
    {# ── Non connecté ── #}
    <li class="nav-item ms-2">
        <a href="{{ path('app_register') }}" class="nav-link">
            <i class="fa fa-user-plus"></i> &nbsp;S'inscrire
        </a>
    </li>
    {% endif %}
</ul>
</div>
		</div>
	</nav>
<section class="hero-wrap hero-wrap-2 js-fullheight" style="background-image: url('{{ asset('assets/images/bg_1.jpg')}}');">
  <div class="overlay"></div>
  <div class="container">
    <div class="row no-gutters slider-text js-fullheight align-items-end justify-content-center">
      <div class="col-md-9 ftco-animate pb-5 text-center">
         <p class="breadcrumbs"><span class="mr-2"><a href="{{ path('home') }}">Home <i class="fa fa-chevron-right"></i></a></span> <span>Activite List <i class="fa fa-chevron-right"></i></span></p>
         <h1 class="mb-0 bread">Activite List</h1>
     </div>
 </div>
</div>
</section>

<section class="ftco-section ftco-no-pb">
   <div class="container">
    <div class="d-flex justify-content-end mb-2">
  <a href="{{ path('activite') }}"
     style="font-size:13px; color:#6c757d; text-decoration:none;">
    <i class="fa fa-compass me-1"></i> Voir toutes les activités
  </a>
</div>
      <div class="row">
       <div class="col-md-12">
          <div class="search-wrap-1 ftco-animate">
            
<form action="{{ path('activite') }}" method="get" class="search-property-1">
  <div class="row no-gutters">
    <div class="col-lg d-flex">
      <div class="form-group p-4 border-0">
        <label for="#">Destination</label>
        <div class="form-field">
          <div class="icon"><span class="fa fa-search"></span></div>
          <input
            type="text"
            name="destination"
            class="form-control"
            placeholder="Search place"
            value="{{ filters.destination|default('') }}">
        </div>
      </div>
    </div>

    <div class="col-lg d-flex">
      <div class="form-group p-4">
        <label for="#">Check-in date</label>
        <div class="form-field">
          <div class="icon"><span class="fa fa-calendar"></span></div>
          <input
            type="date"
            name="date_debut"
            class="form-control"
            value="{{ filters.date_debut|default('') }}">
        </div>
      </div>
    </div>

    <div class="col-lg d-flex">
      <div class="form-group p-4">
        <label for="#">Check-out date</label>
        <div class="form-field">
          <div class="icon"><span class="fa fa-calendar"></span></div>
          <input
            type="date"
            name="date_fin"
            class="form-control"
            value="{{ filters.date_fin|default('') }}">
        </div>
      </div>
    </div>

    <div class="col-lg d-flex">
      <div class="form-group p-4">
        <label for="#">Price Limit</label>
        <div class="form-field">
          <div class="select-wrap">
            <div class="icon"><span class="fa fa-chevron-down"></span></div>
            <select name="prix_max" class="form-control">
              <option value="">No limit</option>
              <option value="50" {{ filters.prix_max|default('') == '50' ? 'selected' : '' }}>$50</option>
              <option value="100" {{ filters.prix_max|default('') == '100' ? 'selected' : '' }}>$100</option>
              <option value="200" {{ filters.prix_max|default('') == '200' ? 'selected' : '' }}>$200</option>
              <option value="300" {{ filters.prix_max|default('') == '300' ? 'selected' : '' }}>$300</option>
              <option value="500" {{ filters.prix_max|default('') == '500' ? 'selected' : '' }}>$500</option>
              <option value="1000" {{ filters.prix_max|default('') == '1000' ? 'selected' : '' }}>$1000</option>
            </select>
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg d-flex">
      <div class="form-group d-flex w-100 border-0">
        <div class="form-field w-100 align-items-center d-flex">
          <input type="submit" value="Search" class="align-self-stretch form-control btn btn-primary">
        </div>
      </div>
    </div>
  </div>
</form>
</div>
</div>
</div>
</div>
</section>

<section class="ftco-section">
   <div class="container">
       <div class="row">
           {% for activite in activites %}
               <div class="col-md-4 ftco-animate">
                   <div class="project-wrap">
                       
                       <a href="{{ path('activite_show', {'id': activite.id}) }}" class="img" 
   style="background-image: url('{{ asset('uploads/activities/' ~ activite.image|split('\\')|last) }}');">
    <span class="price">${{ activite.prix }}/person</span>
</a>
                       <div class="text p-4">
                           <span class="days">
                                {{ activite.dateDebut ? activite.dateDebut|date('d M') : 'Date non définie' }}
                                {{ activite.dateFin ? activite.dateFin|date('d M') : 'Date non définie' }}
                           </span>
                           <h3><a href="{{ path('activite_show', {'id': activite.id}) }}">{{ activite.nom }}</a></h3>
                           <p class="location">
                               <span class="fa fa-map-marker"></span> 
                               {{ activite.destination ? activite.destination.nom : 'Non défini' }}
                           </p>
                          <ul style="display: flex; align-items: center; gap: 15px;">
   <ul style="list-style: none; padding: 0; margin: 0;">
    
    
    <li style="display: flex; align-items: center; gap: 15px;">
        
        <div style="display: flex; align-items: center; gap: 5px;">
            <img src="{{ asset('assets/icons/community.svg') }}" style="width: 25px; height: 25px;">
            {{ activite.maxPlaces ?: '0' }} Places
        </div>

        <div style="display: flex; align-items: center; gap: 5px;">
            <img src="{{ asset('assets/icons/star.svg') }}" style="width: 20px; height: 20px;">
            {{ activite.noteMoyenne|round(1) }}
        </div>

    </li>

   
    <li>
        <span class="flaticon-sun-umbrella"></span> {{ activite.typeActivite ?: 'Non défini' }}
    </li>

</ul>
                       </div>
                   </div>
               </div>
           {% else %}
               <p>Aucune activité disponible</p>
           {% endfor %}
       </div>

       <div class="row mt-5">
           <div class="col text-center">
               <div class="block-27">
                   <ul>
                       <li><a href="#">&lt;</a></li>
                       <li class="active"><span>1</span></li>
                       <li><a href="#">2</a></li>
                       <li><a href="#">3</a></li>
                       <li><a href="#">4</a></li>
                       <li><a href="#">5</a></li>
                       <li><a href="#">&gt;</a></li>
                   </ul>
               </div>
           </div>
       </div>
   </div>
</section>
