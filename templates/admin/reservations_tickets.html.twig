{% extends 'adminbase.html.twig' %}

{% block sidebar %}
  {% include 'admin/partials/sidebar.html.twig' %}
{% endblock %}

{% block navbar %}
  {% include 'admin/partials/navbar.html.twig' %}
{% endblock %}

{% block body %}
<div class="row g-6">
  <div class="col-12">
    <div class="nav-align-top">

      <ul class="nav nav-pills mb-4 nav-fill" role="tablist">
        <li class="nav-item">
          <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-reservation">
            <i class="bx bx-calendar me-1"></i> Réservations
          </button>
        </li>
        <li class="nav-item">
          <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-ticket">
            <i class="bx bx-purchase-tag-alt me-1"></i>Tickets
          </button>
        </li>
      </ul>

      <div class="tab-content">

        {# ===== RESERVATIONS ===== #}
        <div class="tab-pane fade show active" id="tab-reservation">
          <div class="card">
            <div class="card-header">
              <h5>Liste des Réservations</h5>
            </div>
            <div class="d-flex justify-content-end mb-3">

  <select id="filterReservationStatus" class="form-select w-auto">
    <option value="">Tous statuts</option>
    <option value="Confirmée">Confirmée</option>
    <option value="Réservée">Réservée</option>
    <option value="Annulée">Annulée</option>
  </select>

</div>
            <div class="table-responsive">
              <table class="table table-striped">
                <thead>
                  <tr>
                    <th>Personne</th>
                    <th>Destination</th>
                    <th id="sortDate" style="cursor:pointer;">Date Réservation ⬍</th>
                    <th >Date Début </th>
                    <th>Date Fin</th>
                    <th>Nb Tickets</th>
                    <th>Coût Total</th>
                    <th>Statut</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  {% for reservation in reservations %}
                  <tr data-date="{{ reservation.dateReservation ? reservation.dateReservation|date('Y-m-d') : '' }}" class="reservation-row" ondblclick="window.location='{{ path('admin_reservation_tickets', {'id': reservation.id}) }}'" style="cursor:pointer;" data-status="{{ reservation.statut|lower  }}">
                    <td>{{ reservation.personne_id.nom ?? 'N/A' }}</td>
                    <td>{{ reservation.destination.nom ?? 'N/A' }}</td>
                    <td>{{ reservation.dateReservation ? reservation.dateReservation|date('d-m-Y') : 'N/A' }}</td>
                    <td>{{ reservation.dateDebut ? reservation.dateDebut|date('d-m-Y') : 'N/A' }}</td>
                    <td>{{ reservation.dateFin ? reservation.dateFin|date('d-m-Y') : 'N/A' }}</td>
                    <td>{{ reservation.nb_tickets }}</td>
                    <td>{{ reservation.coutTotal }} TND</td>
                    <td>
                      {% if reservation.statut == 'Confirmée' %}
                        <span class="badge bg-label-success">Confirmée</span>
                      {% elseif reservation.statut == 'réservée' %}
                        <span class="badge bg-label-warning">Réservée</span>
                      {% else %}
                        <span class="badge bg-label-danger">Annulée</span>
                      {% endif %}
                    </td>
                    <td>
                      <div class="dropdown">
                        <button class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown">
                          <i class="icon-base bx bx-dots-vertical-rounded"></i>
                        </button>
                        <div class="dropdown-menu">
                          <a class="dropdown-item" href="{{ path('admin_reservation_edit', {'id': reservation.id}) }}">
                            <i class="icon-base bx bx-edit-alt me-1"></i> Modifier
                          </a>
                          <button class="dropdown-item text-danger"
                                  data-bs-toggle="modal"
                                  data-bs-target="#deleteReservationModal{{ reservation.id }}">
                            <i class="icon-base bx bx-trash me-1"></i> Supprimer
                          </button>
                        </div>
                      </div>
                    </td>
                  </tr>
                  {% else %}
                  <tr>
                    <td colspan="9" class="text-center">Aucune réservation</td>
                  </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
          </div>
        </div>

        {# ===== TICKETS ===== #}
        <div class="tab-pane fade" id="tab-ticket">
          <div class="card">
            <div class="card-header d-flex justify-content-between">
              <h5>Liste des Tickets</h5>
              <a href="{{ path('admin_ticket_new') }}" class="btn btn-primary">
                <i class="bx bx-plus"></i> Ajouter Ticket
              </a>
            </div>
            <div class="d-flex justify-content-end mb-3">

  <select id="filterTicketType" class="form-select w-auto">
    <option value="">Tous types</option>
    <option value="Vol">Vol</option>
    <option value="Transport">Transport</option>
    <option value="Hotel">Hotel</option>
    <option value="Activité">Activité</option>
  </select>

</div>
            <div class="table-responsive text-nowrap">
              <table class="table">
                <thead>
                  <tr>
                    <th>Type</th>
                    <th id="sortDestination" style="cursor:pointer;">Destination ⬍</th>
                    <th>Prix</th>
                    <th>Status</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  {% for ticket in tickets %}
                  <tr class="ticket-row"
    data-type="{{ ticket.activite is not empty ? 'Activité' : ticket.type }}" data-destination="{{ ticket.destination ? ticket.destination.nom|lower : '' }}">
                    <td>{{ ticket.activite is not empty ? 'Activité' : ticket.type }}</td>
                    <td>{{ ticket.destination ? ticket.destination.nom : 'N/A' }}</td>
                    <td>{{ ticket.prix ? ticket.prix ~ ' TND' : 'N/A' }}</td>
                    <td>
                      {% set status = ticket.statut ?? 'Disponible' %}
                      {% if status == 'Disponible' %}
                        <span class="badge bg-label-success">Disponible</span>
                      {% elseif status == 'Reservé' %}
                        <span class="badge bg-label-warning">Reservé</span>
                      {% else %}
                        <span class="badge bg-label-danger">Annulé</span>
                      {% endif %}
                    </td>
                    <td>
                      <div class="dropdown">
                        <button class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown">
                          <i class="icon-base bx bx-dots-vertical-rounded"></i>
                        </button>
                        <div class="dropdown-menu">
                          <a class="dropdown-item" href="{{ path('admin_ticket_edit', {'id': ticket.id}) }}">
                            <i class="icon-base bx bx-edit-alt me-1"></i> Modifier
                          </a>
                          <button class="dropdown-item text-danger"
                                  data-bs-toggle="modal"
                                  data-bs-target="#deleteTicketModal{{ ticket.id }}">
                            <i class="icon-base bx bx-trash me-1"></i> Supprimer
                          </button>
                        </div>
                      </div>
                    </td>
                  </tr>
                  {% else %}
                  <tr>
                    <td colspan="5" class="text-center">Aucun ticket trouvé</td>
                  </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>

{# ===== MODALS RESERVATIONS ===== #}
{% for reservation in reservations %}
<div class="modal fade" id="deleteReservationModal{{ reservation.id }}" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Confirmation de suppression</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        Êtes-vous sûr de vouloir supprimer cette réservation ?
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
        <form method="post" action="{{ path('admin_reservation_delete', {'id': reservation.id}) }}">
          <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ reservation.id) }}">
          <button class="btn btn-danger">Supprimer</button>
        </form>
      </div>
    </div>
  </div>
</div>
{% endfor %}

{# ===== MODALS TICKETS ===== #}
{% for ticket in tickets %}
<div class="modal fade" id="deleteTicketModal{{ ticket.id }}" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Confirmation de suppression</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        Êtes-vous sûr de vouloir supprimer ce ticket ?
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
        <form method="post" action="{{ path('admin_ticket_delete', {'id': ticket.id}) }}">
          <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ ticket.id) }}">
          <button class="btn btn-danger">Supprimer</button>
        </form>
      </div>
    </div>
  </div>
</div>
{% endfor %}
{% if selectedReservation is defined %}
<script>
document.addEventListener("DOMContentLoaded", function() {
    document.querySelector('[data-bs-target="#tab-ticket"]').click();
});
</script>
{% endif %}
<script>
document.getElementById('filterTicketType').addEventListener('change', function () {
    let value = this.value.toLowerCase();

    document.querySelectorAll('.ticket-row').forEach(row => {
        let type = row.dataset.type.toLowerCase();

        if (!value || type.includes(value)) {
            row.style.display = '';
        } else {
            row.style.display = 'none';
        }
    });
});
</script>
<script>
document.getElementById('filterReservationStatus').addEventListener('change', function () {
    let value = this.value.toLowerCase();

    document.querySelectorAll('.reservation-row').forEach(row => {
        let status = row.dataset.status.toLowerCase();

        if (!value || status.includes(value)) {
            row.style.display = '';
        } else {
            row.style.display = 'none';
        }
    });
});
document.addEventListener('DOMContentLoaded', function () {

    let asc = true;

    document.getElementById('sortDate').addEventListener('click', function () {

        let rows = Array.from(document.querySelectorAll('.reservation-row'));
        let tbody = rows[0].parentNode;

        rows.sort((a, b) => {
            let dateA = a.dataset.date;
            let dateB = b.dataset.date;

            return asc 
                ? dateA.localeCompare(dateB)
                : dateB.localeCompare(dateA);
        });

        asc = !asc;

        rows.forEach(row => tbody.appendChild(row));
    });

});
document.addEventListener('DOMContentLoaded', function () {

    let ascDest = true;

    document.getElementById('sortDestination').addEventListener('click', function () {

        let rows = Array.from(document.querySelectorAll('.ticket-row'));
        let tbody = rows[0].parentNode;

        rows.sort((a, b) => {
            let A = a.dataset.destination;
            let B = b.dataset.destination;

            return ascDest 
                ? A.localeCompare(B)
                : B.localeCompare(A);
        });

        ascDest = !ascDest;

        rows.forEach(row => tbody.appendChild(row));
    });

});
</script>

{% endblock %}